# Base de datos local SQLite
src/database/data/*.sqlite
src/database/data/*.sqlite-shm
src/database/data/*.sqlite-wal
src/database/data/*.sqlite-journal
src/database/data/*.db
src/database/data/*.db-shm
src/database/data/*.db-wal
src/database/data/*.db-journal
src/database/reports/

# Backups locales de base de datos
src/database/data/*backup*
src/database/data/*respaldo*
src/database/data/*.bak

# Certificados HTTPS locales
certs/
*.pem
*.key
*.crt
*.p12

# Archivos temporales
tmp/
temp/
*.tmp
*.swp
*.swo

