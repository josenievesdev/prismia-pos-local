# ==========================================
# Dependencias
# ==========================================
node_modules/

# ==========================================
# Variables de entorno
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Logs
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# Builds / distribución / empaquetado
# ==========================================
dist/
build/*
!build/
!build/icon.ico
!build/icon.png
coverage/
out/
release/

# ==========================================
# Sistema operativo / editores
# ==========================================
.DS_Store
Thumbs.db
desktop.ini

.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# ==========================================
# Uploads locales generados por usuarios/clientes
# ==========================================
public/uploads/**
!public/uploads/
!public/uploads/.gitkeep

src/public/uploads/**
!src/public/uploads/
!src/public/uploads/.gitkeep
!src/public/uploads/productos/
!src/public/uploads/productos/.gitkeep

# ==========================================
# Base de datos local SQLite y datos runtime
# ==========================================
src/database/data/**
!src/database/data/
!src/database/data/.gitkeep

src/database/reports/

# ==========================================
# Backups locales de base de datos
# ==========================================
storage/backups/**
!storage/backups/
!storage/backups/.gitkeep

storage/tmp/**
!storage/tmp/
!storage/tmp/.gitkeep

*.zip.tmp
*.bak

# ==========================================
# Runtime local generado por Prismia
# ==========================================
storage/runtime/**
!storage/runtime/
!storage/runtime/.gitkeep

# ==========================================
# Secretos locales / runtime
# ==========================================
secretos.local.json
**/secretos.local.json
**/secretos.local.json.tmp

# ==========================================
# Certificados HTTPS locales
# ==========================================
certs/**
!certs/
!certs/.gitkeep

*.pem
*.key
*.crt
*.p12

# ==========================================
# Archivos temporales
# ==========================================
tmp/
temp/
*.tmp
*.swp
*.swo

# ==========================================
# Reinicio técnico local de desarrollo
# ==========================================
.restart-dev.json
src/.restart-dev.json
src/restart-dev-trigger.json

# ==========================================
# Carpetas temporales de pruebas runtime
# ==========================================
PrismiaRestoreTest/
PrismiaSetupTest/
PrismiaSecretsTest/
PrismiaRuntimeTest/

# ==========================================
# Entorno demo local para capturas landing
# ==========================================
PrismiaDemoLanding/
# Reportes locales de auditor�a
AUDITORIA_*.md

# ==========================================
# Licencias Prismia - claves privadas locales
# ==========================================
tools/licencias/private/
*.license-private.pem
*.private.pem
