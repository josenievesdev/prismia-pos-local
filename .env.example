APP_NAME=Prismia POS Local
APP_PORT=3000
NODE_ENV=development

DB_CLIENT=sqlite
DB_NAME=prismia_pos_local
DB_PATH=src/database/data/prismia_pos_local.sqlite

# Opcional para producción instalada.
# Si se deja vacío, Prismia usará una carpeta segura del usuario.
PRISMIA_DATA_DIR=
UPLOADS_PUBLIC_DIR=
UPLOADS_PRODUCTOS_DIR=

# Seguridad
# En desarrollo pueden quedar vacíos.
# En producción deben tener valores únicos por cada negocio.
SESSION_SECRET=
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@prismia.local
ADMIN_PASSWORD=

BACKUP_BASE_DIR=storage/backups
BACKUP_EXTERNAL_PATH=

# Clave técnica para soporte de backups.
# Debe ser única por negocio en producción.
SUPPORT_BACKUP_KEY=
SUPPORT_CONTACT_NAME=Nieves Systems
SUPPORT_CONTACT_EMAIL=soporte@tudominio.com
SUPPORT_CONTACT_PHONE=3001234567

BACKUP_SCHEDULED_INTERVAL_DAYS=7
BACKUP_RETENTION_AUTOMATICOS=30
BACKUP_RETENTION_PROGRAMADOS=8
BACKUP_RETENTION_EMERGENCIA=10