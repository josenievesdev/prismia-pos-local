<section class="module-page caja-page">
    <% const gruposResumenMedios=resumenMediosPagoAgrupado || { efectivo: [], transferencias: [], tarjetas: [], otros:
        [] }; const totalesResumen=totalesResumenMediosPago || { cantidad_operaciones: 0, total_ingresos: 0,
        total_egresos: 0, saldo_neto: 0 }; const resumenMediosTabla=[ ...(gruposResumenMedios.efectivo ||
        []).map((medio)=> ({
        ...medio,
        grupo: 'Efectivo'
        })),
        ...(gruposResumenMedios.transferencias || []).map((medio) => ({
        ...medio,
        grupo: 'Transferencias'
        })),
        ...(gruposResumenMedios.tarjetas || []).map((medio) => ({
        ...medio,
        grupo: 'Tarjetas'
        })),
        ...(gruposResumenMedios.otros || []).map((medio) => ({
        ...medio,
        grupo: 'Otros'
        }))
        ];

        const efectivoEsperado = Number(turnoAbierto?.monto_esperado_calculado || 0);
        const valorMontoContado = valores?.monto_contado || String(efectivoEsperado);
        %>

        <div class="module-header module-header-actions">
            <div>
                <p class="eyebrow">Cierre de caja</p>
                <h2>Cerrar caja</h2>
                <p>
                    Verifica el efectivo físico contado y registra el cierre del turno activo.
                </p>
            </div>

            <a href="/caja" class="btn-secondary">Volver a caja</a>
        </div>

        <% if (error) { %>
            <div class="alert alert-error">
                <%= error %>
            </div>
            <% } %>

                <section class="caja-active-grid">
                    <article class="module-card caja-status-card">
                        <div class="caja-status-top">
                            <div>
                                <p class="eyebrow">Turno activo</p>
                                <h3>Caja #<%= turnoAbierto.id_turno_caja %>
                                </h3>
                            </div>

                            <span class="badge badge-success">Abierta</span>
                        </div>

                        <div class="caja-meta-grid">
                            <div>
                                <span>Abierta por</span>
                                <strong>
                                    <%= turnoAbierto.usuario_apertura_nombre || 'Usuario' %>
                                </strong>
                            </div>

                            <div>
                                <span>Fecha de apertura</span>
                                <strong>
                                    <%= formatearFecha(turnoAbierto.fecha_apertura) %>
                                </strong>
                            </div>
                        </div>

                        <% if (turnoAbierto.observaciones_apertura) { %>
                            <div class="caja-note">
                                <span>Observación apertura</span>
                                <p>
                                    <%= turnoAbierto.observaciones_apertura %>
                                </p>
                            </div>
                            <% } %>
                    </article>

                    <article class="module-card caja-summary-card">
                        <p class="eyebrow">Resumen para cierre</p>

                        <div class="caja-summary-grid">
                            <div>
                                <span>Base inicial</span>
                                <strong>
                                    <%= formatearPesos(turnoAbierto.monto_inicial) %>
                                </strong>
                            </div>

                            <div>
                                <span>Ventas en efectivo</span>
                                <strong>
                                    <%= formatearPesos(turnoAbierto.total_efectivo) %>
                                </strong>
                            </div>

                            <div>
                                <span>Ingresos manuales</span>
                                <strong>
                                    <%= formatearPesos(turnoAbierto.total_ingresos_manuales) %>
                                </strong>
                            </div>

                            <div>
                                <span>Egresos manuales</span>
                                <strong>
                                    <%= formatearPesos(turnoAbierto.total_egresos_manuales) %>
                                </strong>
                            </div>
                        </div>

                        <div class="caja-expected-box">
                            <span>Efectivo esperado para cierre</span>
                            <strong>
                                <%= formatearPesos(efectivoEsperado) %>
                            </strong>
                        </div>
                    </article>
                </section>

                <article class="module-card caja-operativo-card">
                    <div class="table-summary">
                        <span>Resumen operativo por medios</span>
                        <span>
                            <strong>
                                <%= totalesResumen.cantidad_operaciones %>
                            </strong> operaciones
                        </span>
                    </div>

                    <div class="caja-operativo-totales">
                        <div class="caja-operativo-total-box">
                            <span>Total ingresos</span>
                            <strong>
                                <%= formatearPesos(totalesResumen.total_ingresos) %>
                            </strong>
                        </div>

                        <div class="caja-operativo-total-box">
                            <span>Total egresos</span>
                            <strong>
                                <%= formatearPesos(totalesResumen.total_egresos) %>
                            </strong>
                        </div>

                        <div class="caja-operativo-total-box">
                            <span>Saldo neto operativo</span>
                            <strong>
                                <%= formatearPesos(totalesResumen.saldo_neto) %>
                            </strong>
                        </div>

                        <div class="caja-operativo-total-box">
                            <span>Movimientos del turno</span>
                            <strong>
                                <%= movimientos.length %>
                            </strong>
                        </div>
                    </div>

                    <div class="table-wrapper caja-operativo-table-wrapper">
                        <table class="data-table caja-table caja-operativo-table">
                            <thead>
                                <tr>
                                    <th>Grupo</th>
                                    <th>Medio</th>
                                    <th class="text-center">Ops.</th>
                                    <th class="text-right">Ingresos</th>
                                    <th class="text-right">Egresos</th>
                                    <th class="text-right">Neto</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% resumenMediosTabla.forEach((medio)=> { %>
                                    <% const totalIngresos=Number(medio.total_ingresos || 0); const
                                        totalEgresos=Number(medio.total_egresos || 0); const
                                        saldoNeto=Number(medio.saldo_neto || 0); const claseNeto=saldoNeto> 0
                                        ? 'caja-neto-positivo'
                                        : saldoNeto < 0 ? 'caja-neto-negativo' : 'caja-neto-cero' ; const
                                            signoNeto=saldoNeto> 0 ? '+' : saldoNeto < 0 ? '-' : '' ; %>

                                                <tr
                                                    class="<%= medio.cantidad_operaciones > 0 ? 'caja-operativo-row-activa' : 'caja-operativo-row-vacia' %>">
                                                    <td>
                                                        <span class="caja-operativo-grupo-badge">
                                                            <%= medio.grupo %>
                                                        </span>
                                                    </td>

                                                    <td>
                                                        <div class="caja-operativo-medio-cell">
                                                            <strong>
                                                                <%= medio.nombre %>
                                                            </strong>

                                                            <% if (Number(medio.afecta_efectivo_caja || 0)===1) { %>
                                                                <span>Afecta efectivo físico</span>
                                                                <% } else { %>
                                                                    <span>No afecta efectivo físico</span>
                                                                    <% } %>
                                                        </div>
                                                    </td>

                                                    <td class="text-center">
                                                        <strong>
                                                            <%= medio.cantidad_operaciones %>
                                                        </strong>
                                                    </td>

                                                    <td class="text-right">
                                                        <span
                                                            class="<%= totalIngresos > 0 ? 'caja-operativo-ingreso' : 'caja-operativo-cero' %>">
                                                            <%= totalIngresos> 0 ? '+ ' : '' %><%=
                                                                    formatearPesos(totalIngresos) %>
                                                        </span>
                                                    </td>

                                                    <td class="text-right">
                                                        <span
                                                            class="<%= totalEgresos > 0 ? 'caja-operativo-egreso' : 'caja-operativo-cero' %>">
                                                            <%= totalEgresos> 0 ? '- ' : '' %><%=
                                                                    formatearPesos(totalEgresos) %>
                                                        </span>
                                                    </td>

                                                    <td class="text-right">
                                                        <strong class="caja-operativo-neto <%= claseNeto %>">
                                                            <%= signoNeto %>
                                                                <%= formatearPesos(Math.abs(saldoNeto)) %>
                                                        </strong>
                                                    </td>
                                                </tr>
                                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </article>

                <section class="caja-active-grid">
                    <form class="module-card form-panel caja-cierre-form" method="POST" action="/caja/cerrar"
                        data-efectivo-esperado="<%= efectivoEsperado %>">
                        <div class="form-section">
                            <h3>Conteo físico</h3>

                            <div class="form-group">
                                <label for="monto_contado">Efectivo contado *</label>
                                <input type="number" id="monto_contado" name="monto_contado" min="0" step="1"
                                    value="<%= valorMontoContado %>" required>
                                <small class="field-help">
                                    Digita el dinero físico real contado en caja.
                                </small>
                            </div>

                            <div class="caja-cierre-diferencia" id="cajaDiferenciaPreview">
                                <span>Diferencia estimada</span>
                                <strong>
                                    <%= formatearPesos(Number(valorMontoContado || 0) - efectivoEsperado) %>
                                </strong>
                                <small>
                                    Fórmula: efectivo contado - efectivo esperado.
                                </small>
                            </div>

                            <div class="form-group">
                                <label for="observaciones_cierre">Observaciones de cierre</label>
                                <textarea id="observaciones_cierre" name="observaciones_cierre" rows="4" maxlength="500"
                                    placeholder="Ej: cierre sin novedades, faltante por revisar, sobrante encontrado..."><%= valores?.observaciones_cierre || '' %></textarea>
                                <small class="field-help">
                                    Campo opcional. Útil si hay diferencia, novedad o aclaración.
                                </small>
                            </div>
                        </div>

                        <div class="caja-cierre-alerta">
                            <strong>Antes de cerrar</strong>
                            <p>
                                Al cerrar caja, el turno quedará marcado como cerrado y ya no se podrán registrar
                                movimientos sobre este turno.
                            </p>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn-primary">
                                Confirmar cierre
                            </button>

                            <a href="/caja" class="btn-secondary">
                                Cancelar
                            </a>
                        </div>
                    </form>

                    <article class="module-card caja-help-card">
                        <h3>Lectura del cierre</h3>

                        <div class="caja-cierre-help-list">
                            <div>
                                <span>Si la diferencia es $0</span>
                                <p>El efectivo contado coincide con el efectivo esperado.</p>
                            </div>

                            <div>
                                <span>Si la diferencia es negativa</span>
                                <p>Hay faltante de efectivo físico en caja.</p>
                            </div>

                            <div>
                                <span>Si la diferencia es positiva</span>
                                <p>Hay sobrante de efectivo físico en caja.</p>
                            </div>
                        </div>
                    </article>
                </section>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const form = document.querySelector('.caja-cierre-form');

        if (!form) {
            return;
        }

        const inputMontoContado = document.getElementById('monto_contado');
        const preview = document.getElementById('cajaDiferenciaPreview');
        const valorPreview = preview ? preview.querySelector('strong') : null;
        const efectivoEsperado = Number(form.dataset.efectivoEsperado || 0);

        const formatearPesos = function (valor) {
            return new Intl.NumberFormat('es-CO', {
                style: 'currency',
                currency: 'COP',
                maximumFractionDigits: 0
            }).format(valor);
        };

        const actualizarPreview = function () {
            if (!inputMontoContado || !valorPreview) {
                return;
            }

            const montoContado = Number(inputMontoContado.value || 0);
            const diferencia = montoContado - efectivoEsperado;

            valorPreview.textContent = formatearPesos(diferencia);

            preview.classList.remove(
                'caja-cierre-diferencia-ok',
                'caja-cierre-diferencia-faltante',
                'caja-cierre-diferencia-sobrante'
            );

            if (diferencia === 0) {
                preview.classList.add('caja-cierre-diferencia-ok');
                return;
            }

            if (diferencia < 0) {
                preview.classList.add('caja-cierre-diferencia-faltante');
                return;
            }

            preview.classList.add('caja-cierre-diferencia-sobrante');
        };

        inputMontoContado?.addEventListener('input', actualizarPreview);
        actualizarPreview();
    });
</script>