<section class="module-page caja-page">
    <% const gruposMediosPago=mediosPagoAgrupados || { efectivo: [], transferencias: [], tarjetas: [], otros: [] };
        const gruposResumenMedios=resumenMediosPagoAgrupado || { efectivo: [], transferencias: [], tarjetas: [], otros:
        [] }; const totalesResumen=totalesResumenMediosPago || { cantidad_operaciones: 0, total_ingresos: 0,
        total_egresos: 0, saldo_neto: 0, efectivo: { ingresos: 0, egresos: 0, saldo: 0 }, transferencias: { ingresos: 0,
        egresos: 0, saldo: 0 }, tarjetas: { ingresos: 0, egresos: 0, saldo: 0 }, otros: { ingresos: 0, egresos: 0,
        saldo: 0 } }; const totalMediosPago=mediosPago ? mediosPago.length : 0; const gruposResumenUI=[ {
        titulo: 'Efectivo' , items: gruposResumenMedios.efectivo || [], total: totalesResumen.efectivo || { ingresos: 0,
        egresos: 0, saldo: 0 } }, { titulo: 'Transferencias' , items: gruposResumenMedios.transferencias || [], total:
        totalesResumen.transferencias || { ingresos: 0, egresos: 0, saldo: 0 } }, { titulo: 'Tarjetas' , items:
        gruposResumenMedios.tarjetas || [], total: totalesResumen.tarjetas || { ingresos: 0, egresos: 0, saldo: 0 } }, {
        titulo: 'Otros' , items: gruposResumenMedios.otros || [], total: totalesResumen.otros || { ingresos: 0, egresos:
        0, saldo: 0 } } ]; %>

        <div class="module-header module-header-actions">
            <div>
                <p class="eyebrow">Control de efectivo</p>
                <h2>Caja</h2>
                <p>
                    Administra la apertura del turno, la base inicial y el control operativo del dinero.
                </p>
            </div>

            <% if (!turnoAbierto) { %>
                <a href="/caja/abrir" class="btn-primary">Abrir caja</a>
                <% } else { %>
                    <div class="module-actions">
                        <span class="badge badge-success">Caja abierta</span>

                        <a href="/caja/movimiento" class="btn-secondary">
                            Movimiento
                        </a>

                        <button type="button" class="btn-secondary disabled-button" disabled
                            title="Disponible cuando implementemos el cierre de caja">
                            Cerrar caja
                        </button>
                    </div>
                    <% } %>
        </div>

        <% if (mensajeExito) { %>
            <div class="alert alert-success">
                <%= mensajeExito %>
            </div>
            <% } %>

                <% if (error) { %>
                    <div class="alert alert-error">
                        <%= error %>
                    </div>
                    <% } %>

                        <% if (!turnoAbierto) { %>
                            <article class="module-card caja-empty-card">
                                <div>
                                    <p class="eyebrow">Sin turno activo</p>
                                    <h3>No hay caja abierta</h3>
                                    <p>
                                        Para vender o registrar movimientos de efectivo, primero debes abrir caja con
                                        una base inicial.
                                    </p>
                                </div>

                                <a href="/caja/abrir" class="btn-primary">Abrir caja ahora</a>
                            </article>
                            <% } else { %>
                                <section class="caja-active-grid">
                                    <article class="module-card caja-status-card">
                                        <div class="caja-status-top">
                                            <div>
                                                <p class="eyebrow">Turno activo</p>
                                                <h3>Caja #<%= turnoAbierto.id_turno_caja %>
                                                </h3>
                                            </div>

                                            <span class="badge badge-success">Abierta</span>
                                        </div>

                                        <div class="caja-meta-grid">
                                            <div>
                                                <span>Abierta por</span>
                                                <strong>
                                                    <%= turnoAbierto.usuario_apertura_nombre || 'Usuario' %>
                                                </strong>
                                            </div>

                                            <div>
                                                <span>Fecha de apertura</span>
                                                <strong>
                                                    <%= formatearFecha(turnoAbierto.fecha_apertura) %>
                                                </strong>
                                            </div>
                                        </div>

                                        <% if (turnoAbierto.observaciones_apertura) { %>
                                            <div class="caja-note">
                                                <span>Observación</span>
                                                <p>
                                                    <%= turnoAbierto.observaciones_apertura %>
                                                </p>
                                            </div>
                                            <% } %>
                                    </article>

                                    <article class="module-card caja-summary-card">
                                        <p class="eyebrow">Resumen del efectivo</p>

                                        <div class="caja-summary-grid">
                                            <div>
                                                <span>Base inicial</span>
                                                <strong>
                                                    <%= formatearPesos(turnoAbierto.monto_inicial) %>
                                                </strong>
                                            </div>

                                            <div>
                                                <span>Ventas en efectivo</span>
                                                <strong>
                                                    <%= formatearPesos(turnoAbierto.total_efectivo) %>
                                                </strong>
                                            </div>

                                            <div>
                                                <span>Ingresos manuales</span>
                                                <strong>
                                                    <%= formatearPesos(turnoAbierto.total_ingresos_manuales) %>
                                                </strong>
                                            </div>

                                            <div>
                                                <span>Egresos manuales</span>
                                                <strong>
                                                    <%= formatearPesos(turnoAbierto.total_egresos_manuales) %>
                                                </strong>
                                            </div>
                                        </div>

                                        <div class="caja-expected-box">
                                            <span>Efectivo esperado actual</span>
                                            <strong>
                                                <%= formatearPesos(turnoAbierto.monto_esperado_calculado) %>
                                            </strong>
                                        </div>
                                    </article>
                                </section>

                                <article class="module-card caja-medios-card">
                                    <div class="caja-medios-header">
                                        <div>
                                            <p class="eyebrow">Medios de pago</p>
                                            <h3>Medios configurados para el turno</h3>
                                        </div>

                                        <span class="badge badge-muted">
                                            <%= totalMediosPago %> activos
                                        </span>
                                    </div>

                                    <div class="caja-medios-grid">
                                        <div class="caja-medio-group">
                                            <span class="caja-medio-title">Efectivo</span>

                                            <% if (gruposMediosPago.efectivo.length===0) { %>
                                                <p class="caja-medio-empty">Sin medios configurados</p>
                                                <% } else { %>
                                                    <div class="caja-medio-list">
                                                        <% gruposMediosPago.efectivo.forEach((medio)=> { %>
                                                            <span class="caja-medio-pill">
                                                                <%= medio.nombre %>
                                                            </span>
                                                            <% }) %>
                                                    </div>
                                                    <% } %>
                                        </div>

                                        <div class="caja-medio-group">
                                            <span class="caja-medio-title">Transferencias</span>

                                            <% if (gruposMediosPago.transferencias.length===0) { %>
                                                <p class="caja-medio-empty">Sin medios configurados</p>
                                                <% } else { %>
                                                    <div class="caja-medio-list">
                                                        <% gruposMediosPago.transferencias.forEach((medio)=> { %>
                                                            <span class="caja-medio-pill">
                                                                <%= medio.nombre %>
                                                            </span>
                                                            <% }) %>
                                                    </div>
                                                    <% } %>
                                        </div>

                                        <div class="caja-medio-group">
                                            <span class="caja-medio-title">Tarjetas</span>

                                            <% if (gruposMediosPago.tarjetas.length===0) { %>
                                                <p class="caja-medio-empty">Sin medios configurados</p>
                                                <% } else { %>
                                                    <div class="caja-medio-list">
                                                        <% gruposMediosPago.tarjetas.forEach((medio)=> { %>
                                                            <span class="caja-medio-pill">
                                                                <%= medio.nombre %>
                                                            </span>
                                                            <% }) %>
                                                    </div>
                                                    <% } %>
                                        </div>

                                        <div class="caja-medio-group">
                                            <span class="caja-medio-title">Otros</span>

                                            <% if (gruposMediosPago.otros.length===0) { %>
                                                <p class="caja-medio-empty">Sin medios configurados</p>
                                                <% } else { %>
                                                    <div class="caja-medio-list">
                                                        <% gruposMediosPago.otros.forEach((medio)=> { %>
                                                            <span class="caja-medio-pill">
                                                                <%= medio.nombre %>
                                                            </span>
                                                            <% }) %>
                                                    </div>
                                                    <% } %>
                                        </div>
                                    </div>
                                </article>

                                <article class="module-card caja-operativo-card caja-scroll-card">
                                    <div class="table-summary">
                                        <span>Resumen operativo por medios</span>
                                        <span>
                                            <strong>
                                                <%= totalesResumen.cantidad_operaciones %>
                                            </strong> operaciones
                                        </span>
                                    </div>

                                    <div class="caja-operativo-totales">
                                        <div class="caja-operativo-total-box">
                                            <span>Total ingresos</span>
                                            <strong>
                                                <%= formatearPesos(totalesResumen.total_ingresos) %>
                                            </strong>
                                        </div>

                                        <div class="caja-operativo-total-box">
                                            <span>Total egresos</span>
                                            <strong>
                                                <%= formatearPesos(totalesResumen.total_egresos) %>
                                            </strong>
                                        </div>

                                        <div class="caja-operativo-total-box">
                                            <span>Saldo neto operativo</span>
                                            <strong>
                                                <%= formatearPesos(totalesResumen.saldo_neto) %>
                                            </strong>
                                        </div>

                                        <div class="caja-operativo-total-box">
                                            <span>Medios activos</span>
                                            <strong>
                                                <%= totalMediosPago %>
                                            </strong>
                                        </div>
                                    </div>

                                    <div class="caja-operativo-groups">
                                        <% gruposResumenUI.forEach((grupo)=> { %>
                                            <section class="caja-operativo-group">
                                                <div class="caja-operativo-group-header">
                                                    <strong>
                                                        <%= grupo.titulo %>
                                                    </strong>
                                                    <span>
                                                        Ingresos <%= formatearPesos(grupo.total.ingresos) %> ·
                                                            Egresos <%= formatearPesos(grupo.total.egresos) %>
                                                    </span>
                                                </div>

                                                <div class="caja-operativo-list">
                                                    <% grupo.items.forEach((medio)=> { %>
                                                        <div class="caja-operativo-row">
                                                            <div>
                                                                <strong>
                                                                    <%= medio.nombre %>
                                                                </strong>
                                                                <span>
                                                                    <%= medio.cantidad_operaciones %> operaciones
                                                                </span>
                                                            </div>

                                                            <div class="caja-operativo-values">
                                                                <span>+ <%= formatearPesos(medio.total_ingresos) %>
                                                                </span>
                                                                <span>- <%= formatearPesos(medio.total_egresos) %>
                                                                </span>
                                                                <strong>
                                                                    <%= formatearPesos(medio.saldo_neto) %>
                                                                </strong>
                                                            </div>
                                                        </div>
                                                        <% }) %>
                                                </div>
                                            </section>
                                            <% }) %>
                                    </div>
                                </article>

                                <article class="module-card caja-movimientos-card caja-scroll-card">
                                    <div class="table-summary">
                                        <span>Movimientos del turno</span>
                                        <span>
                                            <strong>
                                                <%= movimientos.length %>
                                            </strong> registrados
                                        </span>
                                    </div>

                                    <% if (!movimientos || movimientos.length===0) { %>
                                        <div class="empty-state">
                                            <h3>Sin movimientos todavía</h3>
                                            <p>
                                                Por ahora solo quedó activa la apertura. En la siguiente fase se agregan
                                                ingresos, egresos y gastos desde caja.
                                            </p>
                                        </div>
                                        <% } else { %>
                                            <div class="table-wrapper">
                                                <table class="data-table caja-table caja-movimientos-table">
                                                    <thead>
                                                        <tr>
                                                            <th>Fecha</th>
                                                            <th>Movimiento</th>
                                                            <th>Medio / soporte</th>
                                                            <th>Descripción</th>
                                                            <th>Usuario</th>
                                                            <th class="text-right">Monto</th>
                                                        </tr>
                                                    </thead>

                                                    <tbody>
                                                        <% movimientos.forEach((movimiento)=> { %>
                                                            <% const esEgreso=[ 'egreso_manual' , 'devolucion'
                                                                , 'anulacion' ].includes(movimiento.tipo_movimiento);
                                                                const claseMonto=esEgreso ? 'monto-egreso'
                                                                : 'monto-ingreso' ; const signoMonto=esEgreso ? '-'
                                                                : '+' ; %>

                                                                <tr>
                                                                    <td>
                                                                        <span class="caja-table-date">
                                                                            <%= formatearFecha(movimiento.creado_en) %>
                                                                        </span>
                                                                    </td>

                                                                    <td>
                                                                        <span
                                                                            class="badge <%= esEgreso ? 'badge-error-soft' : 'badge-success' %>">
                                                                            <%= movimiento.tipo_movimiento_texto %>
                                                                        </span>
                                                                    </td>

                                                                    <td>
                                                                        <div class="caja-payment-cell">
                                                                            <strong>
                                                                                <%= movimiento.metodo_pago_texto %>
                                                                            </strong>

                                                                            <% if (movimiento.referencia_pago ||
                                                                                movimiento.entidad_pago) { %>
                                                                                <span>
                                                                                    <% if (movimiento.entidad_pago) { %>
                                                                                        <%= movimiento.entidad_pago %>
                                                                                            <% } %>

                                                                                                <% if
                                                                                                    (movimiento.entidad_pago
                                                                                                    &&
                                                                                                    movimiento.referencia_pago)
                                                                                                    { %>
                                                                                                    ·
                                                                                                    <% } %>

                                                                                                        <% if
                                                                                                            (movimiento.referencia_pago)
                                                                                                            { %>
                                                                                                            Ref. <%=
                                                                                                                movimiento.referencia_pago
                                                                                                                %>
                                                                                                                <% } %>
                                                                                </span>
                                                                                <% } else { %>
                                                                                    <span>Sin referencia</span>
                                                                                    <% } %>
                                                                        </div>
                                                                    </td>

                                                                    <td>
                                                                        <span class="caja-description-cell">
                                                                            <%= movimiento.descripcion
                                                                                || 'Sin descripción' %>
                                                                        </span>
                                                                    </td>

                                                                    <td>
                                                                        <%= movimiento.usuario_nombre || 'Usuario' %>
                                                                    </td>

                                                                    <td class="text-right">
                                                                        <strong class="<%= claseMonto %>">
                                                                            <%= signoMonto %>
                                                                                <%= formatearPesos(movimiento.monto) %>
                                                                        </strong>
                                                                    </td>
                                                                </tr>
                                                                <% }) %>
                                                    </tbody>
                                                </table>
                                            </div>
                                            <% } %>
                                </article>
                                <% } %>

                                    <article class="module-card caja-historial-card caja-scroll-card">
                                        <div class="table-summary">
                                            <span>Historial reciente de turnos</span>
                                            <span>
                                                <strong>
                                                    <%= turnosRecientes.length %>
                                                </strong> turnos
                                            </span>
                                        </div>

                                        <% if (!turnosRecientes || turnosRecientes.length===0) { %>
                                            <div class="empty-state">
                                                <h3>No hay turnos registrados</h3>
                                                <p>
                                                    Cuando abras y cierres caja, aparecerá aquí el historial operativo.
                                                </p>
                                            </div>
                                            <% } else { %>
                                                <div class="table-wrapper">
                                                    <table class="data-table caja-table">
                                                        <thead>
                                                            <tr>
                                                                <th>Turno</th>
                                                                <th>Estado</th>
                                                                <th>Apertura</th>
                                                                <th>Cierre</th>
                                                                <th>Usuario</th>
                                                                <th class="text-right">Esperado</th>
                                                                <th class="text-right">Contado</th>
                                                                <th class="text-right">Diferencia</th>
                                                            </tr>
                                                        </thead>

                                                        <tbody>
                                                            <% turnosRecientes.forEach((turno)=> { %>
                                                                <tr>
                                                                    <td>
                                                                        <strong>#<%= turno.id_turno_caja %></strong>
                                                                    </td>

                                                                    <td>
                                                                        <% if (turno.estado==='abierto' ) { %>
                                                                            <span
                                                                                class="badge badge-success">Abierto</span>
                                                                            <% } else { %>
                                                                                <span
                                                                                    class="badge badge-muted">Cerrado</span>
                                                                                <% } %>
                                                                    </td>

                                                                    <td>
                                                                        <%= formatearFecha(turno.fecha_apertura) %>
                                                                    </td>

                                                                    <td>
                                                                        <%= turno.fecha_cierre ?
                                                                            formatearFecha(turno.fecha_cierre) : '—' %>
                                                                    </td>

                                                                    <td>
                                                                        <%= turno.usuario_apertura_nombre || 'Usuario'
                                                                            %>
                                                                    </td>

                                                                    <td class="text-right">
                                                                        <%= formatearPesos(turno.monto_esperado_calculado)
                                                                            %>
                                                                    </td>

                                                                    <td class="text-right">
                                                                        <%= turno.monto_contado===null ? '—' :
                                                                            formatearPesos(turno.monto_contado) %>
                                                                    </td>

                                                                    <td class="text-right">
                                                                        <%= turno.diferencia===null ? '—' :
                                                                            formatearPesos(turno.diferencia) %>
                                                                    </td>
                                                                </tr>
                                                                <% }) %>
                                                        </tbody>
                                                    </table>
                                                </div>
                                                <% } %>
                                    </article>
</section>