<%
    const grupos = resumenMediosPagoAgrupado || { efectivo: [], transferencias: [], tarjetas: [], otros: [] };
    const totalesResumen = totalesResumenMediosPago || { cantidad_operaciones: 0, total_ingresos: 0, total_egresos: 0, saldo_neto: 0 };
    const totalMediosPago = Array.isArray(mediosPago) ? mediosPago.length : 0;
    const movimientosListado = Array.isArray(movimientos) ? movimientos : [];
    const turnosListado = Array.isArray(turnosRecientes) ? turnosRecientes : [];
    const resumenMediosTabla = [
        ...(grupos.efectivo || []).map((medio) => ({ ...medio, grupo: 'Efectivo' })),
        ...(grupos.transferencias || []).map((medio) => ({ ...medio, grupo: 'Transferencia' })),
        ...(grupos.tarjetas || []).map((medio) => ({ ...medio, grupo: 'Tarjeta' })),
        ...(grupos.otros || []).map((medio) => ({ ...medio, grupo: 'Otro' })),
    ];
    const conSigno = (valor) => (valor > 0 ? '+ ' : valor < 0 ? '− ' : '') + formatearPesos(Math.abs(valor));
%>
<section class="ui-pagina">
    <% if (turnoAbierto) { %>
        <%- include('../partials/ui/encabezado', {
            eyebrow: 'Control de efectivo',
            titulo: 'Caja #' + turnoAbierto.id_turno_caja,
            estado: { texto: 'Abierta', tono: 'exito' },
            descripcion: 'Abierta por ' + (turnoAbierto.usuario_apertura_nombre || 'Usuario') + ' el ' + formatearFecha(fechaLocal(turnoAbierto.fecha_apertura)) + '.',
            acciones: [
                { texto: 'Ver arqueo', href: '/caja/turnos/' + turnoAbierto.id_turno_caja },
                { texto: 'Movimiento', href: '/caja/movimiento' },
                { texto: 'Gasto', href: '/caja/gasto' },
                { texto: 'Cerrar caja', href: '/caja/cerrar', tipo: 'primario' },
            ],
        }) %>
    <% } else { %>
        <%- include('../partials/ui/encabezado', {
            eyebrow: 'Control de efectivo',
            titulo: 'Caja',
            estado: { texto: 'Cerrada', tono: 'peligro' },
            descripcion: 'Apertura del turno, base inicial y control del dinero.',
            acciones: [{ texto: 'Abrir caja', href: '/caja/abrir', tipo: 'primario' }],
        }) %>
    <% } %>

    <% if (mensajeExito) { %><div class="alert alert-success"><%= mensajeExito %></div><% } %>
    <% if (alertaBackup) { %><div class="alert alert-warning"><%= alertaBackup %></div><% } %>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <% if (!turnoAbierto) { %>
        <article class="ui-tarjeta">
            <%- include('../partials/ui/vacio', { titulo: 'No hay caja abierta', mensaje: 'Para vender o registrar movimientos de efectivo, primero abre caja con una base inicial.' }) %>
        </article>
    <% } else { %>
        <section class="ui-kpis">
            <%- include('../partials/ui/kpi', { etiqueta: 'Base inicial', valor: formatearPesos(turnoAbierto.monto_inicial) }) %>
            <%- include('../partials/ui/kpi', { etiqueta: 'Ventas en efectivo', valor: formatearPesos(turnoAbierto.total_efectivo) }) %>
            <%- include('../partials/ui/kpi', { etiqueta: 'Ingresos manuales', valor: formatearPesos(turnoAbierto.total_ingresos_manuales) }) %>
            <%- include('../partials/ui/kpi', { etiqueta: 'Egresos manuales', valor: formatearPesos(turnoAbierto.total_egresos_manuales) }) %>
            <%- include('../partials/ui/kpi', { etiqueta: 'Efectivo esperado', valor: formatearPesos(turnoAbierto.monto_esperado_calculado), detalle: 'Lo que debe haber en el cajón', tono: 'destacado' }) %>
        </section>

        <% if (turnoAbierto.observaciones_apertura) { %>
            <div class="ui-nota ui-nota--info">
                <strong>Observación de apertura:</strong> <%= turnoAbierto.observaciones_apertura %>
            </div>
        <% } %>

        <article class="ui-tarjeta">
            <header class="ui-tarjeta-encabezado">
                <div>
                    <span class="ui-eyebrow">Resumen operativo</span>
                    <h3>Ingresos y egresos por medio de pago</h3>
                    <p>Consolidado del turno por efectivo, transferencias, tarjetas y otros medios.</p>
                </div>
                <%- include('../partials/ui/estado', { texto: totalesResumen.cantidad_operaciones + ' operaciones' }) %>
            </header>

            <div class="ui-tarjeta-cuerpo">
                <div class="ui-metricas">
                    <div class="ui-metrica"><span>Total ingresos</span><strong><%= formatearPesos(totalesResumen.total_ingresos) %></strong></div>
                    <div class="ui-metrica"><span>Total egresos</span><strong><%= formatearPesos(totalesResumen.total_egresos) %></strong></div>
                    <div class="ui-metrica"><span>Saldo neto</span><strong><%= formatearPesos(totalesResumen.saldo_neto) %></strong></div>
                    <div class="ui-metrica"><span>Medios activos</span><strong><%= totalMediosPago %></strong></div>
                </div>
            </div>

            <div class="ui-tabla-contenedor">
                <table class="ui-tabla">
                    <thead>
                        <tr>
                            <th>Medio</th>
                            <th class="centro">Operaciones</th>
                            <th class="num">Ingresos</th>
                            <th class="num">Egresos</th>
                            <th class="num">Neto</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% resumenMediosTabla.forEach((medio) => {
                            const ingresos = Number(medio.total_ingresos || 0);
                            const egresos = Number(medio.total_egresos || 0);
                            const neto = Number(medio.saldo_neto || 0); %>
                            <tr class="<%= Number(medio.cantidad_operaciones || 0) === 0 ? 'ui-fila-inactiva' : '' %>">
                                <td>
                                    <strong><%= medio.nombre %></strong>
                                    <small><%= medio.grupo %> · <%= Number(medio.afecta_efectivo_caja || 0) === 1 ? 'afecta el efectivo del cajón' : 'no afecta el efectivo del cajón' %></small>
                                </td>
                                <td class="centro"><%= medio.cantidad_operaciones %></td>
                                <td class="num <%= ingresos > 0 ? 'ui-texto-exito' : '' %>"><%= conSigno(ingresos) %></td>
                                <td class="num <%= egresos > 0 ? 'ui-texto-peligro' : '' %>"><%= conSigno(-egresos) %></td>
                                <td class="num"><strong><%= conSigno(neto) %></strong></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </article>

        <article class="ui-tarjeta">
            <header class="ui-tarjeta-encabezado">
                <div>
                    <span class="ui-eyebrow">Detalle operativo</span>
                    <h3>Movimientos del turno</h3>
                    <p>Ventas, ingresos, egresos y anulaciones en orden cronológico.</p>
                </div>
                <%- include('../partials/ui/estado', { texto: movimientosListado.length + ' registrados' }) %>
            </header>

            <% if (!movimientosListado.length) { %>
                <%- include('../partials/ui/vacio', { titulo: 'Sin movimientos todavía', mensaje: 'Las ventas, ingresos y gastos del turno aparecerán aquí.' }) %>
            <% } else { %>
                <div class="ui-tabla-contenedor" style="--ui-tabla-alto: 460px">
                    <table class="ui-tabla">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Movimiento</th>
                                <th>Medio / soporte</th>
                                <th>Descripción</th>
                                <th>Usuario</th>
                                <th class="num">Monto</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% movimientosListado.forEach((movimiento) => {
                                const esEgreso = ['egreso_manual', 'devolucion', 'anulacion'].includes(movimiento.tipo_movimiento);
                                const soporte = [movimiento.entidad_pago, movimiento.referencia_pago ? 'Ref. ' + movimiento.referencia_pago : ''].filter(Boolean).join(' · '); %>
                                <tr>
                                    <td><%= formatearFecha(fechaLocal(movimiento.creado_en)) %></td>
                                    <td><%- include('../partials/ui/estado', { texto: movimiento.tipo_movimiento_texto, tono: esEgreso ? 'peligro' : 'exito' }) %></td>
                                    <td>
                                        <strong><%= movimiento.metodo_pago_texto %></strong>
                                        <small><%= soporte || 'Sin referencia' %></small>
                                    </td>
                                    <td><%= movimiento.descripcion || 'Sin descripción' %></td>
                                    <td><%= movimiento.usuario_nombre || 'Usuario' %></td>
                                    <td class="num <%= esEgreso ? 'ui-texto-peligro' : 'ui-texto-exito' %>"><strong><%= esEgreso ? '− ' : '+ ' %><%= formatearPesos(movimiento.monto) %></strong></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </article>
    <% } %>

    <article class="ui-tarjeta">
        <header class="ui-tarjeta-encabezado">
            <div>
                <span class="ui-eyebrow">Historial de caja</span>
                <h3>Últimos turnos</h3>
                <p>Aperturas, cierres, valores esperados, conteos y diferencias.</p>
            </div>
            <%- include('../partials/ui/estado', { texto: turnosListado.length + ' turnos' }) %>
        </header>

        <% if (!turnosListado.length) { %>
            <%- include('../partials/ui/vacio', { titulo: 'No hay turnos registrados', mensaje: 'Cuando abras y cierres caja, aparecerá aquí el historial.' }) %>
        <% } else { %>
            <div class="ui-tabla-contenedor">
                <table class="ui-tabla">
                    <thead>
                        <tr>
                            <th>Turno</th>
                            <th>Estado</th>
                            <th>Apertura</th>
                            <th>Cierre</th>
                            <th>Usuario</th>
                            <th class="num">Esperado</th>
                            <th class="num">Contado</th>
                            <th class="num">Diferencia</th>
                            <th class="num">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% turnosListado.forEach((turno) => {
                            const diferencia = turno.diferencia === null ? null : Number(turno.diferencia); %>
                            <tr>
                                <td><strong>#<%= turno.id_turno_caja %></strong></td>
                                <td><%- include('../partials/ui/estado', { texto: turno.estado === 'abierto' ? 'Abierto' : 'Cerrado', tono: turno.estado === 'abierto' ? 'exito' : '', punto: true }) %></td>
                                <td><%= formatearFecha(fechaLocal(turno.fecha_apertura)) %></td>
                                <td><%= turno.fecha_cierre ? formatearFecha(fechaLocal(turno.fecha_cierre)) : '—' %></td>
                                <td><%= turno.usuario_apertura_nombre || 'Usuario' %></td>
                                <td class="num"><%= formatearPesos(turno.monto_esperado_calculado) %></td>
                                <td class="num"><%= turno.monto_contado === null ? '—' : formatearPesos(turno.monto_contado) %></td>
                                <td class="num <%= diferencia < 0 ? 'ui-texto-peligro' : '' %>">
                                    <strong><%= diferencia === null ? '—' : (diferencia === 0 ? formatearPesos(0) : conSigno(diferencia)) %></strong>
                                </td>
                                <td>
                                    <div class="ui-acciones-fila">
                                        <a href="/caja/turnos/<%= turno.id_turno_caja %>" class="btn-secondary">Ver arqueo</a>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </article>
</section>
