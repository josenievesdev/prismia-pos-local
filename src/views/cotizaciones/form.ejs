<%
    const fechaHoy = fechaHoyLocal;
    const cotizacionSugerida = siguienteCotizacion || { prefijo: 'COT', siguiente_numero: 'COT-BORRADOR' };
    const numeroCotizacion = cotizacionSugerida.siguiente_numero || 'COT-BORRADOR';
    const fechaVista = String(fechaHoy || '').split('-').reverse().join('/');
%>
<section class="module-page ventas-page doc-pagina">
    <form id="formNuevaCotizacion" class="ventas-pos-shell doc-editor" data-url="/cotizaciones" novalidate>
        <header class="ui-encabezado">
            <div class="ui-encabezado-texto">
                <strong class="doc-numero" id="cotizacionNumeroSugerido" title="Número sugerido: se confirma al guardar"><%= numeroCotizacion %></strong>
                <span class="ui-meta"><%= fechaVista %></span>
                <%- include('../partials/ui/estado', { texto: 'No descuenta inventario', tono: 'info', punto: true }) %>
            </div>

            <div class="ui-acciones">
                <a href="/cotizaciones" class="btn-secondary">Listado</a>
                <button type="button" class="btn-secondary" id="btnLimpiarCotizacion">Limpiar</button>
            </div>
        </header>

        <% if (error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>
        <div class="alert alert-error" id="alertaCotizacion" hidden></div>

        <div class="doc-busquedas">
            <section class="pos-cliente doc-tercero">
                <div class="ventas-client-clean-head">
                    <span>Cliente</span>

                    <div class="ventas-client-clean-actions">
                        <strong id="resumenClienteCotizacion" hidden>Sin seleccionar</strong>
                        <button type="button" class="ventas-client-new-btn" id="btnAbrirClienteRapidoCotizacion">+ Nuevo</button>
                    </div>
                </div>

                <div class="ventas-client-search-wrap">
                    <input type="search" id="buscarClienteCotizacion"
                        placeholder="Nombre, documento o teléfono…" autocomplete="off">

                    <div class="ventas-client-results" id="resultadosClientesCotizacion" hidden>
                        <div class="ventas-client-result-empty">Escribe para buscar un cliente.</div>
                    </div>
                </div>

                <div class="doc-seleccion" id="clienteSeleccionadoBox" hidden>
                    <div class="doc-seleccion-texto">
                        <strong id="clienteSeleccionadoNombre"></strong>
                        <span id="clienteSeleccionadoDetalle"></span>
                    </div>

                    <div class="doc-seleccion-acciones">
                        <button type="button" class="btn-secondary btn-small" id="btnQuitarClienteCotizacion">Cambiar</button>
                    </div>
                </div>
            </section>

            <section class="ventas-search-section doc-buscador">
                <div class="ventas-client-clean-head">
                    <span>Agregar producto</span>
                </div>

                <div class="ventas-search-form">
                    <div class="ventas-search-input-wrap">
                        <span class="ventas-search-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2.5" aria-hidden="true">
                                <circle cx="11" cy="11" r="8" />
                                <line x1="21" y1="21" x2="16.65" y2="16.65" />
                            </svg>
                        </span>

                        <input type="search" id="buscarProductoCotizacion"
                            placeholder="Nombre, código de barras o SKU…" autocomplete="off" autofocus>

                        <div class="ventas-results-panel" id="resultadosProductosCotizacion" hidden>
                            <div class="ventas-empty-results">
                                <strong>Escribe para buscar</strong>
                                <span>Los productos aparecerán aquí.</span>
                            </div>
                        </div>
                    </div>

                    <button type="button" class="ventas-search-btn" id="btnBuscarProductoCotizacion">Buscar</button>
                </div>
            </section>
        </div>

        <section class="ui-tarjeta doc-lineas">
            <header class="ui-tarjeta-encabezado">
                <div>
                    <h3>Productos</h3>
                </div>
                <span class="ui-estado">Líneas:&nbsp;<b id="totalItemsCotizacion">0</b></span>
            </header>

            <div class="ui-tabla-contenedor">
                <table class="ui-tabla doc-tabla">
                    <thead>
                        <tr>
                            <th class="centro ventas-col-item">#</th>
                            <th>Producto</th>
                            <th class="centro">Cantidad</th>
                            <th class="num">Precio</th>
                            <th class="num">IVA</th>
                            <th class="num">Total</th>
                            <th class="centro" aria-label="Quitar"></th>
                        </tr>
                    </thead>

                    <tbody id="itemsCotizacion">
                        <tr class="ventas-cart-empty-row">
                            <td colspan="7">
                                <div class="ventas-cart-empty">
                                    <strong>Cotización vacía</strong>
                                    <span>Busca un producto y agrégalo a la cotización.</span>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="ui-tarjeta doc-datos">
            <header class="ui-tarjeta-encabezado">
                <div>
                    <h3>Condiciones</h3>
                </div>
            </header>

            <div class="ui-tarjeta-cuerpo doc-campos">
                <label class="ui-campo">
                    <span>Validez (días)</span>
                    <input type="number" id="validezDiasCotizacion" min="0" max="365" value="15">
                </label>

                <label class="ui-campo doc-campo-doble">
                    <span>Condiciones comerciales</span>
                    <textarea id="condicionesCotizacion" rows="2"
                        placeholder="Ej: Precios sujetos a disponibilidad.">Precios sujetos a disponibilidad. No afecta inventario.</textarea>
                </label>

                <label class="ui-campo doc-campo-doble">
                    <span>Observaciones</span>
                    <textarea id="observacionesCotizacion" rows="2" placeholder="Notas internas o aclaraciones…"></textarea>
                </label>
            </div>
        </section>

        <footer class="doc-pie">
            <div class="doc-pie-totales">
                <div class="ventas-total-row">
                    <span>Subtotal</span>
                    <strong id="resumenSubtotalCotizacion">$ 0</strong>
                </div>
                <div class="ventas-total-row">
                    <span>Descuento</span>
                    <strong id="resumenDescuentoCotizacion">$ 0</strong>
                </div>
                <div class="ventas-total-row">
                    <span>IVA</span>
                    <strong id="resumenIvaCotizacion">$ 0</strong>
                </div>
                <div class="ventas-total-row">
                    <span>Costo</span>
                    <strong id="resumenCostoCotizacion">$ 0</strong>
                </div>
                <div class="ventas-total-row">
                    <span>Utilidad</span>
                    <strong id="resumenUtilidadCotizacion">$ 0</strong>
                </div>
            </div>

            <div class="doc-pie-total">
                <span>Total</span>
                <strong id="resumenTotalCotizacion">$ 0</strong>
            </div>

            <span id="resumenClienteInfoCotizacion" hidden></span>
            <button type="submit" class="btn-primary doc-guardar" id="btnGuardarCotizacion">Crear cotización</button>
        </footer>
    </form>

        <div class="ventas-modal-backdrop" id="modalClienteRapidoCotizacion" hidden>
            <section class="ventas-modal-card" role="dialog" aria-modal="true"
                aria-labelledby="tituloClienteRapidoCotizacion">
                <header class="ventas-modal-header">
                    <div>
                        <h3 id="tituloClienteRapidoCotizacion">Nuevo cliente</h3>
                    </div>

                    <button type="button" class="ventas-modal-close" id="btnCerrarClienteRapidoCotizacion"
                        aria-label="Cerrar">
                        ×
                    </button>
                </header>

                <form class="ventas-client-quick-form" id="formClienteRapidoCotizacion" data-url="/clientes/rapido"
                    novalidate>
                    <div class="ventas-client-quick-alert" id="avisoClienteRapidoCotizacion" hidden></div>

                    <div class="ventas-client-quick-grid">
                        <label class="ventas-field">
                            <span>Tipo documento *</span>
                            <select name="tipo_documento" id="clienteRapidoCotizacionTipoDocumento">
                                <option value="CC">Cédula de ciudadanía</option>
                                <option value="NIT">NIT</option>
                                <option value="CE">Cédula de extranjería</option>
                                <option value="PP">Pasaporte</option>
                            </select>
                        </label>

                        <label class="ventas-field">
                            <span>Documento *</span>
                            <input type="text" name="documento" id="clienteRapidoCotizacionDocumento"
                                autocomplete="off">
                        </label>

                        <label class="ventas-field" id="campoClienteRapidoCotizacionDv" hidden>
                            <span>DV *</span>
                            <input type="text" name="digito_verificacion" id="clienteRapidoCotizacionDv" maxlength="1"
                                inputmode="numeric" autocomplete="off">
                        </label>

                        <label class="ventas-field ventas-client-quick-wide">
                            <span>Nombre / razón social *</span>
                            <input type="text" name="nombre" id="clienteRapidoCotizacionNombre" autocomplete="off"
                                placeholder="Ej: Carlos Ramírez / Empresa SAS">
                        </label>

                        <label class="ventas-field">
                            <span>Celular</span>
                            <input type="text" name="celular" id="clienteRapidoCotizacionCelular" autocomplete="off"
                                inputmode="tel">
                        </label>

                        <label class="ventas-field">
                            <span>Correo</span>
                            <input type="email" name="correo" id="clienteRapidoCotizacionCorreo" autocomplete="off">
                        </label>
                    </div>

                    <label class="ventas-client-quick-check">
                        <input type="checkbox" id="clienteRapidoCotizacionAutoriza" checked>
                        <span>Autoriza tratamiento de datos.</span>
                    </label>

                    <footer class="ventas-modal-actions">
                        <button type="button" class="btn-secondary" id="btnCancelarClienteRapidoCotizacion">
                            Cancelar
                        </button>

                        <button type="submit" class="btn-primary" id="btnGuardarClienteRapidoCotizacion">
                            Crear y seleccionar
                        </button>
                    </footer>
                </form>
            </section>
        </div>

        <script src="/js/dinero-exacto.js"></script>
        <script src="/js/cotizaciones.js"></script>
</section>