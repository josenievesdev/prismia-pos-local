<section class="module-page cotizaciones-page">
    <% const cotizacionesListado=Array.isArray(cotizaciones) ? cotizaciones : []; const filtrosActuales=filtros || {};
        function dinero(valor) { return new Intl.NumberFormat('es-CO', { style: 'currency' , currency: 'COP' ,
        maximumFractionDigits: 0, }).format(Number(valor || 0)); } function fecha(valor) { if (!valor)
        return 'Sin fecha' ; return String(valor).slice(0, 10); } function textoEstado(valor) { const estados={
        borrador: 'Borrador' , emitida: 'Emitida' , aceptada: 'Aceptada' , rechazada: 'Rechazada' , vencida: 'Vencida' ,
        convertida: 'Convertida' , anulada: 'Anulada' , }; return estados[valor] || valor || 'Sin estado' ; } function
        claseEstado(valor) { const clases={ borrador: 'is-draft' , emitida: 'is-issued' , aceptada: 'is-accepted' ,
        rechazada: 'is-rejected' , vencida: 'is-expired' , convertida: 'is-converted' , anulada: 'is-cancelled' , };
        return clases[valor] || 'is-muted' ; } function crearUrlPagina(pagina) { const params=new URLSearchParams(); if
        (filtrosActuales.busqueda) params.set('busqueda', filtrosActuales.busqueda); if (filtrosActuales.estado)
        params.set('estado', filtrosActuales.estado); if (filtrosActuales.fecha_desde) params.set('fecha_desde',
        filtrosActuales.fecha_desde); if (filtrosActuales.fecha_hasta) params.set('fecha_hasta',
        filtrosActuales.fecha_hasta); if (filtrosActuales.limite) params.set('limite', filtrosActuales.limite);
        params.set('pagina', pagina); return `/cotizaciones?${params.toString()}`; } %>

        <div class="module-header module-header-actions">
            <div>
                <p class="eyebrow">Gestión comercial</p>
                <h2>Cotizaciones</h2>
                <p>
                    Consulta propuestas comerciales emitidas antes de convertirlas en venta o remisión.
                </p>
            </div>

            <a href="/cotizaciones/nueva" class="btn-primary">
                Nueva cotización
            </a>
        </div>

        <% if (mensajeExito) { %>
            <div class="alert alert-success">
                <%= mensajeExito %>
            </div>
            <% } %>

                <% if (error) { %>
                    <div class="alert alert-error">
                        <%= error %>
                    </div>
                    <% } %>

                        <div class="info-strip">
                            <strong>Estado del módulo:</strong>
                            <span>
                                API funcional. La creación visual se conectará en la siguiente tanda.
                            </span>
                        </div>

                        <article class="module-card cotizaciones-filter-card">
                            <form method="GET" action="/cotizaciones" class="cotizaciones-filter-form">
                                <label class="form-group cotizaciones-filter-search">
                                    <span>Buscar</span>
                                    <input type="search" name="busqueda" value="<%= filtrosActuales.busqueda || '' %>"
                                        placeholder="Número, cliente, documento o usuario..." autocomplete="off">
                                </label>

                                <label class="form-group">
                                    <span>Estado</span>
                                    <select name="estado">
                                        <option value="">Todos</option>
                                        <option value="borrador" <%=filtrosActuales.estado==='borrador' ? 'selected'
                                            : '' %>>Borrador</option>
                                        <option value="emitida" <%=filtrosActuales.estado==='emitida' ? 'selected' : ''
                                            %>>Emitida</option>
                                        <option value="aceptada" <%=filtrosActuales.estado==='aceptada' ? 'selected'
                                            : '' %>>Aceptada</option>
                                        <option value="rechazada" <%=filtrosActuales.estado==='rechazada' ? 'selected'
                                            : '' %>>Rechazada</option>
                                        <option value="vencida" <%=filtrosActuales.estado==='vencida' ? 'selected' : ''
                                            %>>Vencida</option>
                                        <option value="convertida" <%=filtrosActuales.estado==='convertida' ? 'selected'
                                            : '' %>>Convertida</option>
                                        <option value="anulada" <%=filtrosActuales.estado==='anulada' ? 'selected' : ''
                                            %>>Anulada</option>
                                    </select>
                                </label>

                                <label class="form-group">
                                    <span>Desde</span>
                                    <input type="date" name="fecha_desde"
                                        value="<%= filtrosActuales.fecha_desde || '' %>">
                                </label>

                                <label class="form-group">
                                    <span>Hasta</span>
                                    <input type="date" name="fecha_hasta"
                                        value="<%= filtrosActuales.fecha_hasta || '' %>">
                                </label>

                                <label class="form-group">
                                    <span>Mostrar</span>
                                    <select name="limite">
                                        <option value="10" <%=Number(limiteResultados || 20)===10 ? 'selected' : '' %>
                                            >10</option>
                                        <option value="20" <%=Number(limiteResultados || 20)===20 ? 'selected' : '' %>
                                            >20</option>
                                        <option value="50" <%=Number(limiteResultados || 20)===50 ? 'selected' : '' %>
                                            >50</option>
                                    </select>
                                </label>

                                <div class="cotizaciones-filter-actions">
                                    <button type="submit" class="btn-primary">
                                        Filtrar
                                    </button>

                                    <a href="/cotizaciones" class="btn-secondary">
                                        Limpiar
                                    </a>
                                </div>
                            </form>
                        </article>

                        <article class="module-card cotizaciones-table-card">
                            <div class="cotizaciones-section-head">
                                <div>
                                    <span class="cotizaciones-section-eyebrow">Listado</span>
                                    <h3>Cotizaciones registradas</h3>
                                    <p>
                                        Se muestran las cotizaciones emitidas desde el módulo comercial.
                                    </p>
                                </div>

                                <span class="cotizaciones-section-count">
                                    Total: <strong>
                                        <%= totalResultados || 0 %>
                                    </strong>
                                </span>
                            </div>

                            <% if (!cotizacionesListado.length) { %>
                                <div class="empty-state">
                                    <h3>Sin cotizaciones</h3>
                                    <p>No hay cotizaciones que coincidan con los filtros aplicados.</p>
                                </div>
                                <% } else { %>
                                    <div class="table-wrapper cotizaciones-table-wrapper">
                                        <table class="data-table cotizaciones-table">
                                            <thead>
                                                <tr>
                                                    <th>Cotización</th>
                                                    <th>Cliente</th>
                                                    <th>Fechas</th>
                                                    <th>Valores</th>
                                                    <th class="text-center">Estado</th>
                                                    <th class="text-center">Acciones</th>
                                                </tr>
                                            </thead>

                                            <tbody>
                                                <% cotizacionesListado.forEach((cotizacion)=> { %>
                                                    <tr>
                                                        <td>
                                                            <div class="cotizaciones-main-cell">
                                                                <strong>
                                                                    <%= cotizacion.numero_cotizacion %>
                                                                </strong>
                                                                <span>ID #<%= cotizacion.id_cotizacion %> · <%=
                                                                            cotizacion.origen || 'manual' %></span>
                                                            </div>
                                                        </td>

                                                        <td>
                                                            <div class="cotizaciones-stack-cell">
                                                                <strong>
                                                                    <%= cotizacion.cliente_nombre_mostrar %>
                                                                </strong>
                                                                <span>
                                                                    <%= cotizacion.cliente_etiqueta %>
                                                                </span>
                                                            </div>
                                                        </td>

                                                        <td>
                                                            <div class="cotizaciones-stack-cell">
                                                                <strong>Emisión: <%= fecha(cotizacion.fecha_cotizacion)
                                                                        %></strong>
                                                                <span>Vence: <%= fecha(cotizacion.fecha_vencimiento) %>
                                                                </span>
                                                            </div>
                                                        </td>

                                                        <td class="text-right">
                                                        <td>
                                                            <div class="cotizaciones-values-cell">
                                                                <div>
                                                                    <span>Subtotal</span>
                                                                    <strong>
                                                                        <%= dinero(cotizacion.subtotal) %>
                                                                    </strong>
                                                                </div>

                                                                <div>
                                                                    <span>IVA</span>
                                                                    <strong>
                                                                        <%= dinero(cotizacion.impuesto_total) %>
                                                                    </strong>
                                                                </div>

                                                                <div>
                                                                    <span>Total</span>
                                                                    <strong class="cotizaciones-total-value">
                                                                        <%= dinero(cotizacion.total) %>
                                                                    </strong>
                                                                </div>

                                                                <div>
                                                                    <span>Utilidad</span>
                                                                    <strong
                                                                        class="<%= Number(cotizacion.utilidad_bruta || 0) >= 0 ? 'cotizaciones-profit-positive' : 'cotizaciones-profit-negative' %>">
                                                                        <%= dinero(cotizacion.utilidad_bruta) %>
                                                                    </strong>
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <td class="text-center">
                                                            <span
                                                                class="cotizaciones-status <%= claseEstado(cotizacion.estado) %>">
                                                                <%= textoEstado(cotizacion.estado) %>
                                                            </span>
                                                        </td>

                                                        <td class="text-center">
                                                            <div class="cotizaciones-actions">
                                                                <a href="/cotizaciones/<%= cotizacion.id_cotizacion %>"
                                                                    class="cotizaciones-link-action">
                                                                    Ver detalle
                                                                </a>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="cotizaciones-pagination">
                                        <span>
                                            Página <strong>
                                                <%= paginaActual %>
                                            </strong> de <strong>
                                                <%= totalPaginas %>
                                            </strong>
                                        </span>

                                        <div>
                                            <a href="<%= crearUrlPagina(paginaAnterior) %>"
                                                class="btn-secondary <%= tienePaginaAnterior ? '' : 'is-disabled' %>"
                                                aria-disabled="<%= tienePaginaAnterior ? 'false' : 'true' %>">
                                                Anterior
                                            </a>

                                            <a href="<%= crearUrlPagina(paginaSiguiente) %>"
                                                class="btn-secondary <%= tienePaginaSiguiente ? '' : 'is-disabled' %>"
                                                aria-disabled="<%= tienePaginaSiguiente ? 'false' : 'true' %>">
                                                Siguiente
                                            </a>
                                        </div>
                                    </div>
                                    <% } %>
                        </article>
</section>