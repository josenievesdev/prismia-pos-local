<% const licencia=typeof licenciaLocal !=='undefined' ? licenciaLocal : null; const urlPago=typeof whatsappPagoUrl
    !=='undefined' ? whatsappPagoUrl : '#' ; const estadoOperativo=licencia?.estado_operativo || 'no_disponible' ; const
    mensajeLicencia=licencia?.mensaje || 'No fue posible leer el estado de la licencia local.' ; const
    negocioLocal=licencia?.nombre_negocio_local || 'No registrado' ; const
    documentoNegocio=licencia?.documento_negocio_local || 'No registrado' ; const
    telefonoNegocio=licencia?.telefono_negocio_local || 'No registrado' ; const
    clienteLicencia=licencia?.cliente_licencia_resuelto || licencia?.cliente_licencia || negocioLocal; const
    planLicencia=licencia?.plan || 'No definido' ; const fechaFinOperativa=licencia?.fecha_fin_operativa
    || 'No disponible' ; const fechaFinGracia=licencia?.fecha_fin_gracia || 'No disponible' ; const
    fechaActivacion=licencia?.fecha_activacion || 'No disponible' ; const diasRestantes=licencia?.dias_restantes
    ?? 'No disponible' ; const diasGraciaRestantes=licencia?.dias_gracia_restantes ?? 'No disponible' ; const
    permiteOperar=Boolean(licencia?.permite_operar); const bloqueaOperacion=Boolean(licencia?.bloquea_operacion); const
    requiereActivacion=Boolean(licencia?.requiere_activacion); const firmaValida=Number(licencia?.firma_valida ||
    0)===1; const huellaCorta=licencia?.huella_equipo_actual_corta || 'No disponible' ; const
    huellaCompleta=licencia?.huella_equipo_actual || '' ; const estadoLabels={ prueba: 'Prueba activa' ,
    activa: 'Licencia activa' , gracia: 'Periodo de gracia' , vencida: 'Licencia vencida' ,
    bloqueada: 'Licencia bloqueada' , reloj_manipulado: 'Fecha del sistema irregular' ,
    sin_registro: 'Sin registro de licencia' , no_disponible: 'Licencia no disponible' , }; const
    estadoTitulo=estadoLabels[estadoOperativo] || 'Estado de licencia' ; let textoPrincipal=mensajeLicencia; if
    (estadoOperativo==='activa' ) { textoPrincipal=`Licencia activa hasta ${fechaFinOperativa}.`; } if
    (estadoOperativo==='prueba' ) { textoPrincipal=`Prueba local activa hasta ${fechaFinOperativa}.`; } if
    (estadoOperativo==='gracia' ) { textoPrincipal=`Licencia en periodo de gracia hasta ${fechaFinGracia}.`; } if
    (estadoOperativo==='vencida' ) { textoPrincipal='La licencia está vencida. Debes renovar para continuar operando.' ;
    } if (estadoOperativo==='bloqueada' || estadoOperativo==='reloj_manipulado' ) { textoPrincipal=mensajeLicencia; }
    const mostrarAvisoRenovacion=permiteOperar && requiereActivacion && !bloqueaOperacion; const
    mostrarAvisoProximoVencimiento=permiteOperar && !requiereActivacion && typeof diasRestantes==='number' &&
    diasRestantes <=5; %>

    <section class="module-page">
        <div class="module-header module-header-actions">
            <div>
                <p class="eyebrow">Licenciamiento local</p>
                <h2>Estado de licencia</h2>
                <p>
                    Consulta la vigencia de Prismia POS Local y solicita renovación cuando sea necesario.
                </p>
            </div>

            <div class="module-actions">
                <a href="/dashboard" class="btn-secondary">Volver al inicio</a>
                <a href="/licencia/activar" class="btn-primary">Ingresar código</a>
            </div>
        </div>

        <% if (error) { %>
            <div class="alert alert-error">
                <%= error %>
            </div>
            <% } %>

                <% if (mensajeExito) { %>
                    <div class="alert alert-success">
                        <%= mensajeExito %>
                    </div>
                    <% } %>

                        <% if (mostrarAvisoProximoVencimiento) { %>
                            <div class="alert alert-warning">
                                Tu licencia vence pronto. Te recomendamos renovarla para evitar interrupciones.
                            </div>
                            <% } %>

                                <% if (mostrarAvisoRenovacion) { %>
                                    <div class="alert alert-warning">
                                        La licencia todavía permite operar, pero requiere renovación para evitar bloqueo
                                        al finalizar el periodo de gracia.
                                    </div>
                                    <% } %>

                                        <section class="module-card license-renew-card">
                                            <div class="license-renew-hero">
                                                <div class="license-renew-badge">Prismia POS Local</div>

                                                <h1>
                                                    <%= estadoTitulo %>
                                                </h1>

                                                <p class="license-renew-lead">
                                                    <%= textoPrincipal %>
                                                        Tu información permanece guardada localmente en este equipo.
                                                </p>

                                                <div class="license-renew-date">
                                                    <span>Vigencia principal</span>
                                                    <strong>
                                                        <%= fechaFinOperativa %>
                                                    </strong>
                                                </div>

                                                <div class="license-renew-date">
                                                    <span>Días restantes</span>
                                                    <strong>
                                                        <%= diasRestantes %>
                                                    </strong>
                                                </div>
                                            </div>

                                            <div class="license-renew-content">
                                                <div class="license-renew-message">
                                                    <h3>Datos de la licencia</h3>

                                                    <ul class="license-renew-points">
                                                        <li>
                                                            Negocio local:
                                                            <strong>
                                                                <%= negocioLocal %>
                                                            </strong>
                                                        </li>

                                                        <li>
                                                            Cliente de licencia:
                                                            <strong>
                                                                <%= clienteLicencia %>
                                                            </strong>
                                                        </li>

                                                        <li>
                                                            Documento/NIT:
                                                            <strong>
                                                                <%= documentoNegocio %>
                                                            </strong>
                                                        </li>

                                                        <li>
                                                            Plan:
                                                            <strong>
                                                                <%= planLicencia %>
                                                            </strong>
                                                        </li>

                                                        <li>
                                                            Estado operativo:
                                                            <strong>
                                                                <%= estadoOperativo %>
                                                            </strong>
                                                        </li>

                                                        <li>
                                                            Permite operar:
                                                            <strong>
                                                                <%= permiteOperar ? 'Sí' : 'No' %>
                                                            </strong>
                                                        </li>

                                                        <li>
                                                            Firma de activación:
                                                            <strong>
                                                                <%= firmaValida ? 'Válida' : 'No registrada' %>
                                                            </strong>
                                                        </li>
                                                    </ul>
                                                </div>

                                                <div class="license-renew-message" style="margin-top: 1.5rem;">
                                                    <h3>Renovación y soporte</h3>

                                                    <p>
                                                        Si necesitas renovar, usa WhatsApp o copia la huella del equipo.
                                                        Con esos datos se puede generar un nuevo código de activación
                                                        para este computador.
                                                    </p>

                                                    <ul class="license-renew-points">
                                                        <li>
                                                            Fecha de activación:
                                                            <strong>
                                                                <%= fechaActivacion %>
                                                            </strong>
                                                        </li>

                                                        <li>
                                                            Periodo de gracia hasta:
                                                            <strong>
                                                                <%= fechaFinGracia %>
                                                            </strong>
                                                        </li>

                                                        <li>
                                                            Días de gracia restantes:
                                                            <strong>
                                                                <%= diasGraciaRestantes %>
                                                            </strong>
                                                        </li>

                                                        <li>
                                                            Huella corta:
                                                            <strong>
                                                                <%= huellaCorta %>
                                                            </strong>
                                                        </li>

                                                        <li>
                                                            Teléfono negocio:
                                                            <strong>
                                                                <%= telefonoNegocio %>
                                                            </strong>
                                                        </li>
                                                    </ul>
                                                </div>

                                                <div class="license-renew-actions">
                                                    <a href="/licencia/activar" class="btn-primary">
                                                        Ingresar código de activación
                                                    </a>

                                                    <button type="button" class="btn-secondary"
                                                        data-copy-huella="<%= huellaCompleta %>">
                                                        Copiar huella
                                                    </button>

                                                    <a href="<%= urlPago %>" class="btn-secondary" target="_blank"
                                                        rel="noreferrer">
                                                        Renovar por WhatsApp
                                                    </a>
                                                </div>

                                                <p class="license-renew-note">
                                                    Prismia valida esta licencia localmente mediante código firmado y
                                                    huella del equipo.
                                                    Más adelante podrá complementarse con validación online híbrida.
                                                    <br>
                                                    Huella técnica completa:
                                                    <span style="word-break: break-all;">
                                                        <%= huellaCompleta || 'No disponible' %>
                                                    </span>
                                                </p>
                                            </div>
                                        </section>
    </section>

    <script>
        document.querySelectorAll('[data-copy-huella]').forEach((boton) => {
            boton.addEventListener('click', async () => {
                const huella = boton.getAttribute('data-copy-huella') || '';

                if (!huella) {
                    boton.textContent = 'Huella no disponible';
                    return;
                }

                try {
                    await navigator.clipboard.writeText(huella);
                    boton.textContent = 'Huella copiada';

                    setTimeout(() => {
                        boton.textContent = 'Copiar huella';
                    }, 1800);
                } catch (error) {
                    const textarea = document.createElement('textarea');
                    textarea.value = huella;
                    textarea.setAttribute('readonly', '');
                    textarea.style.position = 'absolute';
                    textarea.style.left = '-9999px';

                    document.body.appendChild(textarea);
                    textarea.select();
                    document.execCommand('copy');
                    document.body.removeChild(textarea);

                    boton.textContent = 'Huella copiada';

                    setTimeout(() => {
                        boton.textContent = 'Copiar huella';
                    }, 1800);
                }
            });
        });
    </script>