<% const licencia=typeof licenciaLocal !=='undefined' ? licenciaLocal : null; const urlPago=typeof whatsappPagoUrl
    !=='undefined' ? whatsappPagoUrl : '#' ; const estadoOperativo=licencia && licencia.estado_operativo ?
    licencia.estado_operativo : 'no_disponible' ; const fechaFin=licencia && licencia.fecha_fin_operativa ?
    licencia.fecha_fin_operativa : licencia && licencia.fecha_fin_prueba ? licencia.fecha_fin_prueba : 'No disponible' ;
    const mensajeLicencia=licencia && licencia.mensaje ? licencia.mensaje
    : 'La licencia local requiere revisión para continuar operando.' ; %>

    <section class="module-page">
        <section class="module-card license-renew-card">
            <div class="license-renew-hero">
                <div class="license-renew-badge">Prismia POS Local</div>

                <h1>Tu licencia requiere activación</h1>

                <p class="license-renew-lead">
                    <%= mensajeLicencia %>
                        Tu información sigue guardada localmente. Para continuar usando los módulos operativos,
                        debes activar o renovar el servicio.
                </p>

                <div class="license-renew-date">
                    <span>Fecha operativa registrada</span>
                    <strong>
                        <%= fechaFin %>
                    </strong>
                </div>
            </div>

            <div class="license-renew-content">
                <div class="license-renew-message">
                    <h3>Activa Prismia para continuar operando</h3>

                    <p>
                        Prismia conserva la información del negocio en este equipo.
                        Para reactivar ventas, caja, inventario, reportes y demás módulos,
                        puedes escribirnos por WhatsApp y recibir el proceso de pago y activación.
                    </p>

                    <ul class="license-renew-points">
                        <li>Estado actual: <strong>
                                <%= estadoOperativo %>
                            </strong>.</li>
                        <li>Tu información sigue guardada localmente.</li>
                        <li>Retoma el trabajo normal apenas actives o renueves el servicio.</li>
                    </ul>
                </div>

                <div class="license-renew-actions">
                    <a href="<%= urlPago %>" class="btn-primary" target="_blank" rel="noreferrer">
                        Activar por WhatsApp
                    </a>

                    <form method="POST" action="/auth/logout">
                        <button type="submit" class="btn-secondary">
                            Cerrar sesión
                        </button>
                    </form>
                </div>

                <p class="license-renew-note">
                    Si ya realizaste el pago o deseas continuar con Prismia, escríbenos y te ayudamos con la activación.
                </p>
            </div>
        </section>
    </section>