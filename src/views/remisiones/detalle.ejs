<section class="module-page remisiones-page remisiones-detail-page">
    <% const items=Array.isArray(detalle) ? detalle : []; function dinero(valor) { return new Intl.NumberFormat('es-CO',
        { style: 'currency' , currency: 'COP' , maximumFractionDigits: 0, }).format(Number(valor || 0)); } function
        cantidad(valor) { const numero=Number(valor || 0); return new Intl.NumberFormat('es-CO', {
        minimumFractionDigits: Number.isInteger(numero) ? 0 : 2, maximumFractionDigits: 3, }).format(numero); } function
        fecha(valor) { if (!valor) return 'Sin fecha' ; return String(valor).slice(0, 10); } function fechaHora(valor) {
        if (!valor) return 'Sin fecha' ; return String(valor).replace('T', ' ' ).slice(0, 19); } function
        textoEstado(valor) { const estados={ borrador: 'Borrador' , emitida: 'Emitida' , entregada: 'Entregada' ,
        convertida: 'Convertida' , anulada: 'Anulada' , }; return estados[valor] || valor || 'Sin estado' ; } function
        claseEstado(valor) { const clases={ borrador: 'is-draft' , emitida: 'is-issued' , entregada: 'is-delivered' ,
        convertida: 'is-converted' , anulada: 'is-cancelled' , }; return clases[valor] || 'is-muted' ; } %>

        <div class="module-header module-header-actions">
            <div>
                <p class="eyebrow">Detalle comercial</p>
                <h2>
                    <%= remision.numero_remision %>
                </h2>
                <p>
                    Consulta productos, cliente, datos de entrega y valores de la remisión.
                </p>
            </div>

            <div class="remisiones-header-actions">
                <a href="/remisiones" class="btn-secondary">
                    Volver
                </a>
                <a href="/remisiones/<%= remision.id_remision %>/imprimir" class="btn-secondary" target="_blank"
                    rel="noopener">
                    Imprimir
                </a>

                <% if (remision.estado==='convertida' ) { %>
                    <button type="button" class="btn-primary" disabled>
                        Convertida
                    </button>
                    <% } else if (['emitida', 'entregada' ].includes(remision.estado)) { %>
                        <button type="button" class="btn-primary" id="btnAbrirConversionRemision"
                            data-id-remision="<%= remision.id_remision %>"
                            data-url-preparar="/remisiones/<%= remision.id_remision %>/convertir/preparar"
                            data-url-convertir="/remisiones/<%= remision.id_remision %>/convertir">
                            Convertir a venta
                        </button>
                        <% } else { %>
                            <button type="button" class="btn-primary" disabled>
                                No convertible
                            </button>
                            <% } %>
            </div>
        </div>

        <% if (mensajeExito) { %>
            <div class="alert alert-success">
                <%= mensajeExito %>
            </div>
            <% } %>

                <% if (error) { %>
                    <div class="alert alert-error">
                        <%= error %>
                    </div>
                    <% } %>

                        <article class="module-card remisiones-detail-summary">
                            <div class="remisiones-detail-main">
                                <div>
                                    <span class="remisiones-section-eyebrow">Remisión</span>
                                    <h3>
                                        <%= remision.numero_remision %>
                                    </h3>
                                    <p>
                                        Emitida por <strong>
                                            <%= remision.usuario_nombre || 'Usuario no disponible' %>
                                        </strong>
                                        el <strong>
                                            <%= fechaHora(remision.fecha_remision) %>
                                        </strong>.
                                    </p>
                                </div>

                                <span class="remisiones-status <%= claseEstado(remision.estado) %>">
                                    <%= textoEstado(remision.estado) %>
                                </span>
                            </div>

                            <div class="remisiones-detail-grid">
                                <div class="remisiones-detail-box">
                                    <span>Cliente</span>
                                    <strong>
                                        <%= remision.cliente_nombre_mostrar || 'Sin cliente' %>
                                    </strong>
                                    <p>
                                        <%= remision.cliente_etiqueta || 'Sin documento' %>
                                    </p>
                                </div>

                                <div class="remisiones-detail-box">
                                    <span>Entrega estimada</span>
                                    <strong>
                                        <%= fecha(remision.fecha_entrega_estimada) %>
                                    </strong>
                                    <p>Entregada: <%= fecha(remision.fecha_entregada) %>
                                    </p>
                                </div>

                                <div class="remisiones-detail-box">
                                    <span>Total</span>
                                    <strong>
                                        <%= dinero(remision.total) %>
                                    </strong>
                                    <p>Subtotal: <%= dinero(remision.subtotal) %>
                                    </p>
                                </div>

                                <div class="remisiones-detail-box">
                                    <span>Inventario</span>

                                    <% if (Number(remision.afecta_inventario || 0)===1) { %>
                                        <strong>Remisión con salida</strong>
                                        <p>La remisión afectó inventario el <%=
                                                fechaHora(remision.inventario_afectado_en) %>.</p>
                                        <% } else if (remision.estado==='convertida' && remision.id_venta_convertida) {
                                            %>
                                            <strong>Remisión sin salida</strong>
                                            <p>El inventario se descontó en la venta <%=
                                                    remision.venta_convertida_numero || '' %>.</p>
                                            <% } else { %>
                                                <strong>No afecta inventario</strong>
                                                <p>Documento comercial de entrega, sin salida de stock.</p>
                                                <% } %>
                                </div>
                            </div>
                        </article>

                        <% if (remision.estado==='convertida' ) { %>
                            <article class="module-card remisiones-converted-card">
                                <div class="remisiones-converted-main">
                                    <div>
                                        <span class="remisiones-section-eyebrow">Venta generada</span>

                                        <h3>
                                            <%= remision.numero_remision %>
                                                →
                                                <%= remision.venta_convertida_numero || 'Venta sin número' %>
                                        </h3>

                                        <p>
                                            Esta remisión fue convertida a venta real
                                            <% if (remision.convertida_en) { %>
                                                el <strong>
                                                    <%= fechaHora(remision.convertida_en) %>
                                                </strong>.
                                                <% } else { %>
                                                    correctamente.
                                                    <% } %>
                                                        La venta asociada registró pago, caja e inventario.
                                        </p>
                                    </div>

                                    <span class="remisiones-status is-converted">
                                        Convertida
                                    </span>
                                </div>

                                <div class="remisiones-converted-actions">
                                    <% if (remision.id_venta_convertida) { %>
                                        <a href="/ventas/<%= remision.id_venta_convertida %>" class="btn-secondary">
                                            Ver venta
                                        </a>

                                        <a href="/ventas/<%= remision.id_venta_convertida %>/ticket" class="btn-primary"
                                            target="_blank" rel="noopener">
                                            Imprimir ticket
                                        </a>
                                        <% } else { %>
                                            <span class="remisiones-muted-text">
                                                No se encontró el ID de la venta asociada.
                                            </span>
                                            <% } %>
                                </div>
                            </article>
                            <% } %>

                                <article class="module-card remisiones-delivery-card">
                                    <div class="remisiones-section-head">
                                        <div>
                                            <span class="remisiones-section-eyebrow">Entrega</span>
                                            <h3>Datos de entrega</h3>
                                            <p>
                                                Información usada para ubicar o contactar al receptor de la remisión.
                                            </p>
                                        </div>
                                    </div>

                                    <div class="remisiones-delivery-grid">
                                        <div>
                                            <span>Dirección</span>
                                            <strong>
                                                <%= remision.direccion_entrega || remision.cliente_direccion
                                                    || 'No registrada' %>
                                            </strong>
                                        </div>

                                        <div>
                                            <span>Contacto</span>
                                            <strong>
                                                <%= remision.contacto_entrega || remision.cliente_nombre_mostrar
                                                    || 'No registrado' %>
                                            </strong>
                                        </div>

                                        <div>
                                            <span>Teléfono</span>
                                            <strong>
                                                <%= remision.telefono_entrega || remision.cliente_celular ||
                                                    remision.cliente_telefono || 'No registrado' %>
                                            </strong>
                                        </div>
                                    </div>
                                </article>

                                <article class="module-card remisiones-detail-card">
                                    <div class="remisiones-section-head">
                                        <div>
                                            <span class="remisiones-section-eyebrow">Productos</span>
                                            <h3>Detalle de productos</h3>
                                            <p>
                                                Productos incluidos en la remisión. En esta fase no afectan inventario.
                                            </p>
                                        </div>

                                        <span class="remisiones-section-count">
                                            Ítems: <strong>
                                                <%= items.length %>
                                            </strong>
                                        </span>
                                    </div>

                                    <% if (!items.length) { %>
                                        <div class="empty-state">
                                            <h3>Sin productos</h3>
                                            <p>Esta remisión no tiene productos asociados.</p>
                                        </div>
                                        <% } else { %>
                                            <div class="table-wrapper remisiones-detail-table-wrapper">
                                                <table class="data-table remisiones-detail-table">
                                                    <thead>
                                                        <tr>
                                                            <th>Producto</th>
                                                            <th class="text-center">Cantidad</th>
                                                            <th class="text-right">Precio</th>
                                                            <th class="text-right">IVA</th>
                                                            <th class="text-right">Total línea</th>
                                                            <th class="text-center">Inventario</th>
                                                        </tr>
                                                    </thead>

                                                    <tbody>
                                                        <% items.forEach((item)=> { %>
                                                            <tr>
                                                                <td>
                                                                    <div class="remisiones-main-cell">
                                                                        <strong>
                                                                            <%= item.nombre_producto %>
                                                                        </strong>
                                                                        <span>
                                                                            <%= item.codigo_interno || 'Sin código' %>
                                                                                · <%= item.unidad_abreviatura || 'und'
                                                                                    %>
                                                                        </span>
                                                                    </div>
                                                                </td>

                                                                <td class="text-center">
                                                                    <%= cantidad(item.cantidad) %>
                                                                </td>

                                                                <td class="text-right">
                                                                    <div class="remisiones-stack-cell is-right">
                                                                        <strong>
                                                                            <%= dinero(item.precio_unitario) %>
                                                                        </strong>

                                                                        <% if (Number(item.descuento_unitario || 0)> 0)
                                                                            { %>
                                                                            <span>Desc: <%=
                                                                                    dinero(item.descuento_unitario) %>
                                                                            </span>
                                                                            <% } else { %>
                                                                                <span>Sin descuento</span>
                                                                                <% } %>
                                                                    </div>
                                                                </td>

                                                                <td class="text-right">
                                                                    <div class="remisiones-stack-cell is-right">
                                                                        <strong>
                                                                            <%= dinero(item.impuesto_total) %>
                                                                        </strong>
                                                                        <span>
                                                                            <%= item.porcentaje_iva || 0 %>%
                                                                        </span>
                                                                    </div>
                                                                </td>

                                                                <td class="text-right">
                                                                    <strong>
                                                                        <%= dinero(item.total_linea) %>
                                                                    </strong>
                                                                </td>

                                                                <td class="text-center">
                                                                    <% if (Number(item.afecta_inventario || 0)===1) { %>
                                                                        <span class="remisiones-inventory-badge is-on">
                                                                            Afecta
                                                                        </span>
                                                                        <% } else { %>
                                                                            <span
                                                                                class="remisiones-inventory-badge is-off">
                                                                                No afecta
                                                                            </span>
                                                                            <% } %>
                                                                </td>
                                                            </tr>
                                                            <% }) %>
                                                    </tbody>
                                                </table>
                                            </div>
                                            <% } %>
                                </article>

                                <section class="remisiones-detail-bottom">
                                    <article class="module-card remisiones-notes-card">
                                        <span class="remisiones-section-eyebrow">Condiciones</span>
                                        <h3>Condiciones de entrega</h3>

                                        <% if (remision.condiciones_entrega) { %>
                                            <p>
                                                <%= remision.condiciones_entrega %>
                                            </p>
                                            <% } else { %>
                                                <p class="remisiones-muted-text">
                                                    Sin condiciones de entrega registradas.
                                                </p>
                                                <% } %>
                                    </article>

                                    <article class="module-card remisiones-notes-card">
                                        <span class="remisiones-section-eyebrow">Notas</span>
                                        <h3>Observaciones</h3>

                                        <% if (remision.observaciones) { %>
                                            <p>
                                                <%= remision.observaciones %>
                                            </p>
                                            <% } else { %>
                                                <p class="remisiones-muted-text">
                                                    Sin observaciones registradas.
                                                </p>
                                                <% } %>
                                    </article>
                                </section>

                                <article class="module-card remisiones-totals-card">
                                    <div>
                                        <span>Subtotal</span>
                                        <strong>
                                            <%= dinero(remision.subtotal) %>
                                        </strong>
                                    </div>

                                    <div>
                                        <span>Descuento</span>
                                        <strong>
                                            <%= dinero(remision.descuento_total) %>
                                        </strong>
                                    </div>

                                    <div>
                                        <span>IVA</span>
                                        <strong>
                                            <%= dinero(remision.impuesto_total) %>
                                        </strong>
                                    </div>

                                    <div>
                                        <span>Total</span>
                                        <strong class="remisiones-total-value">
                                            <%= dinero(remision.total) %>
                                        </strong>
                                    </div>
                                </article>

                                <div class="remisiones-modal-backdrop" id="modalConvertirRemision" hidden>
                                    <section class="remisiones-modal-card" role="dialog" aria-modal="true"
                                        aria-labelledby="tituloConvertirRemision">
                                        <header class="remisiones-modal-header">
                                            <div>
                                                <span class="remisiones-section-eyebrow">Conversión</span>
                                                <h3 id="tituloConvertirRemision">Convertir remisión a venta</h3>
                                                <p>
                                                    Se creará una venta real, se descontará inventario y se registrará
                                                    el pago.
                                                </p>
                                            </div>

                                            <button type="button" class="remisiones-modal-close"
                                                id="btnCerrarConversionRemision" aria-label="Cerrar">
                                                ×
                                            </button>
                                        </header>

                                        <form id="formConvertirRemision" class="remisiones-convert-form" novalidate>
                                            <div class="remisiones-form-alert" id="alertaConversionRemision" hidden>
                                            </div>

                                            <div class="remisiones-convert-summary">
                                                <div>
                                                    <span>Remisión</span>
                                                    <strong id="conversionNumeroRemision">-</strong>
                                                </div>

                                                <div>
                                                    <span>Cliente</span>
                                                    <strong id="conversionClienteRemision">-</strong>
                                                </div>

                                                <div>
                                                    <span>Total</span>
                                                    <strong id="conversionTotalRemision">$ 0</strong>
                                                </div>
                                            </div>

                                            <div class="remisiones-convert-problems" id="conversionProblemasRemision"
                                                hidden></div>

                                            <div class="remisiones-convert-grid">
                                                <label class="form-group">
                                                    <span>Medio de pago *</span>
                                                    <select id="conversionMedioPagoRemision"></select>
                                                </label>

                                                <label class="form-group">
                                                    <span>Valor recibido *</span>
                                                    <input type="number" id="conversionMontoRecibidoRemision" min="0"
                                                        step="1">
                                                </label>

                                                <label class="form-group remisiones-convert-wide">
                                                    <span>Referencia</span>
                                                    <input type="text" id="conversionReferenciaRemision"
                                                        placeholder="Obligatoria para transferencias o tarjetas"
                                                        autocomplete="off">
                                                </label>

                                                <label class="form-group remisiones-convert-wide">
                                                    <span>Observaciones</span>
                                                    <textarea id="conversionObservacionesRemision" rows="3"
                                                        placeholder="Ej: Venta generada desde remisión..."></textarea>
                                                </label>
                                            </div>

                                            <footer class="remisiones-modal-actions">
                                                <button type="button" class="btn-secondary"
                                                    id="btnCancelarConversionRemision">
                                                    Cancelar
                                                </button>

                                                <button type="submit" class="btn-primary"
                                                    id="btnConfirmarConversionRemision">
                                                    Convertir a venta
                                                </button>
                                            </footer>
                                        </form>
                                    </section>
                                </div>

                                <script src="/js/remisiones.js"></script>
</section>