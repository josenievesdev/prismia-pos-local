<section class="module-page">
    <div class="module-header module-header-actions">
        <div>
            <p class="eyebrow">Productos</p>
            <h2>Categorías de productos</h2>
            <p>
                Organiza los productos del negocio por grupos para facilitar ventas, inventario y reportes.
            </p>
        </div>

        <a href="/categorias-productos/nueva" class="btn-primary">
            Nueva categoría
        </a>
    </div>

    <% if (mensajeExito) { %>
        <div class="alert alert-success">
            <%= mensajeExito %>
        </div>
        <% } %>

            <% if (error) { %>
                <div class="alert alert-error">
                    <%= error %>
                </div>
                <% } %>

                    <div class="module-card">
                        <% if (!categorias || categorias.length===0) { %>
                            <div class="empty-state">
                                <h3>No hay categorías registradas</h3>
                                <p>
                                    Crea la primera categoría para empezar a organizar los productos.
                                </p>

                                <a href="/categorias-productos/nueva" class="btn-primary">
                                    Crear categoría
                                </a>
                            </div>
                            <% } else { %>
                                <div class="table-wrapper">
                                    <table class="data-table">
                                        <thead>
                                            <tr>
                                                <th>Nombre</th>
                                                <th>Descripción</th>
                                                <th>Estado</th>
                                                <th>Creada</th>
                                                <th class="text-right">Acciones</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            <% categorias.forEach((categoria)=> { %>
                                                <tr>
                                                    <td>
                                                        <strong>
                                                            <%= categoria.nombre %>
                                                        </strong>
                                                    </td>

                                                    <td>
                                                        <span class="text-muted">
                                                            <%= categoria.descripcion || 'Sin descripción' %>
                                                        </span>
                                                    </td>

                                                    <td>
                                                        <% if (categoria.estado==='activo' ) { %>
                                                            <span class="badge badge-success">Activa</span>
                                                            <% } else { %>
                                                                <span class="badge badge-muted">Inactiva</span>
                                                                <% } %>
                                                    </td>

                                                    <td>
                                                        <span class="text-muted">
                                                            <%= categoria.creado_en %>
                                                        </span>
                                                    </td>

                                                    <td>
                                                        <div class="table-actions">
                                                            <a href="/categorias-productos/<%= categoria.id_categoria_producto %>/editar"
                                                                class="btn-secondary btn-small">
                                                                Editar
                                                            </a>

                                                            <% if (categoria.estado==='activo' ) { %>
                                                                <form method="POST"
                                                                    action="/categorias-productos/<%= categoria.id_categoria_producto %>/desactivar">
                                                                    <button type="submit"
                                                                        class="btn-secondary btn-small">
                                                                        Desactivar
                                                                    </button>
                                                                </form>
                                                                <% } else { %>
                                                                    <form method="POST"
                                                                        action="/categorias-productos/<%= categoria.id_categoria_producto %>/activar">
                                                                        <button type="submit"
                                                                            class="btn-secondary btn-small">
                                                                            Activar
                                                                        </button>
                                                                    </form>
                                                                    <% } %>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                                <% } %>
                    </div>
</section>