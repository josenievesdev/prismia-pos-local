<section class="module-page">
    <div class="module-header">
        <div>
            <p class="eyebrow">Administración</p>
            <h2>Configuración del negocio</h2>
            <p>
                Define la información principal que usará el sistema en recibos, reportes y módulos futuros.
            </p>
        </div>

        <%# Restaurantes y bares: meseros y propina sugerida (se usan con el perfil "Comidas y bares" del POS) %>
        <div class="ui-acciones">
            <a href="/meseros" class="btn-secondary">Meseros y propinas</a>
        </div>
    </div>

    <% if (mensajeExito) { %>
        <div class="alert alert-success">
            <%= mensajeExito %>
        </div>
        <% } %>

            <% if (error) { %>
                <div class="alert alert-error">
                    <%= error %>
                </div>
                <% } %>

                    <% if (!configuracion) { %>
                        <div class="module-card">
                            <h3>No hay configuración activa</h3>
                            <p class="text-muted">
                                No se encontró la configuración inicial del negocio.
                            </p>
                        </div>
                        <% } else { %>
                            <form class="module-card form-panel" method="POST" action="/configuracion">
                                <div class="form-section">
                                    <h3>Datos principales</h3>

                                    <div class="form-grid">
                                        <div class="form-group">
                                            <label for="nombre_negocio">Nombre del negocio *</label>
                                            <input type="text" id="nombre_negocio" name="nombre_negocio"
                                                value="<%= configuracion.nombre_negocio || '' %>" required>
                                        </div>

                                        <div class="form-group">
                                            <label for="nombre_comercial">Nombre comercial</label>
                                            <input type="text" id="nombre_comercial" name="nombre_comercial"
                                                value="<%= configuracion.nombre_comercial || '' %>">
                                        </div>

                                        <div class="form-group">
                                            <label for="tipo_documento">Tipo de documento</label>
                                            <select id="tipo_documento" name="tipo_documento">
                                                <option value="NIT" <%=configuracion.tipo_documento==='NIT' ? 'selected'
                                                    : '' %>>
                                                    NIT
                                                </option>
                                                <option value="CC" <%=configuracion.tipo_documento==='CC' ? 'selected'
                                                    : '' %>>
                                                    Cédula
                                                </option>
                                                <option value="CE" <%=configuracion.tipo_documento==='CE' ? 'selected'
                                                    : '' %>>
                                                    Cédula de extranjería
                                                </option>
                                                <option value="PAS" <%=configuracion.tipo_documento==='PAS' ? 'selected'
                                                    : '' %>>
                                                    Pasaporte
                                                </option>
                                            </select>
                                        </div>

                                        <div class="form-group">
                                            <label for="documento">Documento</label>
                                            <input type="text" id="documento" name="documento"
                                                value="<%= configuracion.documento || '' %>">
                                        </div>
                                    </div>
                                </div>

                                <div class="form-section">
                                    <h3>Contacto</h3>

                                    <div class="form-grid">
                                        <div class="form-group">
                                            <label for="direccion">Dirección</label>
                                            <input type="text" id="direccion" name="direccion"
                                                value="<%= configuracion.direccion || '' %>">
                                        </div>

                                        <div class="form-group">
                                            <label for="telefono">Teléfono</label>
                                            <input type="text" id="telefono" name="telefono"
                                                value="<%= configuracion.telefono || '' %>">
                                        </div>

                                        <div class="form-group">
                                            <label for="correo">Correo</label>
                                            <input type="email" id="correo" name="correo"
                                                value="<%= configuracion.correo || '' %>">
                                        </div>
                                    </div>
                                </div>

                                <div class="form-section">
                                    <h3>Parámetros del sistema</h3>

                                    <div class="form-grid">
                                        <div class="form-group">
                                            <label for="moneda">Moneda</label>
                                            <select id="moneda" name="moneda">
                                                <option value="COP" <%=configuracion.moneda==='COP' ? 'selected' : '' %>
                                                    >
                                                    COP - Peso colombiano
                                                </option>
                                                <option value="USD" <%=configuracion.moneda==='USD' ? 'selected' : '' %>
                                                    >
                                                    USD - Dólar
                                                </option>
                                            </select>
                                        </div>

                                        <div class="form-group">
                                            <input type="hidden" id="impuesto_por_defecto" name="impuesto_por_defecto"
                                                value="<%= configuracion.impuesto_por_defecto || 0 %>">
                                        </div>
                                    </div>

                                    <%
                                        // Mientras no se defina, nada viene marcado: el negocio debe elegir
                                        const ivaDefinido = Number(configuracion.iva_definido) === 1;
                                        const esResponsableIva = Number(configuracion.maneja_iva) === 1;
                                    %>
                                    <fieldset class="config-iva" id="ivaNegocio">
                                        <legend>¿Tu negocio es responsable de IVA?</legend>

                                        <% if (!ivaDefinido) { %>
                                            <p class="config-iva-pendiente">
                                                Falta definirlo. Mientras tanto, cada producto cobra el IVA que tenga.
                                            </p>
                                        <% } %>

                                        <div class="config-iva-opciones">
                                            <label class="config-iva-opcion">
                                                <input type="radio" name="maneja_iva" value="1" required
                                                    <%= ivaDefinido && esResponsableIva ? 'checked' : '' %>>
                                                <span>
                                                    <strong>Sí, soy responsable de IVA</strong>
                                                    <small>
                                                        Cobro IVA en mis ventas: cada producto dice si lleva 19 %, 5 % o no lleva.
                                                        El IVA que pago en compras se descuenta y no suma al costo.
                                                    </small>
                                                </span>
                                            </label>

                                            <label class="config-iva-opcion">
                                                <input type="radio" name="maneja_iva" value="0" required
                                                    <%= ivaDefinido && !esResponsableIva ? 'checked' : '' %>>
                                                <span>
                                                    <strong>No soy responsable de IVA</strong>
                                                    <small>
                                                        Mis ventas no llevan IVA y el ticket lo indica.
                                                        El IVA que pago en compras hace parte del costo.
                                                    </small>
                                                </span>
                                            </label>
                                        </div>

                                        <small class="text-muted">
                                            Está en tu RUT (responsabilidades): 48 es responsable de IVA y 49 es no responsable.
                                            Si tienes dudas, pregúntale a tu contador.
                                        </small>
                                    </fieldset>

                                    <div class="form-group">
                                        <label for="mensaje_recibo">Mensaje del recibo</label>
                                        <textarea id="mensaje_recibo" name="mensaje_recibo"
                                            rows="3"><%= configuracion.mensaje_recibo || '' %></textarea>
                                    </div>
                                </div>

                                <div class="form-actions">
                                    <button type="submit" class="btn-primary">
                                        Guardar configuración
                                    </button>

                                    <a href="/dashboard" class="btn-secondary">
                                        Volver
                                    </a>
                                </div>
                            </form>
                            <% } %>
</section>