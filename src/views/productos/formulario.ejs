<%
    // IVA del negocio (Configuración): si no es responsable, el producto no lleva IVA y no se pregunta
    const iva = locals.ivaNegocio || { definido: false, responsable: false, cobraIva: true };
    const esNuevo = modo === 'crear';

    // El precio de venta ya trae el IVA: aquí solo se elige la tarifa
    const ivaElegido = Math.round(Number(typeof producto.porcentaje_iva_visual !== 'undefined'
        ? producto.porcentaje_iva_visual
        : (producto.porcentaje_iva || 0)) || 0);
    const ivaFueraDeLista = ![0, 5, 19].includes(ivaElegido);

    const controlaInventario = Number(producto.controla_inventario) === 1;
    const costoPromedio = Math.round(Number(producto.costo_promedio) || 0);
    const pesos = (valor) => '$ ' + Math.round(Number(valor) || 0).toLocaleString('es-CO');
    const partesNombre = String(producto.nombre || '').trim().split(/\s+/);
    const iniciales = ((partesNombre[0] || '').charAt(0) + (partesNombre[1] || '').charAt(0)).toUpperCase() || 'P';
%>
<section class="module-page productos-page producto-creador-pagina">
    <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form class="producto-creador" method="POST" enctype="multipart/form-data"
        action="<%= esNuevo ? '/productos/nuevo' : '/productos/' + producto.id_producto + '/editar' %>"
        data-modo="<%= modo %>" data-cobra-iva="<%= iva.cobraIva ? '1' : '0' %>">
        <input type="hidden" name="imagen_url" value="<%= producto.imagen_url || '' %>">

        <div class="producto-creador-pasos">
            <%# ---------- 1. Qué vendes ---------- %>
            <section class="producto-paso" aria-labelledby="pasoProducto">
                <header class="producto-paso-cabecera">
                    <span class="producto-paso-numero" aria-hidden="true">1</span>
                    <div>
                        <h3 id="pasoProducto">¿Qué vendes?</h3>
                        <p>El nombre es como lo vas a buscar en el POS.</p>
                    </div>
                </header>

                <div class="producto-campos">
                    <div class="form-group producto-campo-ancho">
                        <label for="nombre">Nombre *</label>
                        <input type="text" id="nombre" name="nombre" value="<%= producto.nombre || '' %>"
                            placeholder="Ej.: Alambre calibre 12" autocomplete="off" required>
                    </div>

                    <div class="form-group">
                        <label for="id_categoria_producto">Categoría *</label>
                        <select id="id_categoria_producto" name="id_categoria_producto" required>
                            <option value="">Elige la categoría</option>
                            <% categorias.forEach((categoria) => { %>
                                <option value="<%= categoria.id_categoria_producto %>"
                                    <%= Number(producto.id_categoria_producto) === Number(categoria.id_categoria_producto) ? 'selected' : '' %>>
                                    <%= categoria.nombre %><%= categoria.estado === 'inactivo' ? ' (inactiva)' : '' %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="id_unidad_medida">Se vende por *</label>
                        <select id="id_unidad_medida" name="id_unidad_medida" required>
                            <option value="">Elige la unidad</option>
                            <% unidades.forEach((unidad) => { %>
                                <option value="<%= unidad.id_unidad_medida %>" data-abreviatura="<%= unidad.abreviatura %>"
                                    <%= Number(producto.id_unidad_medida) === Number(unidad.id_unidad_medida) ? 'selected' : '' %>>
                                    <%= unidad.nombre %> (<%= unidad.abreviatura %>)<%= Number(unidad.permite_decimales) === 1 ? ' · acepta decimales' : '' %>
                                </option>
                            <% }) %>
                        </select>
                        <small class="producto-ayuda">Unidad para lo normal; metro, kilo o litro si vendes por partes.</small>
                    </div>

                    <div class="form-group">
                        <label for="codigo_interno">Código interno *</label>
                        <input type="text" id="codigo_interno" name="codigo_interno"
                            value="<%= producto.codigo_interno || '' %>" placeholder="PRD-0001" autocomplete="off" required>
                    </div>

                    <div class="form-group">
                        <label for="codigo_barras">Código de barras</label>
                        <input type="text" id="codigo_barras" name="codigo_barras"
                            value="<%= producto.codigo_barras || '' %>" placeholder="Escanéalo aquí (opcional)" autocomplete="off">
                    </div>

                    <details class="producto-opcional producto-campo-ancho" <%= producto.descripcion ? 'open' : '' %>>
                        <summary>Descripción (opcional)</summary>
                        <textarea id="descripcion" name="descripcion" rows="3" aria-label="Descripción"
                            placeholder="Descripción corta del producto"><%= producto.descripcion || '' %></textarea>
                    </details>
                </div>
            </section>

            <%# ---------- 2. Precio: costo + ganancia + IVA = precio de venta ---------- %>
            <section class="producto-paso" aria-labelledby="pasoPrecio">
                <header class="producto-paso-cabecera">
                    <span class="producto-paso-numero" aria-hidden="true">2</span>
                    <div>
                        <h3 id="pasoPrecio">Precio</h3>
                        <p>
                            <% if (iva.cobraIva) { %>
                                El precio de venta ya lleva el IVA: es lo que paga el cliente y no cambia al cobrar.
                            <% } else { %>
                                Tu negocio no cobra IVA: el precio de venta es lo que paga el cliente.
                            <% } %>
                        </p>
                    </div>
                </header>

                <div class="producto-campos">
                    <div class="form-group">
                        <label for="precio_costo"><%= iva.cobraIva ? 'Costo de compra (antes de IVA)' : 'Costo de compra' %></label>
                        <div class="producto-dinero">
                            <span aria-hidden="true">$</span>
                            <input type="number" id="precio_costo" name="precio_costo" min="0" step="1" inputmode="numeric"
                                value="<%= producto.precio_costo || 0 %>">
                        </div>
                        <small class="producto-ayuda">
                            <% if (esNuevo) { %>
                                Lo que te cuesta cada unidad<%= iva.cobraIva ? ', sin el IVA del proveedor (ese IVA se descuenta)' : ', con el IVA que te cobre el proveedor' %>.
                            <% } else { %>
                                Costo de referencia. Las compras actualizan el costo promedio<%= costoPromedio > 0 ? ': hoy ' + pesos(costoPromedio) : '' %>.
                                <% if (costoPromedio > 0) { %>
                                    <button type="button" class="producto-enlace" data-usar-costo="<%= costoPromedio %>">Usar el costo promedio</button>
                                <% } %>
                            <% } %>
                        </small>
                    </div>

                    <% if (iva.cobraIva) { %>
                        <div class="form-group">
                            <label for="porcentaje_iva_visual">IVA del producto</label>
                            <select id="porcentaje_iva_visual" name="porcentaje_iva_visual">
                                <option value="19" <%= ivaElegido === 19 ? 'selected' : '' %>>IVA 19 % (tarifa general)</option>
                                <option value="5" <%= ivaElegido === 5 ? 'selected' : '' %>>IVA 5 %</option>
                                <option value="0" <%= ivaElegido === 0 ? 'selected' : '' %>>Sin IVA (excluido o exento)</option>
                                <% if (ivaFueraDeLista) { %>
                                    <option value="<%= ivaElegido %>" selected>IVA <%= ivaElegido %> % (el que tiene hoy)</option>
                                <% } %>
                            </select>
                            <small class="producto-ayuda">La mayoría de productos llevan 19 %. Si dudas de uno, pregúntale a tu contador.</small>
                        </div>
                    <% } else { %>
                        <div class="producto-sin-iva">
                            <strong>Sin IVA</strong>
                            <span>Tu negocio no es responsable de IVA. <a href="/configuracion#ivaNegocio">Cambiar en Configuración</a></span>
                        </div>
                    <% } %>

                    <div class="form-group">
                        <label for="gananciaProducto">Ganancia que quieres</label>
                        <div class="producto-dinero">
                            <input type="number" id="gananciaProducto" min="0" step="0.1" inputmode="decimal" placeholder="Ej.: 30">
                            <span aria-hidden="true">%</span>
                        </div>
                        <small class="producto-ayuda">Sobre el costo. Escríbela y el precio se calcula solo.</small>
                    </div>

                    <div class="form-group">
                        <label for="precio_venta">Precio de venta *</label>
                        <div class="producto-dinero producto-dinero-principal">
                            <span aria-hidden="true">$</span>
                            <input type="number" id="precio_venta" name="precio_venta" min="0" step="1" inputmode="numeric"
                                value="<%= producto.precio_venta || 0 %>" required>
                        </div>
                        <small class="producto-ayuda">Lo que paga el cliente por unidad<%= iva.cobraIva ? ', con el IVA incluido' : '' %>.</small>
                    </div>
                </div>

                <div class="producto-desglose" aria-live="polite">
                    <div><span>Costo</span><strong data-ver="costo">$ 0</strong></div>
                    <div><span>+ Ganancia</span><strong data-ver="ganancia">$ 0</strong></div>
                    <% if (iva.cobraIva) { %>
                        <div><span data-ver="iva-etiqueta">+ IVA</span><strong data-ver="iva">$ 0</strong></div>
                    <% } %>
                    <div class="producto-desglose-total"><span>= Precio de venta</span><strong data-ver="precio">$ 0</strong></div>
                </div>
                <p class="producto-alerta" data-ver="alerta" role="status" hidden></p>

                <% if (!iva.definido) { %>
                    <div class="producto-aviso-iva">
                        <strong>Falta definir si tu negocio es responsable de IVA</strong>
                        <span>Mientras tanto, cada producto cobra el IVA que tenga. <a href="/configuracion#ivaNegocio">Definirlo en Configuración</a></span>
                    </div>
                <% } %>
            </section>

            <%# ---------- 3. Inventario ---------- %>
            <section class="producto-paso" aria-labelledby="pasoInventario">
                <header class="producto-paso-cabecera">
                    <span class="producto-paso-numero" aria-hidden="true">3</span>
                    <div>
                        <h3 id="pasoInventario">Inventario</h3>
                        <p>Para saber cuánto te queda y cuándo pedir.</p>
                    </div>
                </header>

                <label class="check-option producto-opcion">
                    <input type="checkbox" id="controlaInventario" name="controla_inventario" value="1" <%= controlaInventario ? 'checked' : '' %>>
                    <span>
                        <strong>Llevar el inventario de este producto</strong>
                        <small>Cada venta descuenta del stock. Desmárcalo para servicios o lo que no se cuenta.</small>
                    </span>
                </label>

                <div class="producto-campos" data-con-inventario <%= controlaInventario ? '' : 'hidden' %>>
                    <% if (esNuevo) { %>
                        <div class="form-group">
                            <label for="stock_inicial">¿Cuánto tienes hoy?</label>
                            <input type="number" id="stock_inicial" name="stock_inicial" min="0" step="0.001"
                                value="<%= producto.stock_inicial || 0 %>">
                            <small class="producto-ayuda">Ej.: 100 unidades, 1000 metros o 12,5 kilos.</small>
                        </div>
                    <% } else { %>
                        <div class="form-group">
                            <label for="stockActualVista">Stock actual</label>
                            <input type="text" id="stockActualVista" value="<%= producto.stock_actual_texto || producto.stock_actual || 0 %>" disabled>
                            <small class="producto-ayuda">Se cambia con compras o con un ajuste en Inventario.</small>
                        </div>
                    <% } %>

                    <div class="form-group">
                        <label for="stock_minimo">Avisarme cuando queden</label>
                        <input type="number" id="stock_minimo" name="stock_minimo" min="0" step="0.001"
                            value="<%= producto.stock_minimo || 0 %>">
                        <small class="producto-ayuda">Sale en "Atención" del Inicio para que pidas a tiempo.</small>
                    </div>

                    <label class="check-option producto-opcion producto-campo-ancho">
                        <input type="checkbox" name="permite_venta_sin_stock" value="1" <%= Number(producto.permite_venta_sin_stock) === 1 ? 'checked' : '' %>>
                        <span>
                            <strong>Dejar vender aunque se acabe</strong>
                            <small>El POS avisa y el inventario queda en negativo. Útil si compras por fuera para cumplirle al cliente.</small>
                        </span>
                    </label>
                </div>
            </section>

            <%# ---------- 4. Foto y POS táctil (opcional) ---------- %>
            <section class="producto-paso" aria-labelledby="pasoFoto">
                <header class="producto-paso-cabecera">
                    <span class="producto-paso-numero" aria-hidden="true">4</span>
                    <div>
                        <h3 id="pasoFoto">Foto y POS táctil <small>opcional</small></h3>
                        <p>La foto ayuda a encontrarlo rápido en el modo táctil.</p>
                    </div>
                </header>

                <div class="producto-foto">
                    <div class="product-image-preview" data-ver="foto-grande">
                        <% if (producto.imagen_url) { %>
                            <img src="<%= producto.imagen_url %>" alt="Imagen de <%= producto.nombre || 'producto' %>">
                        <% } else { %>
                            <div class="product-image-placeholder">
                                <span>IMG</span>
                                <small>Sin foto</small>
                            </div>
                        <% } %>
                    </div>

                    <div class="producto-foto-campos">
                        <div class="form-group">
                            <label for="imagen_producto">Foto del producto</label>
                            <input type="file" id="imagen_producto" name="imagen_producto" accept="image/png,image/jpeg,image/webp">
                            <small class="producto-ayuda">JPG, PNG o WEBP de hasta 2 MB.</small>
                        </div>

                        <% if (!esNuevo && producto.imagen_url) { %>
                            <label class="check-option producto-opcion">
                                <input type="checkbox" name="quitar_imagen_producto" value="1">
                                <span>
                                    <strong>Quitar la foto actual</strong>
                                    <small>Se borra al guardar.</small>
                                </span>
                            </label>
                        <% } %>

                        <label class="check-option producto-opcion">
                            <input type="checkbox" name="mostrar_en_pos_tactil" value="1" <%= Number(producto.mostrar_en_pos_tactil) === 1 ? 'checked' : '' %>>
                            <span>
                                <strong>Mostrar en el POS táctil</strong>
                                <small>Sale como tarjeta rápida en el modo táctil.</small>
                            </span>
                        </label>

                        <div class="form-group">
                            <label for="orden_pos_tactil">Posición en el táctil</label>
                            <input type="number" id="orden_pos_tactil" name="orden_pos_tactil" min="1" step="1"
                                value="<%= producto.orden_pos_tactil || '' %>" placeholder="Ej.: 1">
                            <small class="producto-ayuda">Del 1 al 6 salen primero. Vacío: al final.</small>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <%# ---------- Vista previa y acciones ---------- %>
        <aside class="producto-creador-resumen" aria-label="Vista previa del producto">
            <div class="producto-resumen-tarjeta">
                <p class="producto-resumen-titulo">Así se ve en el POS</p>
                <div class="producto-vista-pos">
                    <div class="producto-vista-foto" data-ver="foto">
                        <% if (producto.imagen_url) { %>
                            <img src="<%= producto.imagen_url %>" alt="">
                        <% } else { %>
                            <span><%= iniciales %></span>
                        <% } %>
                    </div>
                    <div class="producto-vista-texto">
                        <strong data-ver="nombre"><%= producto.nombre || 'Nombre del producto' %></strong>
                        <span><b data-ver="precio-pos"><%= pesos(producto.precio_venta) %></b> / <span data-ver="unidad">und</span></span>
                    </div>
                </div>

                <p class="producto-resumen-titulo">Y así en el ticket</p>
                <div class="producto-vista-ticket">
                    <div><span>Subtotal</span><span data-ver="t-subtotal">$ 0</span></div>
                    <% if (iva.cobraIva) { %>
                        <div><span data-ver="t-iva-etiqueta">IVA</span><span data-ver="t-iva">$ 0</span></div>
                    <% } %>
                    <div class="producto-vista-ticket-total"><span>Total</span><span data-ver="t-total">$ 0</span></div>
                    <p>
                        <% if (!iva.cobraIva) { %>
                            No responsable de IVA.
                        <% } else { %>
                            El IVA se separa del precio; el cliente paga el precio de venta.
                        <% } %>
                    </p>
                </div>

                <div class="producto-resumen-acciones">
                    <button type="submit" class="btn-primary"><%= esNuevo ? 'Crear producto' : 'Guardar cambios' %></button>
                    <a href="/productos" class="btn-secondary">Cancelar</a>
                </div>
            </div>
        </aside>
    </form>
</section>

<script src="/js/dinero-exacto.js"></script>
<script src="/js/productos-formulario.js"></script>
