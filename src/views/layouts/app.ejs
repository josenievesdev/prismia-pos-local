<!DOCTYPE html>
<html lang="es" class="<%= (typeof rutaActual === 'string' && /^\/ventas\/?(\?.*)?$/.test(rutaActual)) ? 'ruta-pos' : '' %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= titulo || 'Panel' %> | <%= empresa.software.nombre %>
    </title>

    <script>
        // Estado del menú lateral calculado antes de pintar (evita parpadeo).
        // Misma regla que /js/shell.js: movil < 768 px; si no, la preferencia
        // guardada; sin preferencia, riel en pantallas < 1280 px.
        (function () {
            var raiz = document.documentElement;
            var preferencia = null;
            try { preferencia = localStorage.getItem('prismia.menu'); } catch (error) { }
            var ancho = window.innerWidth;
            var estado = 'completo';
            if (ancho < 768) estado = 'movil';
            else if (preferencia === 'compacto') estado = 'riel';
            else if (preferencia === 'expandido') estado = 'completo';
            else if (ancho < 1280) estado = 'riel';
            raiz.setAttribute('data-menu-estado', estado);
        })();
    </script>

    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/sistema.css">

    <% if (typeof estilosModulo !=='undefined' && Array.isArray(estilosModulo)) { %>
        <% estilosModulo.forEach((estilo)=> { %>
            <link rel="stylesheet" href="<%= estilo %>">
        <% }) %>
    <% } %>
</head>

<body>
    <div class="app-layout">
        <%- include('../partials/sidebar') %>

        <script>
            // El menú conserva su scroll al cambiar de módulo (se guarda en shell.js).
            // Corre aquí, justo después de dibujar el menú, para que no se vea el salto.
            (function () {
                var menu = document.getElementById('appSidebar');
                if (!menu) return;
                var guardado = null;
                try { guardado = sessionStorage.getItem('prismia.menu.scroll'); } catch (error) { }
                if (guardado !== null) {
                    menu.scrollTop = Number(guardado) || 0;
                } else {
                    var activo = menu.querySelector('.sidebar-link.active');
                    if (activo) activo.scrollIntoView({ block: 'nearest' });
                }
            })();
        </script>

        <div class="shell-backdrop" data-shell-close hidden></div>

        <section class="app-main">
            <%- include('../partials/header') %>

            <main class="app-content">
                <%- body %>
            </main>
        </section>
    </div>

    <script src="/js/shell.js"></script>

    <% if (typeof scriptsModulo !=='undefined' && Array.isArray(scriptsModulo)) { %>
        <% scriptsModulo.forEach((script)=> { %>
            <script src="<%= script %>"></script>
        <% }) %>
    <% } %>
</body>

</html>
