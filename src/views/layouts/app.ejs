<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= titulo || 'Panel' %> | <%= empresa.software.nombre %>
    </title>

    <link rel="stylesheet" href="/css/main.css">

    <% if (typeof estilosModulo !=='undefined' && Array.isArray(estilosModulo)) { %>
        <% estilosModulo.forEach((estilo)=> { %>
            <link rel="stylesheet" href="<%= estilo %>">
            <% }) %>
                <% } %>
</head>

<body>
    <div class="app-layout">
        <%- include('../partials/sidebar') %>

            <section class="app-main">
                <%- include('../partials/header') %>

                    <main class="app-content">
                        <%- body %>
                    </main>
            </section>
    </div>
    <% if (typeof scriptsModulo !=='undefined' && Array.isArray(scriptsModulo)) { %>
        <% scriptsModulo.forEach((script)=> { %>
            <script src="<%= script %>"></script>
            <% }) %>
                <% } %>
</body>

</html>