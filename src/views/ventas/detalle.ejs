<section class="module-page ventas-page ventas-detail-page">
    <% var ventaActual=venta || {}; var detalleListado=Array.isArray(detalle) ? detalle : []; var
        pagosListado=Array.isArray(pagos) ? pagos : []; var comprobanteActual=comprobante || {}; var
        notaCreditoActual=typeof notaCredito !=='undefined' ? notaCredito : null; var
        detalleNotaCreditoListado=Array.isArray(detalleNotaCredito) ? detalleNotaCredito : []; var mensajeOk=typeof
        mensajeExito !=='undefined' ? mensajeExito : null; var mensajeError=typeof error !=='undefined' ? error : null;
        var estadoVenta=ventaActual.estado || 'pagada' ; var puedeMostrarAnulacion=estadoVenta==='pagada' &&
        esAdministrador ; var ventaAnulada=estadoVenta==='anulada' ; var numeroFactura=comprobanteActual.numero ||
        ventaActual.numero_venta || 'FV-SIN-NUMERO' ; var clienteNombre=ventaActual.cliente_nombre || 'Consumidor final'
        ; var clienteTipoDocumento=ventaActual.cliente_tipo_documento || 'CF' ; var
        clienteDocumento=ventaActual.cliente_documento || '0000000000' ; var claseEstado='' ; if (estadoVenta==='pagada'
        ) claseEstado='is-paid' ; if (estadoVenta==='pendiente' ) claseEstado='is-pending' ; if (estadoVenta==='anulada'
        ) claseEstado='is-cancelled' ; function dinero(valor) { return new Intl.NumberFormat('es-CO', {
        style: 'currency' , currency: 'COP' , maximumFractionDigits: 0 }).format(Number(valor || 0)); } function
        numero(valor) { return new Intl.NumberFormat('es-CO', { maximumFractionDigits: 3 }).format(Number(valor || 0));
        } function fecha(valor) { if (!valor) return 'Sin fecha' ; var textoFecha=String(valor).replace(' ', ' T'); var
        fechaObj=new Date(textoFecha); if (Number.isNaN(fechaObj.getTime())) { return String(valor); } return
        fechaObj.toLocaleString('es-CO'); } %>

        <header class="ventas-detail-header">
            <div>
                <span class="ventas-kicker">Ventas</span>
                <h2>Detalle de venta</h2>
                <p>Consulta la información completa de la factura registrada desde el POS.</p>
            </div>

            <div class="ventas-detail-actions">
                <a href="/ventas/historial" class="btn-secondary">
                    Volver al historial
                </a>

                <a href="/ventas/<%= ventaActual.id_venta %>/ticket" class="btn-primary" target="_blank" rel="noopener">
                    Reimprimir ticket
                </a>

                <% if (puedeMostrarAnulacion) { %>
                    <button type="button" class="btn-danger" id="btnAbrirAnulacionVenta"
                        data-id-venta="<%= ventaActual.id_venta %>"
                        data-url-preparar="/ventas/<%= ventaActual.id_venta %>/anular/preparar"
                        data-url-anular="/ventas/<%= ventaActual.id_venta %>/anular">
                        Anular venta
                    </button>
                    <% } else if (ventaAnulada) { %>
                        <button type="button" class="btn-danger" disabled>
                            Venta anulada
                        </button>
                        <% } %>
            </div>
        </header>

        <% if (mensajeOk) { %>
            <div class="alert alert-success">
                <%= mensajeOk %>
            </div>
            <% } %>

                <% if (mensajeError) { %>
                    <div class="alert alert-error">
                        <%= mensajeError %>
                    </div>
                    <% } %>

                        <% if (ventaAnulada && notaCreditoActual) { %>
                            <section class="ventas-detail-card ventas-credit-note-card">
                                <div class="ventas-credit-note-main">
                                    <div>
                                        <span class="ventas-kicker">Nota crédito interna</span>

                                        <h3>
                                            <%= notaCreditoActual.numero_nota_credito %>
                                        </h3>

                                        <p>
                                            Documento interno generado por la anulación total de la venta
                                            <strong>
                                                <%= ventaActual.numero_venta %>
                                            </strong>.
                                        </p>
                                    </div>

                                    <span class="ventas-history-status is-cancelled">
                                        <%= notaCreditoActual.estado || 'emitida' %>
                                    </span>
                                </div>

                                <div class="ventas-credit-note-grid">
                                    <div>
                                        <span>Tipo</span>
                                        <strong>
                                            <%= notaCreditoActual.tipo_nota || 'total' %>
                                        </strong>
                                    </div>

                                    <div>
                                        <span>Origen</span>
                                        <strong>
                                            <%= notaCreditoActual.origen || 'anulacion_venta' %>
                                        </strong>
                                    </div>

                                    <div>
                                        <span>Estado fiscal</span>
                                        <strong>
                                            <%= notaCreditoActual.documento_fiscal_estado || 'interno' %>
                                        </strong>
                                    </div>

                                    <div>
                                        <span>Total</span>
                                        <strong>
                                            <%= dinero(notaCreditoActual.total) %>
                                        </strong>
                                    </div>
                                </div>

                                <% if (notaCreditoActual.motivo) { %>
                                    <div class="ventas-credit-note-message">
                                        <span>Motivo</span>
                                        <strong>
                                            <%= notaCreditoActual.motivo %>
                                        </strong>
                                    </div>
                                    <% } %>

                                        <% if (detalleNotaCreditoListado.length> 0) { %>
                                            <div class="ventas-credit-note-detail">
                                                <span>Productos asociados</span>

                                                <ul>
                                                    <% detalleNotaCreditoListado.forEach(function (item) { %>
                                                        <li>
                                                            <strong>
                                                                <%= item.nombre_producto %>
                                                            </strong>
                                                            <span>
                                                                <%= numero(item.cantidad) %>
                                                                    <%= item.unidad_abreviatura || 'und' %>
                                                                        · <%= dinero(item.total_linea) %>
                                                            </span>
                                                        </li>
                                                        <% }); %>
                                                </ul>
                                            </div>
                                            <% } %>

                                                <p class="ventas-credit-note-disclaimer">
                                                    Esta nota crédito es interna y no representa validación electrónica
                                                    DIAN.
                                                </p>
                            </section>
                            <% } %>

                                <section class="ventas-detail-summary">
                                    <article class="ventas-detail-main-card">
                                        <div class="ventas-detail-invoice-head">
                                            <div>
                                                <span class="ventas-detail-label">Factura</span>

                                                <strong>
                                                    <%= numeroFactura %>
                                                </strong>
                                            </div>

                                            <span class="ventas-history-status <%= claseEstado %>">
                                                <%= estadoVenta %>
                                            </span>
                                        </div>

                                        <dl class="ventas-detail-grid">
                                            <div>
                                                <dt>Fecha</dt>
                                                <dd>
                                                    <%= fecha(ventaActual.fecha_venta) %>
                                                </dd>
                                            </div>

                                            <div>
                                                <dt>Cliente</dt>
                                                <dd>
                                                    <%= clienteNombre %>
                                                </dd>
                                            </div>

                                            <div>
                                                <dt>Documento</dt>
                                                <dd>
                                                    <%= clienteTipoDocumento %>
                                                        <%= clienteDocumento %>
                                                </dd>
                                            </div>

                                            <div>
                                                <dt>Cajero</dt>
                                                <dd>
                                                    <%= ventaActual.cajero_nombre || 'Usuario' %>
                                                </dd>
                                            </div>

                                            <div>
                                                <dt>Turno</dt>
                                                <dd>#<%= ventaActual.id_turno_caja || 'N/A' %>
                                                </dd>
                                            </div>

                                            <div>
                                                <dt>Tipo de venta</dt>
                                                <dd>
                                                    <%= ventaActual.tipo_venta || 'contado' %>
                                                </dd>
                                            </div>
                                        </dl>
                                    </article>

                                    <aside class="ventas-detail-totals-card">
                                        <h3>Totales</h3>

                                        <div class="ventas-detail-total-row">
                                            <span>Subtotal</span>
                                            <strong>
                                                <%= dinero(ventaActual.subtotal) %>
                                            </strong>
                                        </div>

                                        <div class="ventas-detail-total-row">
                                            <span>IVA</span>
                                            <strong>
                                                <%= dinero(ventaActual.impuesto_total) %>
                                            </strong>
                                        </div>

                                        <div class="ventas-detail-total-row">
                                            <span>Descuento</span>
                                            <strong>
                                                <%= dinero(ventaActual.descuento_total) %>
                                            </strong>
                                        </div>

                                        <div class="ventas-detail-total-row is-grand-total">
                                            <span>Total</span>
                                            <strong>
                                                <%= dinero(ventaActual.total) %>
                                            </strong>
                                        </div>

                                        <div class="ventas-detail-total-row">
                                            <span>Pagado</span>
                                            <strong>
                                                <%= dinero(ventaActual.total_pagado) %>
                                            </strong>
                                        </div>

                                        <div class="ventas-detail-total-row">
                                            <span>Cambio</span>
                                            <strong>
                                                <%= dinero(ventaActual.cambio_entregado) %>
                                            </strong>
                                        </div>
                                    </aside>
                                </section>

                                <section class="ventas-detail-card">
                                    <div class="ventas-detail-card-header">
                                        <h3>Productos vendidos</h3>
                                        <span>
                                            <%= detalleListado.length %> ítems
                                        </span>
                                    </div>

                                    <% if (detalleListado.length===0) { %>
                                        <div class="ventas-history-empty">
                                            <strong>Esta venta no tiene productos asociados.</strong>
                                            <span>Revisa el registro de detalle de ventas.</span>
                                        </div>
                                        <% } else { %>
                                            <div class="ventas-history-table-wrap">
                                                <table class="ventas-history-table ventas-detail-table">
                                                    <thead>
                                                        <tr>
                                                            <th>Producto</th>
                                                            <th class="text-right">Cantidad</th>
                                                            <th class="text-right">Precio</th>
                                                            <th class="text-right">Desc. unit.</th>
                                                            <th class="text-right">IVA</th>
                                                            <th class="text-right">Total</th>
                                                        </tr>
                                                    </thead>

                                                    <tbody>
                                                        <% detalleListado.forEach(function (item) { %>
                                                            <tr>
                                                                <td>
                                                                    <strong>
                                                                        <%= item.nombre_producto %>
                                                                    </strong>

                                                                    <small class="ventas-history-meta">
                                                                        <%= item.codigo_interno || item.codigo_barras
                                                                            || 'Sin código' %>
                                                                            · <%= item.unidad_abreviatura || 'und' %>
                                                                    </small>
                                                                </td>

                                                                <td class="text-right">
                                                                    <%= numero(item.cantidad) %>
                                                                </td>

                                                                <td class="text-right">
                                                                    <%= dinero(item.precio_unitario) %>
                                                                </td>

                                                                <td class="text-right ventas-detail-discount-cell">
                                                                    <% const
                                                                        descuentoLineaItem=Number(item.descuento_unitario
                                                                        || 0) * Number(item.cantidad || 0); %>

                                                                        <% if (descuentoLineaItem> 0) { %>
                                                                            <strong>
                                                                                <%= dinero(item.descuento_unitario) %>
                                                                            </strong>
                                                                            <small>Línea: <%= dinero(descuentoLineaItem)
                                                                                    %></small>
                                                                            <% } else { %>
                                                                                <span
                                                                                    class="ventas-muted-value">—</span>
                                                                                <% } %>
                                                                </td>

                                                                <td class="text-right">
                                                                    <%= item.porcentaje_iva || 0 %>% · <%=
                                                                            dinero(item.impuesto_total) %>
                                                                </td>

                                                                <td class="text-right">
                                                                    <strong>
                                                                        <%= dinero(item.total_linea) %>
                                                                    </strong>
                                                                </td>
                                                            </tr>
                                                            <% }); %>
                                                    </tbody>
                                                </table>
                                            </div>
                                            <% } %>
                                </section>

                                <section class="ventas-detail-card">
                                    <div class="ventas-detail-card-header">
                                        <h3>Pagos registrados</h3>
                                        <span>
                                            <%= pagosListado.length %> pago(s)
                                        </span>
                                    </div>

                                    <% if (pagosListado.length===0) { %>
                                        <div class="ventas-history-empty">
                                            <strong>No hay pagos asociados a esta venta.</strong>
                                            <span>Revisa pagos_venta para este registro.</span>
                                        </div>
                                        <% } else { %>
                                            <div class="ventas-detail-payments">
                                                <% pagosListado.forEach(function (pago) { %>
                                                    <article class="ventas-detail-payment-item">
                                                        <div>
                                                            <strong>
                                                                <%= pago.medio_pago_nombre %>
                                                            </strong>

                                                            <span>
                                                                <%= pago.medio_pago_tipo %>
                                                            </span>

                                                            <% if (pago.referencia) { %>
                                                                <small>Referencia: <%= pago.referencia %></small>
                                                                <% } %>

                                                                    <% if (pago.estado==='anulado' ) { %>
                                                                        <small>Estado: anulado</small>
                                                                        <% } %>
                                                        </div>

                                                        <div>
                                                            <strong>
                                                                <%= dinero(pago.monto) %>
                                                            </strong>
                                                            <small>Recibido: <%= dinero(pago.monto_recibido) %></small>
                                                            <small>Cambio: <%= dinero(pago.cambio_entregado) %></small>
                                                        </div>
                                                    </article>
                                                    <% }); %>
                                            </div>
                                            <% } %>
                                </section>

                                <div class="ventas-modal-backdrop anulacion-venta-backdrop" id="modalAnularVenta"
                                    hidden>
                                    <section class="ventas-modal-card anulacion-venta-card" role="dialog"
                                        aria-modal="true" aria-labelledby="tituloAnularVenta">
                                        <header class="ventas-modal-header">
                                            <div>
                                                <span class="ventas-kicker">Anulación total</span>
                                                <h3 id="tituloAnularVenta">Anular venta</h3>
                                                <p>
                                                    Esta acción reversa la venta completa, devuelve inventario, anula
                                                    pagos y ajusta caja.
                                                </p>
                                            </div>

                                            <button type="button" class="ventas-modal-close"
                                                id="btnCerrarAnulacionVenta" aria-label="Cerrar">
                                                ×
                                            </button>
                                        </header>

                                        <form id="formAnularVenta" class="anulacion-venta-form" novalidate>
                                            <div class="ventas-client-quick-alert" id="alertaAnulacionVenta" hidden>
                                            </div>

                                            <div class="anulacion-warning">
                                                <strong>Atención</strong>
                                                <span>
                                                    No se eliminará la venta. Quedará marcada como anulada con
                                                    trazabilidad completa.
                                                </span>
                                            </div>

                                            <div class="anulacion-summary">
                                                <div>
                                                    <span>Venta</span>
                                                    <strong id="anulacionNumeroVenta">-</strong>
                                                </div>

                                                <div>
                                                    <span>Cliente</span>
                                                    <strong id="anulacionClienteVenta">-</strong>
                                                </div>

                                                <div>
                                                    <span>Total</span>
                                                    <strong id="anulacionTotalVenta">$ 0</strong>
                                                </div>

                                                <div>
                                                    <span>Estado</span>
                                                    <strong id="anulacionEstadoVenta">-</strong>
                                                </div>
                                            </div>

                                            <div class="anulacion-problems" id="anulacionProblemasVenta" hidden></div>

                                            <section class="anulacion-preview-grid">
                                                <article>
                                                    <span>Inventario</span>

                                                    <div id="anulacionInventarioVenta" class="anulacion-preview-list">
                                                        -
                                                    </div>
                                                </article>

                                                <article>
                                                    <span>Caja</span>

                                                    <div id="anulacionCajaVenta" class="anulacion-preview-list">
                                                        -
                                                    </div>
                                                </article>
                                            </section>

                                            <label class="ventas-field">
                                                <span>Motivo de anulación *</span>
                                                <textarea id="motivoAnulacionVenta" rows="3"
                                                    placeholder="Ej: Cliente solicitó anulación total de la venta."
                                                    required></textarea>
                                            </label>

                                            <label class="ventas-field">
                                                <span>Observaciones</span>
                                                <textarea id="observacionesAnulacionVenta" rows="2"
                                                    placeholder="Notas adicionales opcionales..."></textarea>
                                            </label>

                                            <footer class="ventas-modal-actions">
                                                <button type="button" class="btn-secondary"
                                                    id="btnCancelarAnulacionVenta">
                                                    Cancelar
                                                </button>

                                                <button type="submit" class="btn-danger"
                                                    id="btnConfirmarAnulacionVenta">
                                                    Anular venta
                                                </button>
                                            </footer>
                                        </form>
                                    </section>
                                </div>

                                <script src="/js/ventas-anulacion.js"></script>
</section>