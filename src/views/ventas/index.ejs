<%
    const fechaHoy = fechaHoyLocal;
    const fechaVista = String(fechaHoy || '').split('-').reverse().join('/');
    const mediosPagoListado = Array.isArray(mediosPago) ? mediosPago : [];
    const productosTactilesListado = Array.isArray(productosTactiles) ? productosTactiles : [];
    const clienteActual = clienteConsumidorFinal || { id_cliente: null, nombre: 'Consumidor final', tipo_documento: 'CF', documento: '0000000000' };
    const numeroFactura = (siguienteFactura && siguienteFactura.siguiente_numero) || 'FV-BORRADOR';

    // Frecuentes: las 6 posiciones de acceso rápido configuradas en Productos.
    const frecuentes = [null, null, null, null, null, null];
    productosTactilesListado.forEach(function (producto) {
        const posicion = Number(producto.orden_pos_tactil || 0);
        if (posicion >= 1 && posicion <= 6 && !frecuentes[posicion - 1]) frecuentes[posicion - 1] = producto;
    });

    // Solo los campos que usa pos.js (mismo formato que /ventas/productos/buscar).
    function productoPOS(p) {
        if (!p) return null;
        return {
            id_producto: p.id_producto, nombre: p.nombre, codigo_interno: p.codigo_interno, codigo_barras: p.codigo_barras,
            categoria_nombre: p.categoria_nombre, precio_venta: p.precio_venta, stock_disponible: p.stock_disponible,
            controla_inventario: p.controla_inventario, permite_venta_sin_stock: p.permite_venta_sin_stock,
            permite_cantidad_decimal: p.permite_cantidad_decimal, unidad_abreviatura: p.unidad_abreviatura,
            maneja_iva: p.maneja_iva, porcentaje_iva: p.porcentaje_iva, precio_incluye_iva: p.precio_incluye_iva,
            puede_vender: p.puede_vender, imagen_url: p.imagen_url,
        };
    }

    const datosPOS = {
        puedeVender: Boolean(puedeVender),
        esAdministrador: Boolean(esAdministrador),
        numeroFactura,
        consumidorFinal: {
            id: clienteActual.id_cliente || null,
            nombre: clienteActual.nombre || 'Consumidor final',
            documento: clienteActual.etiqueta_documento || [clienteActual.tipo_documento, clienteActual.documento].filter(Boolean).join(' '),
        },
        mediosPago: mediosPagoListado.map(function (medio) {
            return {
                id: medio.id_medio_pago, nombre: medio.nombre, tipo: medio.tipo,
                afectaEfectivo: Number(medio.afecta_efectivo_caja) === 1,
                requiereReferencia: Number(medio.requiere_referencia) === 1,
            };
        }),
        frecuentes: frecuentes.map(productoPOS),
        // Perfil "Comidas y bares": meseros activos y % de propina sugerida
        meseros: (Array.isArray(locals.meseros) ? meseros : []).map(function (mesero) {
            return { id_mesero: mesero.id_mesero, nombre: mesero.nombre };
        }),
        propinaPorcentaje: Number(locals.propinaPorcentajeSugerido ?? 10),
    };

    function iconoMedio(medio) {
        const nombre = String(medio.nombre || '').toLowerCase();
        if (medio.tipo === 'efectivo') return 'efectivo';
        if (/nequi|daviplata|movil|móvil|billetera/.test(nombre)) return 'celular';
        if (/bre-?b|llave/.test(nombre)) return 'rayo';
        if (medio.tipo === 'tarjeta') return 'tarjeta';
        if (medio.tipo === 'transferencia') return 'transferencia';
        return 'otro';
    }

    const iconos = {
        efectivo: '<rect x="2.5" y="6" width="19" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 9.5v5M18 9.5v5"/>',
        tarjeta: '<rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M2.5 10h19M6 15h4"/>',
        transferencia: '<path d="M4 8h14l-3-3M20 16H6l3 3"/>',
        celular: '<rect x="7" y="2.5" width="10" height="19" rx="2"/><path d="M11 18.5h2"/>',
        rayo: '<path d="M13 2.5 5 13.5h6l-1 8 8-11h-6z"/>',
        otro: '<circle cx="12" cy="12" r="8.5"/><path d="M12 8v8M8 12h8"/>',
    };
%>
<section class="pos" id="pos" data-puede-vender="<%= puedeVender ? 1 : 0 %>" aria-label="Punto de venta">
    <script type="application/json" id="datosPOS"><%- JSON.stringify(datosPOS).replace(/</g, '\\u003c') %></script>

    <div class="pos-principal">
        <% if (mensajeExito) { %><div class="alert alert-success"><%= mensajeExito %></div><% } %>
        <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

        <div class="pos-busqueda-fila">
            <div class="pos-buscador" id="buscadorPOS">
                <svg class="pos-buscador-icono" viewBox="0 0 24 24" width="20" height="20" fill="none"
                    stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                    <path d="M4 7V5.5A1.5 1.5 0 0 1 5.5 4H7M17 4h1.5A1.5 1.5 0 0 1 20 5.5V7M20 17v1.5a1.5 1.5 0 0 1-1.5 1.5H17M7 20H5.5A1.5 1.5 0 0 1 4 18.5V17M8 8v8M11 8v8M14 8v8M16.5 8v8" />
                </svg>

                <button type="button" class="pos-multiplicador" id="multiplicadorPOS" hidden
                    title="Cantidad para el próximo producto (clic para quitar)"></button>

                <input type="search" id="buscarProducto" placeholder="Buscar por nombre, código o SKU"
                    autocomplete="off" spellcheck="false" <%= puedeVender ? '' : 'disabled' %>
                    role="combobox" aria-autocomplete="list" aria-controls="resultadosPOS" aria-expanded="false">

                <kbd>F2</kbd>

                <div class="pos-resultados" id="resultadosPOS" role="listbox" hidden></div>
            </div>

            <div class="pos-cliente-zona">
                <button type="button" class="pos-cliente" id="btnClientePOS" aria-haspopup="dialog"
                    aria-expanded="false" <%= puedeVender ? '' : 'disabled' %>>
                    <span class="pos-cliente-avatar" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round"><circle cx="12" cy="8" r="4" /><path d="M4.5 21a7.5 7.5 0 0 1 15 0" /></svg>
                    </span>
                    <span class="pos-cliente-texto">
                        <strong id="clienteNombrePOS"><%= datosPOS.consumidorFinal.nombre %></strong>
                        <small id="clienteDocumentoPOS"><%= datosPOS.consumidorFinal.documento %></small>
                    </span>
                    <kbd>F4</kbd>
                </button>

                <div class="pos-cliente-panel" id="panelClientePOS" role="dialog" aria-label="Cliente de la venta" hidden>
                    <input type="search" id="buscarCliente" placeholder="Nombre, cédula o NIT" autocomplete="off"
                        spellcheck="false">
                    <div class="pos-cliente-resultados" id="resultadosClientes">
                        <p class="pos-cliente-vacio">Escribe para buscar un cliente.</p>
                    </div>
                    <footer>
                        <button type="button" class="btn-secondary btn-small" id="btnClienteFinalPOS">Consumidor final</button>
                        <button type="button" class="btn-primary btn-small" id="btnAbrirClienteRapido">+ Nuevo cliente</button>
                    </footer>
                </div>
            </div>

            <%# Mesero que atiende (solo perfil "Comidas y bares"; el CSS lo oculta en los demás) %>
            <div class="pos-mesero-zona">
                <button type="button" class="pos-cliente pos-mesero sin-elegir" id="btnMeseroPOS" aria-haspopup="listbox"
                    aria-expanded="false" <%= puedeVender ? '' : 'disabled' %>>
                    <span class="pos-cliente-avatar" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round"><path d="M4 17h16M5 17a7 7 0 0 1 14 0M12 7V5M10 5h4" /></svg>
                    </span>
                    <span class="pos-cliente-texto">
                        <small>Mesero</small>
                        <strong id="meseroNombrePOS">Elegir</strong>
                    </span>
                    <kbd>F3</kbd>
                </button>

                <div class="pos-cliente-panel pos-mesero-panel" id="panelMeseroPOS" role="dialog" aria-label="Mesero que atiende" hidden>
                    <div class="pos-mesero-lista" id="listaMeserosPOS" role="listbox" aria-label="Meseros activos"></div>
                    <% if (esAdministrador) { %>
                        <footer><a href="/meseros" class="pos-mesero-administrar">Administrar meseros</a></footer>
                    <% } %>
                </div>
            </div>
        </div>

        <section class="pos-ticket" aria-label="Venta actual">
            <header class="pos-ticket-cabecera">
                <strong class="pos-ticket-numero" id="numeroFacturaPOS" title="Número sugerido: se confirma al registrar"><%= numeroFactura %></strong>
                <span class="pos-ticket-fecha"><%= fechaVista %></span>
                <span class="pos-ticket-resumen" id="resumenTicketPOS">Sin productos</span>
            </header>

            <div class="pos-ticket-tabla" id="tablaTicketPOS">
                <table class="pos-lineas">
                    <colgroup>
                        <col class="pos-col-indice"><col><col class="pos-col-cantidad"><col class="pos-col-precio"><col class="pos-col-total">
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="centro">#</th>
                            <th>Producto</th>
                            <th class="centro">Cantidad</th>
                            <th class="num">Precio</th>
                            <th class="num">Total</th>
                        </tr>
                    </thead>
                    <tbody id="lineasPOS"></tbody>
                </table>

                <div class="pos-ticket-vacio" id="vacioTicketPOS">
                    <svg viewBox="0 0 24 24" width="38" height="38" fill="none" stroke="currentColor" stroke-width="1.6"
                        stroke-linecap="round" aria-hidden="true">
                        <path d="M4 7V5.5A1.5 1.5 0 0 1 5.5 4H7M17 4h1.5A1.5 1.5 0 0 1 20 5.5V7M20 17v1.5a1.5 1.5 0 0 1-1.5 1.5H17M7 20H5.5A1.5 1.5 0 0 1 4 18.5V17M8 8v8M11 8v8M14 8v8M16.5 8v8" />
                    </svg>
                    <span>Escanea o busca un producto</span>
                </div>
            </div>

            <button type="button" class="pos-ticket-arriba" id="btnArribaPOS" hidden></button>
        </section>

        <footer class="pos-barra">
            <div class="pos-atajos" aria-hidden="true">
                <span class="pos-atajo-comidas"><kbd>F3</kbd> Mesero</span>
                <span><kbd>F8</kbd> Cantidad</span>
                <span><kbd>F6</kbd> Descuento</span>
                <span><kbd>Supr</kbd> Quitar línea</span>
                <span><kbd>Esc</kbd> Cancelar</span>
            </div>

            <nav class="pos-acciones" aria-label="Acciones de la venta">
                <a href="/ventas/historial">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5M12 7v5l3 2"/></svg>
                    Historial
                </a>
                <button type="button" id="btnPendientePOS" disabled>
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 5v14M16 5v14"/></svg>
                    Dejar pendiente
                </button>
                <span class="pos-pendientes-zona">
                    <button type="button" id="btnPendientesPOS" aria-haspopup="dialog" aria-expanded="false" hidden></button>
                    <div class="pos-pendientes-panel" id="panelPendientesPOS" role="dialog" aria-label="Ventas pendientes" hidden></div>
                </span>
                <a href="/cotizaciones">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M14 3H6.5A1.5 1.5 0 0 0 5 4.5v15A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg>
                    Traer cotización
                </a>
                <button type="button" id="btnLimpiarVenta" disabled>
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg>
                    Limpiar
                </button>
            </nav>
        </footer>
    </div>

    <aside class="pos-lateral" id="lateralPOS" aria-label="Cobro">
        <section class="pos-exito" id="exitoPOS" role="status" hidden>
            <header>
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2"
                    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m8 12.5 2.6 2.5L16 9.5" /></svg>
                <strong id="exitoNumeroPOS"></strong>
                <span id="exitoTotalPOS"></span>
            </header>
            <span class="pos-exito-etiqueta">Cambio</span>
            <strong class="pos-exito-cambio" id="exitoCambioPOS">$ 0</strong>
            <span class="pos-exito-propina" id="exitoPropinaPOS" hidden></span>
            <div class="pos-exito-acciones">
                <a class="pos-exito-imprimir" id="exitoImprimirPOS" href="#" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M7 9V3h10v6M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2"/><path d="M7 14h10v7H7z"/></svg>
                    Imprimir ticket <kbd>Ctrl+P</kbd>
                </a>
                <button type="button" class="pos-exito-ocultar" id="exitoOcultarPOS">Ocultar</button>
            </div>
            <small>Se oculta al escanear el siguiente producto.</small>
        </section>

        <div class="pos-lateral-venta" id="lateralVentaPOS">
            <section class="pos-frecuentes" id="frecuentesPOS" aria-labelledby="tituloFrecuentesPOS">
                <header>
                    <h2 id="tituloFrecuentesPOS">Frecuentes</h2>
                    <div class="pos-frecuentes-herramientas">
                        <% if (esAdministrador) { %>
                            <button type="button" id="btnEditarFrecuentesPOS" aria-pressed="false">Editar</button>
                        <% } %>
                        <button type="button" id="btnPlegarFrecuentesPOS" aria-expanded="true">
                            <span>Plegar</span>
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="m6 15 6-6 6 6"/></svg>
                        </button>
                    </div>
                </header>
                <ul class="pos-frecuentes-lista" id="listaFrecuentesPOS"></ul>
            </section>

            <section class="pos-totales" aria-label="Totales">
                <div class="pos-total-fila pos-total-descuento" id="filaDescuentoPOS" hidden>
                    <span>Descuentos aplicados</span><strong id="descuentoPOS">$ 0</strong>
                </div>
                <div class="pos-total-fila"><span>Subtotal</span><strong id="subtotalPOS">$ 0</strong></div>
                <div class="pos-total-fila"><span id="etiquetaIvaPOS">IVA</span><strong id="ivaPOS">$ 0</strong></div>
                <div class="pos-total">
                    <span>Total</span>
                    <strong id="totalPOS">$ 0</strong>
                </div>
            </section>

            <button type="button" class="pos-cobrar" id="btnCobrarVenta" disabled>
                <span>Cobrar</span>
                <kbd>F9</kbd>
                <strong id="cobrarMontoPOS">$ 0</strong>
            </button>
        </div>

        <section class="pos-pago" id="pagoPOS" aria-labelledby="tituloPagoPOS" hidden>
            <header class="pos-pago-cabecera">
                <button type="button" class="pos-pago-volver" id="btnVolverPagoPOS" aria-label="Volver a la venta">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
                </button>
                <h2 id="tituloPagoPOS">Cobrar</h2>
                <kbd>Esc</kbd>
            </header>

            <div class="pos-pago-cuerpo">
            <div class="pos-pago-total">
                <span>Total</span>
                <strong id="pagoTotalPOS">$ 0</strong>
            </div>

            <%# Propina voluntaria (solo perfil "Comidas y bares"; pos.js la muestra u oculta) %>
            <div class="pos-propina" id="propinaPOS" hidden>
                <div class="pos-propina-cabecera">
                    <span>Propina voluntaria</span>
                    <small id="propinaMeseroPOS">Elige el mesero (F3)</small>
                </div>
                <div class="pos-propina-opciones" role="radiogroup" aria-label="Propina">
                    <button type="button" role="radio" aria-checked="true" data-propina="ninguna">Sin propina</button>
                    <button type="button" role="radio" aria-checked="false" data-propina="sugerida" title="Propina sugerida"><span>10 %</span><small>$ 0</small></button>
                    <button type="button" role="radio" aria-checked="false" data-propina="otra">Otro valor</button>
                </div>
                <label class="pos-propina-otra" id="propinaOtraZonaPOS" hidden>
                    <span aria-hidden="true">$</span>
                    <input type="text" id="propinaOtraPOS" inputmode="numeric" autocomplete="off" spellcheck="false"
                        placeholder="0" aria-label="Valor de la propina">
                </label>
            </div>

            <div class="pos-pago-total pos-pago-cobrar" id="aCobrarFilaPOS" hidden>
                <span>A cobrar</span>
                <strong id="aCobrarPOS">$ 0</strong>
            </div>

            <div class="pos-medios" id="mediosPOS" role="radiogroup" aria-label="Medio de pago">
                <% if (!mediosPagoListado.length) { %>
                    <p class="pos-medios-vacio">No hay medios de pago activos. Actívalos en Configuración.</p>
                <% } %>
                <% mediosPagoListado.forEach(function (medio, indice) { %>
                    <button type="button" class="pos-medio" role="radio" aria-checked="false"
                        aria-label="<%= medio.nombre %>" data-id-medio="<%= medio.id_medio_pago %>"
                        <% if (indice < 9) { %>title="Alt + <%= indice + 1 %>"<% } %>>
                        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8"
                            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- iconos[iconoMedio(medio)] %></svg>
                        <span><%= medio.nombre %></span>
                        <% if (indice < 9) { %><small><%= indice + 1 %></small><% } %>
                    </button>
                <% }) %>
            </div>

            <div class="pos-monto" id="montoZonaPOS">
                <label for="montoPOS" id="montoEtiquetaPOS">Monto</label>
                <input type="text" id="referenciaPOS" class="pos-monto-referencia" placeholder="Ref." autocomplete="off"
                    spellcheck="false" aria-label="Referencia del pago" hidden>
                <span class="pos-monto-valor">
                    <span aria-hidden="true">$</span>
                    <input type="text" id="montoPOS" inputmode="numeric" autocomplete="off" spellcheck="false" value="0">
                </span>
            </div>

            <div class="pos-billetes" id="billetesPOS">
                <button type="button" data-billete="exacto">Exacto</button>
                <button type="button" data-billete="10000" aria-label="Billete de 10.000">10.000</button>
                <button type="button" data-billete="20000" aria-label="Billete de 20.000">20.000</button>
                <button type="button" data-billete="50000" aria-label="Billete de 50.000">50.000</button>
                <button type="button" data-billete="100000" aria-label="Billete de 100.000">100.000</button>
            </div>

            <ul class="pos-pagos" id="pagosPOS" aria-label="Pagos agregados"></ul>

            <div class="pos-teclado" id="tecladoPOS" aria-label="Teclado numérico">
                <% ['7', '8', '9', '4', '5', '6', '1', '2', '3', '000', '0'].forEach(function (tecla) { %>
                    <button type="button" data-tecla="<%= tecla %>"><%= tecla %></button>
                <% }) %>
                <button type="button" data-tecla="borrar" aria-label="Borrar">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 5H9l-6 7 6 7h12z"/><path d="m13 9.5 5 5M18 9.5l-5 5"/></svg>
                </button>
            </div>
            </div>

            <%# Pie fijo: el estado del pago y "Registrar venta" siempre a la vista %>
            <div class="pos-pago-pie">
            <div class="pos-pago-error" id="errorPagoPOS" role="alert" hidden>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.5h.01"/></svg>
                <div>
                    <strong>No se pudo registrar la venta</strong>
                    <p id="errorPagoTextoPOS"></p>
                </div>
            </div>

            <div class="pos-pago-estado" id="estadoPagoPOS">
                <span id="estadoPagoEtiquetaPOS">Falta</span>
                <strong id="estadoPagoMontoPOS">$ 0</strong>
            </div>

            <button type="button" class="pos-registrar" id="btnRegistrarVentaPOS" disabled>
                <span id="textoRegistrarPOS">Registrar venta</span>
                <kbd>Enter</kbd>
            </button>
            </div>
        </section>
    </aside>

    <% if (!puedeVender) { %>
        <div class="pos-bloqueo" role="dialog" aria-modal="true" aria-labelledby="tituloBloqueoPOS"
            aria-describedby="textoBloqueoPOS">
            <div class="pos-bloqueo-tarjeta">
                <span class="pos-bloqueo-icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8"
                        stroke-linecap="round" stroke-linejoin="round"><path d="M6 11V6a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v5" /><path d="M9 8h6" /><rect x="3" y="11" width="18" height="9" rx="2" /><path d="M8 15.5h.01M12 15.5h.01M16 15.5h.01" /></svg>
                </span>
                <h2 id="tituloBloqueoPOS">Caja cerrada</h2>
                <p id="textoBloqueoPOS">Para vender, abre la caja con la base del turno.</p>
                <a href="/caja/abrir" class="pos-bloqueo-boton" autofocus>Abrir caja <kbd>Enter</kbd></a>
                <a href="/caja" class="pos-bloqueo-secundario">Ver turnos anteriores</a>
            </div>
        </div>
    <% } %>
</section>

<div class="ventas-modal-backdrop" id="modalAccesoRapidoTactil" hidden>
    <section class="ventas-modal ventas-quick-config-modal" role="dialog" aria-modal="true" aria-labelledby="tituloAccesoRapidoPOS">
        <header class="ventas-modal-header">
            <div>
                <h3 id="tituloAccesoRapidoPOS">Producto frecuente</h3>
            </div>
            <button type="button" class="ventas-modal-close" id="btnCerrarAccesoRapidoTactil" aria-label="Cerrar">×</button>
        </header>

        <form id="formAccesoRapidoTactil" class="ventas-quick-config-form"
            data-config-url="/ventas/pos-tactil/acceso-rapido"
            data-remove-url="/ventas/pos-tactil/acceso-rapido/quitar"
            data-move-url="/ventas/pos-tactil/acceso-rapido/mover">
            <input type="hidden" id="slotAccesoRapidoTactil" name="posicion">
            <input type="hidden" id="productoAccesoRapidoTactil" name="id_producto">

            <label class="ventas-field">
                <span>Buscar producto</span>
                <input type="search" id="buscarProductoAccesoRapido" placeholder="Nombre, código o SKU…" autocomplete="off">
            </label>

            <div class="ventas-quick-config-selected" id="productoAccesoRapidoSeleccionado" hidden></div>

            <div class="ventas-quick-config-results" id="resultadosAccesoRapidoTactil">
                <div class="ventas-quick-config-empty">Escribe para buscar un producto.</div>
            </div>

            <footer class="ventas-modal-actions">
                <button type="button" class="btn-secondary" id="btnCancelarAccesoRapidoTactil">Cancelar</button>
                <button type="submit" class="btn-primary" id="btnGuardarAccesoRapidoTactil" disabled>Guardar</button>
            </footer>
        </form>
    </section>
</div>

<div class="ventas-modal-backdrop" id="modalClienteRapido" hidden>
    <section class="ventas-modal-card" role="dialog" aria-modal="true" aria-labelledby="tituloClienteRapido">
        <header class="ventas-modal-header">
            <div>
                <h3 id="tituloClienteRapido">Nuevo cliente</h3>
            </div>
            <button type="button" class="ventas-modal-close" id="btnCerrarClienteRapido" aria-label="Cerrar">×</button>
        </header>

        <form class="ventas-client-quick-form" id="formClienteRapido" data-url="/clientes/rapido" novalidate>
            <div class="ventas-client-quick-alert" id="avisoClienteRapido" hidden></div>

            <div class="ventas-client-quick-grid">
                <label class="ventas-field">
                    <span>Tipo documento *</span>
                    <select name="tipo_documento" id="clienteRapidoTipoDocumento">
                        <option value="CC">Cédula de ciudadanía</option>
                        <option value="NIT">NIT</option>
                        <option value="CE">Cédula de extranjería</option>
                        <option value="PP">Pasaporte</option>
                    </select>
                </label>

                <label class="ventas-field">
                    <span>Documento *</span>
                    <input type="text" name="documento" id="clienteRapidoDocumento" autocomplete="off">
                </label>

                <label class="ventas-field" id="campoClienteRapidoDv" hidden>
                    <span>DV *</span>
                    <input type="text" name="digito_verificacion" id="clienteRapidoDv" maxlength="1" inputmode="numeric"
                        autocomplete="off">
                </label>

                <label class="ventas-field ventas-client-quick-wide">
                    <span>Nombre / razón social *</span>
                    <input type="text" name="nombre" id="clienteRapidoNombre" autocomplete="off"
                        placeholder="Ej: Carlos Ramírez / Constructora Andina S.A.S.">
                </label>

                <label class="ventas-field">
                    <span>Celular</span>
                    <input type="text" name="celular" id="clienteRapidoCelular" autocomplete="off" inputmode="tel">
                </label>

                <label class="ventas-field">
                    <span>Correo</span>
                    <input type="email" name="correo" id="clienteRapidoCorreo" autocomplete="off">
                </label>
            </div>

            <label class="ventas-client-quick-check">
                <input type="checkbox" id="clienteRapidoAutoriza" checked>
                <span>Autoriza tratamiento de datos.</span>
            </label>

            <footer class="ventas-modal-actions">
                <button type="button" class="btn-secondary" id="btnCancelarClienteRapido">Cancelar</button>
                <button type="submit" class="btn-primary" id="btnGuardarClienteRapido">Crear y seleccionar</button>
            </footer>
        </form>
    </section>
</div>

