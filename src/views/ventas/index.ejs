<section class="module-page ventas-page">
    <% const fechaHoy=new Date().toISOString().slice(0, 10); const productosListado=Array.isArray(productos) ? productos
        : []; const productosTactilesListado=Array.isArray(productosTactiles) ? productosTactiles : []; const
        mediosPagoListado=Array.isArray(mediosPago) ? mediosPago : []; const categoriasCatalogoPOS=Array.from(new Set(
        productosListado .map(function (producto) { return producto.categoria_nombre || 'Sin categoría' ; })
        .filter(Boolean) )).slice(0, 10); const clienteActual=clienteConsumidorFinal || { id_cliente: null,
        nombre: 'Consumidor final' , documento: '0000000000' }; const nombreCajero=turnoAbierto ?
        (turnoAbierto.usuario_apertura_nombre || 'Usuario' ) : 'Sin caja abierta' ; const
        facturaSugeridaPOS=siguienteFactura || { prefijo: 'FV' , siguiente_numero: 'FV-BORRADOR' }; const
        prefijoFacturaPOS=facturaSugeridaPOS.prefijo || 'FV' ; const
        nomenclaturaFacturaPOS=facturaSugeridaPOS.siguiente_numero || (prefijoFacturaPOS + '-BORRADOR' ); function
        nombreTipoMedio(t) { if (t==='efectivo' ) return 'Efectivo' ; if (t==='transferencia' ) return 'Transferencia' ;
        if (t==='tarjeta' ) return 'Tarjeta' ; return 'Otro' ; } %>

        <div class="ventas-pos-shell" data-puede-vender="<%= puedeVender ? 1 : 0 %>" data-pos-mode="clasico">

            <header class="ventas-pos-header">
                <div class="ventas-header-left">
                    <div class="ventas-header-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2.2">
                            <rect x="2" y="3" width="20" height="14" rx="2" />
                            <line x1="8" y1="21" x2="16" y2="21" />
                            <line x1="12" y1="17" x2="12" y2="21" />
                        </svg>
                    </div>

                    <div>
                        <h2>Punto de Venta</h2>
                        <span class="ventas-header-sub">Factura central</span>
                    </div>
                </div>

                <div class="ventas-mode-tools">
                    <div class="ventas-mode-switch">
                        <button type="button" class="ventas-mode-toggle" id="btnCambiarModoPOS" aria-pressed="false"
                            title="Cambiar modo de vista del POS">
                            <span class="ventas-mode-toggle-track" aria-hidden="true">
                                <span class="ventas-mode-toggle-thumb"></span>
                            </span>

                            <span class="ventas-mode-toggle-copy">
                                <strong id="textoModoPOS">Modo clásico</strong>
                                <small>Vista POS</small>
                            </span>
                        </button>
                    </div>

                    <div class="ventas-business-switch" id="selectorPerfilPOS" aria-label="Perfil visual del POS">
                        <button type="button" class="ventas-business-option is-active"
                            data-pos-business-option="general">
                            General
                        </button>

                        <button type="button" class="ventas-business-option" data-pos-business-option="comidas">
                            Comidas
                        </button>

                        <button type="button" class="ventas-business-option" data-pos-business-option="boutique">
                            Boutique
                        </button>
                    </div>
                </div>

                <div class="ventas-header-status">
                    <span class="ventas-status-chip <%= turnoAbierto ? 'is-open' : 'is-closed' %>">
                        <span class="ventas-status-dot"></span>
                        <%= turnoAbierto ? 'Caja abierta' : 'Caja cerrada' %>
                    </span>

                    <% if (turnoAbierto) { %>
                        <span class="ventas-header-meta">
                            Turno <strong>#<%= turnoAbierto.id_turno_caja %></strong>
                        </span>
                        <% } else { %>
                            <span class="ventas-header-meta">Sin turno</span>
                            <% } %>

                                <span class="ventas-header-meta ventas-header-cajero">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                        <circle cx="12" cy="7" r="4" />
                                    </svg>
                                    <%= nombreCajero %>
                                </span>
                </div>
            </header>

            <% if (mensajeExito) { %>
                <div class="alert alert-success">
                    <%= mensajeExito %>
                </div>
                <% } %>

                    <% if (error) { %>
                        <div class="alert alert-error">
                            <%= error %>
                        </div>
                        <% } %>

                            <% if (mensajeBloqueo) { %>
                                <div class="ventas-lock-banner">
                                    <div>
                                        <strong>Venta bloqueada</strong>
                                        <span>
                                            <%= mensajeBloqueo %>
                                        </span>
                                    </div>

                                    <a href="/caja/abrir" class="btn-primary">Abrir caja</a>
                                </div>
                                <% } %>

                                    <section class="ventas-context-bar">
                                        <div
                                            class="ventas-context-item is-client ventas-client-search-box ventas-client-clean">
                                            <div class="ventas-client-clean-head">
                                                <span>Cliente</span>

                                                <div class="ventas-client-clean-actions">
                                                    <strong>Consumidor final</strong>

                                                    <button type="button" class="ventas-client-new-btn"
                                                        id="btnAbrirClienteRapido">
                                                        + Nuevo
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="ventas-client-search-wrap ventas-client-clean-search">
                                                <input type="search" id="buscarCliente" name="buscar_cliente"
                                                    value="<%= clienteActual.nombre %>"
                                                    placeholder="Buscar cliente por nombre, documento o teléfono..."
                                                    autocomplete="off" data-search-clients-url="/ventas/clientes/buscar"
                                                    data-selected-client-id="<%= clienteActual.id_cliente || '' %>">

                                                <div class="ventas-client-results" id="resultadosClientes" hidden>
                                                    <div class="ventas-client-result-empty">
                                                        Escribe para buscar un cliente.
                                                    </div>
                                                </div>
                                            </div>

                                            <small id="clienteDocumentoActual" hidden>
                                                <%= clienteActual.documento || '' %>
                                            </small>
                                        </div>

                                        <label class="ventas-context-item ventas-date-item" for="fechaVenta">
                                            <span>Fecha</span>
                                            <input type="date" id="fechaVenta" name="fecha_venta"
                                                value="<%= fechaHoy %>" max="<%= fechaHoy %>"
                                                data-fecha-hoy="<%= fechaHoy %>">
                                        </label>

                                        <div class="ventas-context-item ventas-invoice-code-box">
                                            <span>Factura</span>
                                            <strong data-factura-sugerida>
                                                <%= nomenclaturaFacturaPOS %>
                                            </strong>
                                            <small>Número sugerido. Se confirma al guardar</small>
                                        </div>

                                        <div class="ventas-context-item ventas-context-actions">
                                            <span>Acciones</span>

                                            <div class="ventas-context-buttons">
                                                <a href="/ventas/historial" class="btn-secondary">
                                                    Historial
                                                </a>

                                                <button type="button" class="btn-secondary" id="btnLimpiarVenta"
                                                    disabled>
                                                    Limpiar
                                                </button>

                                                <button type="button" class="btn-secondary" id="btnVentaPendiente"
                                                    disabled>
                                                    Pendiente
                                                </button>

                                                <button type="button" class="btn-primary ventas-charge-button"
                                                    id="btnCobrarVenta" <%=puedeVender ? '' : 'disabled' %>>
                                                    Cobrar
                                                </button>
                                            </div>

                                            <small>Atajos operativos de la venta</small>
                                        </div>
                                    </section>

                                    <section class="ventas-search-section">
                                        <form class="ventas-search-form" method="GET" action="/ventas"
                                            id="formBusquedaProductos">
                                            <div class="ventas-search-input-wrap">
                                                <span class="ventas-search-icon">
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                                        stroke="currentColor" stroke-width="2.5">
                                                        <circle cx="11" cy="11" r="8" />
                                                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                                                    </svg>
                                                </span>

                                                <input type="search" id="buscarProducto" name="busqueda" value=""
                                                    placeholder="Buscar producto por nombre, código de barras o SKU…"
                                                    autocomplete="off" autofocus
                                                    data-search-products-url="/ventas/productos/buscar">

                                                <div class="ventas-results-panel" id="panelResultados" hidden>
                                                    <div class="ventas-empty-results">
                                                        <strong>Escribe para buscar</strong>
                                                        <span>Los productos aparecerán aquí.</span>
                                                    </div>
                                                </div>
                                            </div>

                                            <button type="submit" class="ventas-search-btn">Buscar</button>
                                        </form>

                                        <div class="ventas-search-loading-bar">
                                            <span class="ventas-search-loading" id="searchLoading">
                                                <span class="ventas-loading-spinner"></span>
                                                Buscando…
                                            </span>
                                        </div>
                                    </section>

                                    <section class="ventas-touch-catalog ventas-quick-access" id="catalogoTactilPOS"
                                        aria-label="Accesos rápidos táctiles">
                                        <% const totalSlotsTactiles=6; const productosRapidosPorPosicion=new Map();
                                            productosTactilesListado.forEach(function (producto) { const
                                            posicion=Number(producto.orden_pos_tactil || 0); if (posicion>= 1 &&
                                            posicion <= totalSlotsTactiles &&
                                                !productosRapidosPorPosicion.has(posicion)) {
                                                productosRapidosPorPosicion.set(posicion, producto); } }); const
                                                slotsTactiles=Array.from({ length: totalSlotsTactiles }, function (_,
                                                indice) { const posicion=indice + 1; return { posicion, producto:
                                                productosRapidosPorPosicion.get(posicion) || null, }; }); const
                                                totalAccesosTactilesActivos=slotsTactiles.filter(function (slot) {
                                                return Boolean(slot.producto); }).length; %>

                                                <header class="ventas-quick-head">
                                                    <div>
                                                        <span class="ventas-kicker">Venta rápida</span>
                                                        <h3>Accesos rápidos</h3>
                                                        <p>En modo venta toca una card para agregar al carrito. En modo
                                                            configuración puedes cambiar, quitar o mover accesos.</p>
                                                    </div>

                                                    <div class="ventas-quick-head-actions">
                                                        <strong class="ventas-quick-count" id="conteoCatalogoTactil">
                                                            <%= totalAccesosTactilesActivos %> activos
                                                        </strong>

                                                        <button type="button" class="ventas-quick-config-toggle"
                                                            id="btnModoConfigAccesosRapidos" aria-pressed="false">
                                                            Configurar
                                                        </button>
                                                    </div>
                                                </header>

                                                <div class="ventas-quick-grid" id="gridCatalogoTactil">
                                                    <% slotsTactiles.forEach(function (slot) { %>
                                                        <% const producto=slot.producto; %>

                                                            <% if (producto) { %>
                                                                <% const
                                                                    stockDisponible=Number(producto.stock_disponible ||
                                                                    0); const
                                                                    controlaInventario=Number(producto.controla_inventario
                                                                    || 0)===1; const
                                                                    permiteDecimal=Number(producto.permite_cantidad_decimal
                                                                    || 0)===1; const
                                                                    manejaIva=Number(producto.maneja_iva || 0)===1;
                                                                    const
                                                                    puedeVenderProducto=Boolean(producto.puede_vender);
                                                                    const unidad=producto.unidad_abreviatura || 'und' ;
                                                                    const categoria=producto.categoria_nombre
                                                                    || 'Sin categoría' ; const
                                                                    nombreProducto=String(producto.nombre || 'Producto'
                                                                    ).trim(); const partesNombre=nombreProducto.split(' ');
                    const inicialUno = partesNombre[0] ? partesNombre[0].charAt(0).toUpperCase() : ' P'; const
                                                                    inicialDos=partesNombre[1] ?
                                                                    partesNombre[1].charAt(0).toUpperCase() : '' ; const
                                                                    iniciales=inicialUno + inicialDos; const
                                                                    estadoStock=controlaInventario && stockDisponible
                                                                    <=0 ? 'Sin stock' : 'Disponible' ; %>

                                                                    <article
                                                                        class="ventas-quick-card <%= puedeVenderProducto ? '' : 'is-disabled' %>"
                                                                        data-touch-product-card
                                                                        data-slot-position="<%= slot.posicion %>"
                                                                        data-touch-category="<%= categoria %>"
                                                                        data-product-id="<%= producto.id_producto %>"
                                                                        data-product-name="<%= producto.nombre %>"
                                                                        data-product-price="<%= Number(producto.precio_venta || 0) %>"
                                                                        data-product-stock="<%= stockDisponible %>"
                                                                        data-product-controls-stock="<%= controlaInventario ? 1 : 0 %>"
                                                                        data-product-decimal="<%= permiteDecimal ? 1 : 0 %>"
                                                                        data-product-unit="<%= unidad %>"
                                                                        data-product-tax="<%= Number(producto.porcentaje_iva || 0) %>"
                                                                        data-product-has-tax="<%= manejaIva ? 1 : 0 %>"
                                                                        data-product-price-includes-tax="<%= Number(producto.precio_incluye_iva || 0) %>"
                                                                        data-product-can-sell="<%= puedeVenderProducto ? 1 : 0 %>"
                                                                        data-product-image="<%= producto.imagen_url || '' %>"
                                                                        aria-disabled="<%= puedeVenderProducto && puedeVender ? 'false' : 'true' %>">

                                                                        <span class="ventas-quick-slot-badge">#<%=
                                                                                slot.posicion %></span>

                                                                        <span class="ventas-quick-image">
                                                                            <% if (producto.imagen_url) { %>
                                                                                <img src="<%= producto.imagen_url %>"
                                                                                    alt="<%= producto.nombre %>"
                                                                                    loading="lazy">
                                                                                <% } else { %>
                                                                                    <span>
                                                                                        <%= iniciales %>
                                                                                    </span>
                                                                                    <% } %>
                                                                        </span>

                                                                        <span class="ventas-quick-info">
                                                                            <strong>
                                                                                <%= producto.nombre %>
                                                                            </strong>
                                                                            <small>
                                                                                <%= estadoStock %>
                                                                            </small>
                                                                        </span>

                                                                        <span class="ventas-quick-price">
                                                                            $ <%= Number(producto.precio_venta ||
                                                                                0).toLocaleString('es-CO') %>
                                                                        </span>

                                                                        <span class="ventas-quick-config-actions"
                                                                            data-touch-config-actions>
                                                                            <button type="button"
                                                                                data-touch-config-action="mover-izquierda"
                                                                                data-slot-position="<%= slot.posicion %>"
                                                                                <%=slot.posicion <=1 ? 'disabled' : ''
                                                                                %>>←</button>

                                                                            <button type="button"
                                                                                data-touch-config-action="editar"
                                                                                data-slot-position="<%= slot.posicion %>">Cambiar</button>

                                                                            <button type="button"
                                                                                data-touch-config-action="quitar"
                                                                                data-slot-position="<%= slot.posicion %>">Quitar</button>

                                                                            <button type="button"
                                                                                data-touch-config-action="mover-derecha"
                                                                                data-slot-position="<%= slot.posicion %>"
                                                                                <%=slot.posicion>= totalSlotsTactiles ?
                                                                                'disabled' : '' %>>→</button>
                                                                        </span>
                                                                    </article>
                                                                    <% } else { %>
                                                                        <button type="button"
                                                                            class="ventas-quick-card ventas-quick-card-empty"
                                                                            data-touch-empty-slot
                                                                            data-slot-position="<%= slot.posicion %>">

                                                                            <span class="ventas-quick-slot-badge">#<%=
                                                                                    slot.posicion %></span>

                                                                            <span class="ventas-quick-image">
                                                                                <span>+</span>
                                                                            </span>

                                                                            <span class="ventas-quick-info">
                                                                                <strong>Espacio disponible</strong>
                                                                                <small>Producto rápido</small>
                                                                            </span>

                                                                            <span class="ventas-quick-price">
                                                                                Configurar
                                                                            </span>
                                                                        </button>
                                                                        <% } %>
                                                                            <% }) %>
                                                </div>
                                    </section>

                                    <section class="ventas-sale-card">
                                        <header class="ventas-sale-header">
                                            <div>
                                                <span class="ventas-kicker">Factura</span>
                                                <h3>Detalle de venta</h3>
                                            </div>

                                            <span class="ventas-ticket-state" data-factura-sugerida>
                                                <%= nomenclaturaFacturaPOS %>
                                            </span>
                                        </header>

                                        <div class="ventas-invoice-table-wrap">
                                            <table class="ventas-invoice-table">
                                                <thead>
                                                    <tr>
                                                        <th class="text-center ventas-col-item">#</th>
                                                        <th>Producto</th>
                                                        <th class="text-center">Cantidad</th>
                                                        <th class="text-right">Precio</th>
                                                        <th class="text-right">IVA</th>
                                                        <th class="text-right">Total</th>
                                                        <th class="text-center">Acción</th>
                                                    </tr>
                                                </thead>

                                                <tbody id="ventasCarritoItems">
                                                    <tr class="ventas-cart-empty-row">
                                                        <td colspan="7">
                                                            <div class="ventas-cart-empty">
                                                                <strong>Carrito vacío</strong>
                                                                <span>Busca un producto y agrégalo con el botón
                                                                    +.</span>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>

                                        <section class="ventas-sale-footer">
                                            <div class="ventas-payment-strip">
                                                <div class="ventas-payment-strip-header">
                                                    <div>
                                                        <span class="ventas-kicker">Pago</span>
                                                        <h4>Pasarela rápida</h4>
                                                    </div>

                                                    <small class="ventas-payment-note">
                                                        Cambio automático al ingresar el valor recibido.
                                                    </small>
                                                </div>

                                                <div class="ventas-payment-list" id="listaPagosVenta">
                                                    <div class="ventas-payment-fields ventas-payment-row"
                                                        data-payment-row>
                                                        <label class="ventas-field">
                                                            <span>Medio de pago</span>

                                                            <select id="medioPagoPrincipal" name="medio_pago_principal"
                                                                class="ventas-pago-medio" data-pago-medio>
                                                                <% if (mediosPagoListado.length===0) { %>
                                                                    <option value="">Sin medios activos</option>
                                                                    <% } else { %>
                                                                        <% mediosPagoListado.forEach((medio)=> { %>
                                                                            <option value="<%= medio.id_medio_pago %>"
                                                                                data-payment-type="<%= medio.tipo %>"
                                                                                data-affects-cash="<%= medio.afecta_efectivo_caja %>"
                                                                                data-requires-reference="<%= medio.requiere_referencia || 0 %>">
                                                                                <%= medio.nombre %> · <%=
                                                                                        nombreTipoMedio(medio.tipo) %>
                                                                            </option>
                                                                            <% }) %>
                                                                                <% } %>
                                                            </select>
                                                        </label>

                                                        <label class="ventas-field">
                                                            <span>Recibido</span>
                                                            <input type="number" id="montoPagadoPrincipal"
                                                                class="ventas-pago-monto" data-pago-monto min="0"
                                                                step="1" placeholder="0" disabled>
                                                        </label>

                                                        <label class="ventas-field">
                                                            <span>Referencia</span>
                                                            <input type="text" id="referenciaPagoPrincipal"
                                                                class="ventas-pago-referencia" data-pago-referencia
                                                                placeholder="Opcional" disabled>
                                                        </label>

                                                        <button type="button" class="ventas-payment-remove"
                                                            data-remove-payment hidden aria-label="Quitar pago">
                                                            ×
                                                        </button>
                                                    </div>
                                                </div>

                                                <div class="ventas-payment-tools">
                                                    <button type="button" class="btn-secondary ventas-payment-add"
                                                        id="btnAgregarPagoMixto" disabled>
                                                        + Agregar pago mixto
                                                    </button>

                                                    <small id="resumenPagosMixtos">
                                                        Un solo pago
                                                    </small>
                                                </div>

                                                <div class="ventas-payment-info">
                                                    <div class="ventas-payment-info-card">
                                                        <span>Cliente actual</span>
                                                        <strong id="infoPagoCliente">
                                                            <%= clienteActual.nombre || 'Consumidor final' %>
                                                        </strong>
                                                        <small>Cliente por defecto</small>
                                                    </div>

                                                    <div class="ventas-payment-info-card">
                                                        <span>Medio seleccionado</span>
                                                        <strong id="infoPagoMedio">
                                                            <%= mediosPagoListado.length ? (mediosPagoListado[0].nombre
                                                                + ' · ' + nombreTipoMedio(mediosPagoListado[0].tipo))
                                                                : 'Sin medio activo' %>
                                                        </strong>
                                                        <small>Pago principal</small>
                                                    </div>

                                                    <div class="ventas-payment-info-card">
                                                        <span>Líneas en carrito</span>
                                                        <strong id="infoPagoItems">0</strong>
                                                        <small>Productos agregados</small>
                                                    </div>

                                                    <div class="ventas-payment-info-card">
                                                        <span>Factura sugerida</span>
                                                        <strong data-factura-sugerida>
                                                            <%= nomenclaturaFacturaPOS %>
                                                        </strong>
                                                        <small>Se confirma al guardar</small>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="ventas-totals-panel">
                                                <div class="ventas-total-row">
                                                    <span>Subtotal</span>
                                                    <strong id="resumenSubtotal">$ 0</strong>
                                                </div>

                                                <div class="ventas-total-row">
                                                    <span>IVA</span>
                                                    <strong id="resumenIva">$ 0</strong>
                                                </div>

                                                <div class="ventas-total-row">
                                                    <span>Recibido</span>
                                                    <strong id="resumenPagado">$ 0</strong>
                                                </div>

                                                <div class="ventas-total-row">
                                                    <span>Saldo</span>
                                                    <strong id="resumenSaldo">$ 0</strong>
                                                </div>

                                                <div class="ventas-total-row">
                                                    <span>Cambio</span>
                                                    <strong id="resumenCambio">$ 0</strong>
                                                </div>

                                                <div class="ventas-total-row is-total">
                                                    <span>Total</span>
                                                    <strong id="resumenTotal">$ 0</strong>
                                                </div>
                                            </div>

                                            <div class="ventas-hidden-metrics" hidden>
                                                <span id="resumenCantidadItems">0</span>
                                                <span id="resumenDescuento">$ 0</span>
                                            </div>
                                        </section>
                                    </section>
        </div>

        <div class="ventas-modal-backdrop" id="modalAccesoRapidoTactil" hidden>
            <section class="ventas-modal ventas-quick-config-modal" role="dialog" aria-modal="true">
                <header class="ventas-modal-header">
                    <div>
                        <span class="ventas-kicker">POS táctil</span>
                        <h3>Configurar acceso rápido</h3>
                        <p>Selecciona un producto existente para ocupar este espacio.</p>
                    </div>

                    <button type="button" class="ventas-modal-close" id="btnCerrarAccesoRapidoTactil">
                        ×
                    </button>
                </header>

                <form id="formAccesoRapidoTactil" class="ventas-quick-config-form"
                    data-config-url="/ventas/pos-tactil/acceso-rapido"
                    data-remove-url="/ventas/pos-tactil/acceso-rapido/quitar"
                    data-move-url="/ventas/pos-tactil/acceso-rapido/mover">
                    <input type="hidden" id="slotAccesoRapidoTactil" name="posicion">
                    <input type="hidden" id="productoAccesoRapidoTactil" name="id_producto">
                    <input type="hidden" id="productoActualAccesoRapidoTactil" name="id_producto_actual">

                    <label class="ventas-field">
                        <span>Buscar producto</span>
                        <input type="search" id="buscarProductoAccesoRapido" placeholder="Nombre, código o SKU..."
                            autocomplete="off" data-search-url="/ventas/productos/buscar">
                    </label>

                    <div class="ventas-quick-config-selected" id="productoAccesoRapidoSeleccionado" hidden>
                        Producto seleccionado
                    </div>

                    <div class="ventas-quick-config-results" id="resultadosAccesoRapidoTactil">
                        <div class="ventas-quick-config-empty">
                            Escribe para buscar un producto.
                        </div>
                    </div>

                    <footer class="ventas-modal-actions ventas-modal-actions-split">
                        <button type="button" class="btn-danger-soft" id="btnQuitarAccesoRapidoTactil" hidden>
                            Quitar acceso
                        </button>

                        <span class="ventas-modal-actions-group">
                            <button type="button" class="btn-secondary" id="btnCancelarAccesoRapidoTactil">
                                Cancelar
                            </button>

                            <button type="submit" class="btn-primary" id="btnGuardarAccesoRapidoTactil" disabled>
                                Guardar acceso
                            </button>
                        </span>
                    </footer>
                </form>
            </section>
        </div>

        <div class="ventas-modal-backdrop" id="modalClienteRapido" hidden>
            <section class="ventas-modal-card" role="dialog" aria-modal="true" aria-labelledby="tituloClienteRapido">
                <header class="ventas-modal-header">
                    <div>
                        <span class="ventas-kicker">Cliente rápido</span>
                        <h3 id="tituloClienteRapido">Nuevo cliente</h3>
                        <p>Crea un cliente básico sin salir de la venta.</p>
                    </div>

                    <button type="button" class="ventas-modal-close" id="btnCerrarClienteRapido" aria-label="Cerrar">
                        ×
                    </button>
                </header>

                <form class="ventas-client-quick-form" id="formClienteRapido" data-url="/clientes/rapido" novalidate>
                    <div class="ventas-client-quick-alert" id="avisoClienteRapido" hidden></div>

                    <div class="ventas-client-quick-grid">
                        <label class="ventas-field">
                            <span>Tipo documento *</span>
                            <select name="tipo_documento" id="clienteRapidoTipoDocumento">
                                <option value="CC">Cédula de ciudadanía</option>
                                <option value="NIT">NIT</option>
                                <option value="CE">Cédula de extranjería</option>
                                <option value="PP">Pasaporte</option>
                            </select>
                        </label>

                        <label class="ventas-field">
                            <span>Documento *</span>
                            <input type="text" name="documento" id="clienteRapidoDocumento" autocomplete="off">
                        </label>

                        <label class="ventas-field" id="campoClienteRapidoDv" hidden>
                            <span>DV *</span>
                            <input type="text" name="digito_verificacion" id="clienteRapidoDv" maxlength="1"
                                inputmode="numeric" autocomplete="off">
                        </label>

                        <label class="ventas-field ventas-client-quick-wide">
                            <span>Nombre / razón social *</span>
                            <input type="text" name="nombre" id="clienteRapidoNombre" autocomplete="off"
                                placeholder="Ej: Carlos Ramírez / Empresa SAS">
                        </label>

                        <label class="ventas-field">
                            <span>Celular</span>
                            <input type="text" name="celular" id="clienteRapidoCelular" autocomplete="off"
                                inputmode="tel">
                        </label>

                        <label class="ventas-field">
                            <span>Correo</span>
                            <input type="email" name="correo" id="clienteRapidoCorreo" autocomplete="off">
                        </label>
                    </div>

                    <label class="ventas-client-quick-check">
                        <input type="checkbox" id="clienteRapidoAutoriza" checked>
                        <span>Autoriza tratamiento de datos.</span>
                    </label>

                    <footer class="ventas-modal-actions">
                        <button type="button" class="btn-secondary" id="btnCancelarClienteRapido">
                            Cancelar
                        </button>

                        <button type="submit" class="btn-primary" id="btnGuardarClienteRapido">
                            Crear y seleccionar
                        </button>
                    </footer>
                </form>
            </section>
        </div>

        <script src="/js/ventas.js"></script>
</section>