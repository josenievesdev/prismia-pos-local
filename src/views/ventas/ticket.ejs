<% const data=ticket || {}; const comercio=data.comercio || {}; const venta=data.venta || {}; const
    detalle=Array.isArray(data.detalle) ? data.detalle : []; const pagos=Array.isArray(data.pagos) ? data.pagos : [];
    const comprobante=data.comprobante || {}; function pesos(valor) { const numero=Number(valor || 0); return '$ ' +
    Math.round(numero).toLocaleString('es-CO'); } function cantidadFormateada(valor) { const numero=Number(valor || 0);
    if (!Number.isFinite(numero)) { return '0' ; } return numero.toLocaleString('es-CO', { minimumFractionDigits:
    Number.isInteger(numero) ? 0 : 2, maximumFractionDigits: 3, }); } function fecha(valor) { if (!valor) return '' ;
    return String(valor).replace('T', ' ' ).slice(0, 19); } function texto(valor, defecto='' ) { if (valor===null ||
    valor===undefined) { return defecto; } const limpio=String(valor).trim(); return limpio || defecto; } function
    mayuscula(valor, defecto='' ) { return texto(valor, defecto).toUpperCase(); } function obtenerCantidadItem(item) {
    return ( item.cantidad ?? item.cantidad_vendida ?? item.cantidad_detalle ?? item.unidades ?? 0 ); } function
    obtenerUnidadItem(item) { return texto( item.unidad_abreviatura || item.unidad_medida_abreviatura ||
    item.unidad_nombre, 'und' ); } function obtenerDescuentoUnitarioItem(item) { return Number(item.descuento_unitario
    || 0); } function obtenerDescuentoLineaItem(item) { return obtenerDescuentoUnitarioItem(item) *
    Number(obtenerCantidadItem(item) || 0); } const numeroComprobante=texto(comprobante.numero,
    texto(venta.numero_venta, 'FV-SIN-NUMERO' )); const estadoVenta=mayuscula(venta.estado, 'pagada' ); const
    nombreComercio=texto(comercio.nombre_comercio, 'Comercio sin nombre' ); const
    tipoDocumentoComercio=texto(comercio.tipo_documento, 'NIT' ); const documentoComercio=texto(comercio.nit, '' );
    const nombreCliente=texto(venta.cliente_nombre, 'Consumidor final' ); const
    documentoCliente=texto(venta.cliente_documento, '0000000000' ); const
    tipoDocumentoCliente=texto(venta.cliente_tipo_documento, 'CF' ); const cajero=texto(venta.cajero_nombre, 'Usuario'
    ); const mensajeTicket=texto(comercio.mensaje_ticket, 'Gracias por su compra.' ); %>

    <!DOCTYPE html>
    <html lang="es">

    <head>
        <meta charset="UTF-8">
        <title>Ticket <%= numeroComprobante %>
        </title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/css/modules/ventas-ticket.css">
    </head>

    <body>
        <main class="ticket-page">
            <section class="ticket-paper">
                <header class="ticket-header">
                    <h1>
                        <%= mayuscula(nombreComercio) %>
                    </h1>

                    <% if (documentoComercio) { %>
                        <p>
                            <%= tipoDocumentoComercio %>: <%= documentoComercio %>
                        </p>
                        <% } %>

                            <% if (comercio.direccion) { %>
                                <p>
                                    <%= comercio.direccion %>
                                </p>
                                <% } %>

                                    <% if (comercio.telefono) { %>
                                        <p>
                                            <%= comercio.telefono %>
                                        </p>
                                        <% } %>

                                            <% if (comercio.correo) { %>
                                                <p>
                                                    <%= comercio.correo %>
                                                </p>
                                                <% } %>
                </header>

                <section class="ticket-block ticket-center ticket-document">
                    <strong class="ticket-title">COMPROBANTE DE VENTA</strong>

                    <div class="ticket-document-number">
                        <span>Factura No.</span>
                        <strong>
                            <%= numeroComprobante %>
                        </strong>
                    </div>

                    <div class="ticket-document-state">
                        Estado: <strong>
                            <%= estadoVenta %>
                        </strong>
                    </div>
                </section>

                <section class="ticket-block">
                    <div class="ticket-row">
                        <span>Fecha</span>
                        <strong>
                            <%= fecha(venta.fecha_venta) %>
                        </strong>
                    </div>

                    <div class="ticket-row">
                        <span>Cajero</span>
                        <strong>
                            <%= cajero %>
                        </strong>
                    </div>

                    <div class="ticket-row">
                        <span>Turno</span>
                        <strong>#<%= texto(venta.id_turno_caja, '-' ) %></strong>
                    </div>
                </section>

                <section class="ticket-block">
                    <h2>Cliente</h2>

                    <div class="ticket-row">
                        <span>Nombre</span>
                        <strong>
                            <%= nombreCliente %>
                        </strong>
                    </div>

                    <div class="ticket-row">
                        <span>Documento</span>
                        <strong>
                            <%= tipoDocumentoCliente %>
                                <%= documentoCliente %>
                        </strong>
                    </div>
                </section>

                <section class="ticket-block">
                    <h2>Productos</h2>

                    <table class="ticket-table">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th class="right">Cant.</th>
                                <th class="right">Vlr. Unit.</th>
                                <th class="right">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% detalle.forEach((item)=> { %>
                                <tr>
                                    <td>
                                        <strong>
                                            <%= texto(item.nombre_producto, 'Producto' ) %>
                                        </strong>

                                        <% if (item.codigo_interno || item.codigo_barras) { %>
                                            <small>
                                                <%= [item.codigo_interno, item.codigo_barras].filter(Boolean).join(' · ') %>
                                        </small>
                                    <% } %>

                                    <small>
                                        <%= obtenerUnidadItem(item) %>
                                        <% if (Number(item.porcentaje_iva || 0) > 0) { %>
                                            · IVA <%= item.porcentaje_iva %>%
                                        <% } else { %>
                                            · Sin IVA
                                        <% } %>
                                    </small>

                                    <% const descuentoLineaItem = obtenerDescuentoLineaItem(item); %>

                                        <% if (descuentoLineaItem > 0) { %>
                                            <small class="ticket-item-discount">
                                                Desc. unit. <%= pesos(item.descuento_unitario) %> · Desc. línea <%= pesos(descuentoLineaItem) %>
                                            </small>
                                            <% } %>
                                </td>

                                <td class="right">
                                    <%= cantidadFormateada(obtenerCantidadItem(item)) %>
                                </td>

                                <td class="right">
                                    <%= pesos(item.precio_unitario) %>
                                </td>

                                <td class="right">
                                    <%= pesos(item.total_linea) %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </section>

            <section class="ticket-block ticket-totals">
                <div class="ticket-row">
                    <span>Subtotal</span>
                    <strong><%= pesos(venta.subtotal) %></strong>
                </div>

                <% if (Number(venta.descuento_total || 0) > 0) { %>
                    <div class="ticket-row">
                        <span>Descuento</span>
                        <strong><%= pesos(venta.descuento_total) %></strong>
                    </div>
                <% } %>

                <div class="ticket-row">
                    <span>IVA</span>
                    <strong><%= pesos(venta.impuesto_total) %></strong>
                </div>

                <div class="ticket-row ticket-total-main">
                    <span>Total</span>
                    <strong><%= pesos(venta.total) %></strong>
                </div>
            </section>

            <section class="ticket-block">
                <h2>Pago</h2>

                <% pagos.forEach((pago) => { %>
                    <div class="ticket-row">
                        <span>Medio</span>
                        <strong><%= texto(pago.medio_pago_nombre, pago.entidad || pago.metodo_pago) %></strong>
                    </div>

                    <div class="ticket-row">
                        <span>Tipo</span>
                        <strong><%= texto(pago.metodo_pago, ' efectivo') %></strong>
                                                    </div>

                                                    <% if (pago.referencia) { %>
                                                        <div class="ticket-row">
                                                            <span>Referencia</span>
                                                            <strong>
                                                                <%= pago.referencia %>
                                                            </strong>
                                                        </div>
                                                        <% } %>

                                                            <div class="ticket-row">
                                                                <span>Pagado</span>
                                                                <strong>
                                                                    <%= pesos(pago.monto) %>
                                                                </strong>
                                                            </div>

                                                            <div class="ticket-row">
                                                                <span>Recibido</span>
                                                                <strong>
                                                                    <%= pesos(pago.monto_recibido) %>
                                                                </strong>
                                                            </div>

                                                            <div class="ticket-row">
                                                                <span>Cambio</span>
                                                                <strong>
                                                                    <%= pesos(pago.cambio_entregado) %>
                                                                </strong>
                                                            </div>
                                                            <% }) %>
                </section>

                <footer class="ticket-footer">
                    <p>
                        <%= mensajeTicket %>
                    </p>
                    <p>Generado por <strong>
                            <%= comercio.software || 'Prismia POS Local' %>
                        </strong></p>
                </footer>
            </section>

            <div class="ticket-actions">
                <button type="button" onclick="window.print()">Imprimir</button>
                <button type="button" onclick="window.close()">Cerrar</button>
            </div>
        </main>
        <script>
            window.addEventListener('load', () => {
                setTimeout(() => {
                    window.scrollTo(0, 0);
                }, 50);
            });
        </script>
    </body>

    </html>