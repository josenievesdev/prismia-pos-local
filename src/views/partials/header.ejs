<header class="app-header">
    <div class="app-header-start">
        <button type="button" class="shell-toggle" data-shell-toggle aria-controls="appSidebar"
            aria-label="Mostrar u ocultar el menú" title="Menú">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" aria-hidden="true">
                <line x1="4" y1="6" x2="20" y2="6" />
                <line x1="4" y1="12" x2="20" y2="12" />
                <line x1="4" y1="18" x2="20" y2="18" />
            </svg>
        </button>

        <% if (locals.navegacion) { %>
            <a href="<%= navegacion.ruta %>" class="header-volver" data-volver
                title="Volver a <%= navegacion.etiqueta %> (Alt + ←)" aria-label="Volver a <%= navegacion.etiqueta %>">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"
                    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
                <span><%= navegacion.etiqueta %></span>
            </a>
        <% } %>

        <div class="app-header-title">
            <p class="header-kicker">Panel administrativo</p>
            <h1>
                <%= titulo || 'Panel' %>
            </h1>
        </div>
    </div>

    <% if (locals.herramientasEncabezado) { %>
        <%# Herramientas propias de una pantalla (p. ej. el POS). El título y el
            bloque del usuario no se mueven: las herramientas van entre ambos. %>
        <div class="app-header-tools">
            <%- include('../' + locals.herramientasEncabezado) %>
        </div>
    <% } %>

    <div class="header-user">
        <% if (usuario) { %>
            <div class="user-pill">
                <div class="user-avatar" aria-hidden="true">
                    <%= usuario.nombre ? usuario.nombre.charAt(0).toUpperCase() : 'U' %>
                </div>

                <div class="user-pill-copy">
                    <strong>
                        <%= usuario.nombre %>
                    </strong>
                    <small>
                        <%= usuario.rol_principal || 'sin rol' %>
                    </small>
                </div>
            </div>
        <% } %>

        <form method="POST" action="/auth/logout">
            <button type="submit" class="btn-secondary btn-small">
                Salir
            </button>
        </form>
    </div>
</header>
