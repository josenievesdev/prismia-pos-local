<%# Componente KPI. Parámetros: etiqueta, valor, detalle (opcional), tono: exito|peligro|aviso|destacado (opcional),
    tonoDetalle: exito|peligro (opcional, colorea solo el detalle; p. ej. una variación) %>
<article class="ui-kpi<%= locals.tono ? ' ui-kpi--' + locals.tono : '' %>">
    <span class="ui-kpi-etiqueta"><%= locals.etiqueta %></span>
    <strong class="ui-kpi-valor"><%= locals.valor %></strong>
    <% if (locals.detalle) { %><small class="ui-kpi-detalle<%= locals.tonoDetalle ? ' ui-texto-' + locals.tonoDetalle : '' %>"><%= locals.detalle %></small><% } %>
</article>
