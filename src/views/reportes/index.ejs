<%
    const pagosMedio = Array.isArray(resumenPagosPorMedio) ? resumenPagosPorMedio : [];
    const ivaListado = Array.isArray(ivaPorTarifa) ? ivaPorTarifa : [];
    const productosListado = Array.isArray(productosMasVendidos) ? productosMasVendidos : [];
    const ventasListado = Array.isArray(ventasRecientes) ? ventasRecientes : [];
%>
<section class="ui-pagina">
    <form class="ui-filtros" method="GET" action="/reportes">
        <label class="ui-campo">
            <span>Desde</span>
            <input type="date" name="fecha_desde" value="<%= filtros.fecha_desde || '' %>">
        </label>

        <label class="ui-campo">
            <span>Hasta</span>
            <input type="date" name="fecha_hasta" value="<%= filtros.fecha_hasta || '' %>">
        </label>

        <div class="ui-acciones">
            <a href="/reportes" class="btn-secondary">Mes actual</a>
            <button type="submit" class="btn-secondary">Filtrar</button>
        </div>
    </form>

    <section class="ui-kpis">
        <%- include('../partials/ui/kpi', { etiqueta: 'Total bruto', valor: formatearPesos(resumenVentas.total_bruto), detalle: resumenVentas.total_facturas + ' factura(s)' }) %>
        <%- include('../partials/ui/kpi', { etiqueta: 'Total neto', valor: formatearPesos(resumenVentas.total_neto), detalle: resumenVentas.facturas_pagadas + ' pagada(s)', tono: 'exito' }) %>
        <%- include('../partials/ui/kpi', { etiqueta: 'Total anulado', valor: formatearPesos(resumenVentas.total_anulado), detalle: resumenVentas.facturas_anuladas + ' anulada(s)', tono: 'peligro' }) %>
        <%- include('../partials/ui/kpi', { etiqueta: 'Utilidad bruta neta', valor: formatearPesos(resumenVentas.utilidad_bruta_neta), detalle: 'Margen: ' + resumenVentas.margen_bruto_porcentaje + '%' }) %>
    </section>

    <div class="ui-grilla">
        <article class="ui-tarjeta">
            <header class="ui-tarjeta-encabezado">
                <div>
                    <h3>IVA del periodo</h3>
                </div>
            </header>

            <div class="ui-tarjeta-cuerpo">
                <div class="ui-metricas">
                    <div class="ui-metrica"><span>IVA bruto</span><strong><%= formatearPesos(resumenVentas.iva_bruto) %></strong></div>
                    <div class="ui-metrica"><span>IVA anulado</span><strong><%= formatearPesos(resumenVentas.iva_anulado) %></strong></div>
                    <div class="ui-metrica"><span>IVA neto</span><strong><%= formatearPesos(resumenVentas.iva_neto) %></strong></div>
                </div>
            </div>

            <% if (!ivaListado.length) { %>
                <%- include('../partials/ui/vacio', { mensaje: 'No hay ventas con IVA en este periodo.' }) %>
            <% } else { %>
                <div class="ui-tabla-contenedor">
                    <table class="ui-tabla">
                        <thead>
                            <tr>
                                <th>Tarifa</th>
                                <th class="num">IVA bruto</th>
                                <th class="num">IVA anulado</th>
                                <th class="num">IVA neto</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% ivaListado.forEach(function (item) { %>
                                <tr>
                                    <td><strong><%= item.porcentaje_iva %>%</strong></td>
                                    <td class="num"><%= formatearPesos(item.iva_bruto) %></td>
                                    <td class="num ui-texto-peligro"><%= formatearPesos(item.iva_anulado) %></td>
                                    <td class="num ui-texto-exito"><%= formatearPesos(item.iva_neto) %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </article>

        <article class="ui-tarjeta">
            <header class="ui-tarjeta-encabezado">
                <div>
                    <h3>Soportes internos</h3>
                </div>
            </header>

            <div class="ui-tarjeta-cuerpo">
                <div class="ui-metricas">
                    <div class="ui-metrica"><span>Cantidad</span><strong><%= resumenNotasCredito.total_notas_credito %></strong></div>
                    <div class="ui-metrica"><span>Total</span><strong><%= formatearPesos(resumenNotasCredito.total_notas_credito_valor) %></strong></div>
                    <div class="ui-metrica"><span>IVA</span><strong><%= formatearPesos(resumenNotasCredito.iva_notas_credito) %></strong></div>
                </div>

                <div class="ui-nota">
                    Las notas crédito de esta fase son internas. No representan validación electrónica DIAN.
                </div>
            </div>
        </article>
    </div>

    <article class="ui-tarjeta">
        <header class="ui-tarjeta-encabezado">
            <div>
                <h3>Ingresos, anulaciones y neto</h3>
            </div>
        </header>

        <% if (!pagosMedio.length) { %>
            <%- include('../partials/ui/vacio', { titulo: 'Sin pagos', mensaje: 'No hay pagos registrados en el rango seleccionado.' }) %>
        <% } else { %>
            <div class="ui-tabla-contenedor">
                <table class="ui-tabla">
                    <thead>
                        <tr>
                            <th>Medio</th>
                            <th>Tipo</th>
                            <th class="centro">Operaciones</th>
                            <th class="num">Ingresos</th>
                            <th class="num">Anulaciones</th>
                            <th class="num">Neto</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% pagosMedio.forEach(function (medio) { %>
                            <tr>
                                <td>
                                    <strong><%= medio.medio_pago_nombre %></strong>
                                    <small><%= medio.afecta_efectivo_caja === 1 ? 'Afecta efectivo físico' : 'No afecta efectivo físico' %></small>
                                </td>
                                <td><%- include('../partials/ui/estado', { texto: medio.medio_pago_tipo, tono: 'info' }) %></td>
                                <td class="centro"><%= medio.operaciones %></td>
                                <td class="num ui-texto-exito"><%= formatearPesos(medio.ingresos) %></td>
                                <td class="num ui-texto-peligro"><%= formatearPesos(medio.anulaciones) %></td>
                                <td class="num"><strong><%= formatearPesos(medio.neto) %></strong></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </article>

    <div class="ui-grilla">
        <article class="ui-tarjeta">
            <header class="ui-tarjeta-encabezado">
                <div>
                    <h3>Más vendidos</h3>
                </div>
            </header>

            <% if (!productosListado.length) { %>
                <%- include('../partials/ui/vacio', { mensaje: 'No hay productos vendidos en este periodo.' }) %>
            <% } else { %>
                <div class="ui-tabla-contenedor" style="--ui-tabla-alto: 440px">
                    <table class="ui-tabla">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th class="num">Cantidad</th>
                                <th class="num">Total</th>
                                <th class="num">Utilidad</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% productosListado.forEach(function (producto) { %>
                                <tr>
                                    <td>
                                        <strong><%= producto.nombre_producto %></strong>
                                        <small><%= producto.codigo_interno %> · <%= producto.unidad_abreviatura %></small>
                                    </td>
                                    <td class="num"><%= producto.cantidad_vendida %></td>
                                    <td class="num"><%= formatearPesos(producto.total_neto) %></td>
                                    <td class="num"><%= formatearPesos(producto.utilidad_bruta) %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </article>

        <article class="ui-tarjeta">
            <header class="ui-tarjeta-encabezado">
                <div>
                    <h3>Últimas facturas</h3>
                </div>
                <a href="/ventas/historial" class="btn-secondary btn-small">Ver historial</a>
            </header>

            <% if (!ventasListado.length) { %>
                <%- include('../partials/ui/vacio', { mensaje: 'No hay facturas en el periodo seleccionado.' }) %>
            <% } else { %>
                <div class="ui-tabla-contenedor" style="--ui-tabla-alto: 440px">
                    <table class="ui-tabla">
                        <thead>
                            <tr>
                                <th>Factura</th>
                                <th>Cliente</th>
                                <th>Estado</th>
                                <th class="num">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% ventasListado.forEach(function (venta) { %>
                                <tr>
                                    <td>
                                        <a href="/ventas/<%= venta.id_venta %>"><strong><%= venta.numero_venta %></strong></a>
                                        <small><%= venta.fecha_venta %></small>
                                    </td>
                                    <td>
                                        <strong><%= venta.cliente_nombre %></strong>
                                        <small><%= venta.medios_pago %></small>
                                    </td>
                                    <td><%- include('../partials/ui/estado', { texto: venta.estado, tono: venta.estado === 'anulada' ? 'peligro' : 'exito' }) %></td>
                                    <td class="num"><%= formatearPesos(venta.total) %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </article>
    </div>
</section>
