<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= titulo %> | <%= empresa.software.nombre %></title>

    <link rel="preload" href="/fonts/ibm-plex-sans-400.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/ibm-plex-sans-600.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/ibm-plex-mono-600.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/css/fuentes.css">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/sistema.css">
    <link rel="stylesheet" href="/css/modules/login.css">
</head>

<body class="acceso">
    <main class="acceso-pantalla">
        <!-- Marca: mismo lenguaje del punto de venta (ticket térmico, cifras en Mono) -->
        <section class="acceso-marca" aria-label="<%= empresa.software.nombre %>">
            <div class="acceso-marca-logo">
                <span class="acceso-logo" aria-hidden="true"><span></span><span></span><span></span></span>
                <span class="acceso-marca-nombre">
                    <strong><%= empresa.software.nombreCorto %></strong>
                    <small><%= empresa.producto.tipo %></small>
                </span>
            </div>

            <div class="acceso-marca-centro">
            <h1 class="acceso-lema">Factura en segundos.<br>Cuadra la caja sin sorpresas.</h1>

            <div class="acceso-ticket" aria-hidden="true">
                <div class="acceso-ticket-cabecera">
                    <strong>FV-000128</strong>
                    <span>24/11/2026 · 10:42</span>
                </div>
                <div class="acceso-ticket-linea">
                    <span class="acceso-ticket-nombre">Cable #12 THHN rojo</span>
                    <span class="acceso-ticket-cuenta"><span>25 m × $ 3.900</span><b>$ 97.500</b></span>
                </div>
                <div class="acceso-ticket-linea">
                    <span class="acceso-ticket-nombre">Tornillo drywall 6 × 1"</span>
                    <span class="acceso-ticket-cuenta"><span>100 und × $ 45</span><b>$ 4.500</b></span>
                </div>
                <div class="acceso-ticket-linea">
                    <span class="acceso-ticket-nombre">Café molido 500 g</span>
                    <span class="acceso-ticket-cuenta"><span>2 und × $ 18.900</span><b>$ 37.800</b></span>
                </div>
                <div class="acceso-ticket-total"><span>Total</span><b>$ 139.800</b></div>
                <div class="acceso-ticket-pago"><span>Efectivo</span><span>$ 150.000</span></div>
                <div class="acceso-ticket-cambio"><span>Cambio</span><b>$ 10.200</b></div>
            </div>
            </div>

            <p class="acceso-marca-pie">
                Versión <%= empresa.software.version %> · <%= empresa.software.desarrollador %>
            </p>
        </section>

        <!-- Formulario: sobre el mismo papel del ticket -->
        <section class="acceso-panel">
            <header class="acceso-panel-cabecera">
                <% if (locals.comercio && comercio.nombre) { %>
                    <span class="acceso-comercio">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                            stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M3.5 9.5 5 4.5h14l1.5 5" />
                            <path d="M3.5 9.5a2.8 2.8 0 0 0 5.6 0 2.8 2.8 0 0 0 5.8 0 2.8 2.8 0 0 0 5.6 0" />
                            <path d="M5 12v7.5h14V12M10 19.5v-4.5h4v4.5" />
                        </svg>
                        <span class="acceso-comercio-nombre"><%= comercio.nombre %></span>
                    </span>
                <% } else { %>
                    <span></span>
                <% } %>

                <span class="acceso-reloj" aria-hidden="true">
                    <span id="relojFecha"></span>
                    <strong id="relojHora"></strong>
                </span>
                <script>
                    // Se llena antes de pintar la página: nunca se ve vacío
                    (function () {
                        const fecha = new Intl.DateTimeFormat('es-CO', { weekday: 'long', day: 'numeric', month: 'long' });
                        const hora = new Intl.DateTimeFormat('es-CO', { hour: '2-digit', minute: '2-digit', hour12: false });

                        function pintar() {
                            const ahora = new Date();
                            const texto = fecha.format(ahora).replace(',', '');
                            document.getElementById('relojFecha').textContent = texto.charAt(0).toUpperCase() + texto.slice(1);
                            document.getElementById('relojHora').textContent = hora.format(ahora);
                        }

                        pintar();
                        setInterval(pintar, 10000);
                    })();
                </script>
            </header>

            <form class="acceso-form" method="POST" action="/auth/login" id="formAcceso" novalidate>
                <div class="acceso-form-logo" aria-hidden="true">
                    <span class="acceso-logo"><span></span><span></span><span></span></span>
                    <strong><%= empresa.software.nombre %></strong>
                </div>

                <h2>Iniciar sesión</h2>

                <% if (error) { %>
                    <div class="alert alert-error" role="alert"><%= error %></div>
                <% } %>

                <div class="acceso-campo">
                    <label for="correo">Correo</label>
                    <input type="email" id="correo" name="correo" placeholder="correo@tunegocio.com"
                        autocomplete="username" inputmode="email" spellcheck="false"
                        value="<%= valores?.correo || '' %>" required <%= valores?.correo ? '' : 'autofocus' %>>
                </div>

                <div class="acceso-campo">
                    <label for="contrasena">Contraseña</label>
                    <div class="acceso-clave">
                        <input type="password" id="contrasena" name="contrasena"
                            autocomplete="current-password" required <%= valores?.correo ? 'autofocus' : '' %>>
                        <button type="button" class="acceso-ver-clave" id="btnVerClave"
                            aria-label="Mostrar contraseña" aria-pressed="false">
                            <svg class="icono-ver" viewBox="0 0 24 24" width="18" height="18" fill="none"
                                stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                                aria-hidden="true">
                                <path d="M2.5 12s3.5-6.5 9.5-6.5 9.5 6.5 9.5 6.5-3.5 6.5-9.5 6.5S2.5 12 2.5 12Z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                            <svg class="icono-ocultar" viewBox="0 0 24 24" width="18" height="18" fill="none"
                                stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                                aria-hidden="true">
                                <path d="M3 3l18 18" />
                                <path d="M10.6 5.6A9.8 9.8 0 0 1 12 5.5c6 0 9.5 6.5 9.5 6.5a17 17 0 0 1-2.7 3.4M6.3 6.9C3.9 8.6 2.5 12 2.5 12s3.5 6.5 9.5 6.5c1.6 0 3-.4 4.2-1" />
                                <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" />
                            </svg>
                        </button>
                    </div>
                    <p class="acceso-mayusculas" id="avisoMayusculas" hidden>Mayúsculas activadas</p>
                </div>

                <button type="submit" class="btn-primary acceso-entrar" id="btnEntrar">Entrar</button>
            </form>

            <p class="acceso-pie"><%= empresa.software.nombre %> · <%= empresa.software.desarrollador %></p>
        </section>
    </main>

    <script>
        (function () {
            const form = document.getElementById('formAcceso');
            const clave = document.getElementById('contrasena');
            const ver = document.getElementById('btnVerClave');
            const mayusculas = document.getElementById('avisoMayusculas');
            const entrar = document.getElementById('btnEntrar');

            ver.addEventListener('click', function () {
                const mostrar = clave.type === 'password';
                clave.type = mostrar ? 'text' : 'password';
                ver.setAttribute('aria-pressed', String(mostrar));
                ver.setAttribute('aria-label', mostrar ? 'Ocultar contraseña' : 'Mostrar contraseña');
                clave.focus();
            });

            function revisarMayusculas(evento) {
                if (typeof evento.getModifierState === 'function') {
                    mayusculas.hidden = !evento.getModifierState('CapsLock');
                }
            }

            clave.addEventListener('keydown', revisarMayusculas);
            clave.addEventListener('keyup', revisarMayusculas);
            clave.addEventListener('blur', function () { mayusculas.hidden = true; });

            // Un solo envío: evita dos intentos (y dos fallos contados) por doble clic
            form.addEventListener('submit', function (evento) {
                if (!form.checkValidity()) {
                    evento.preventDefault();
                    const primero = form.querySelector(':invalid');
                    if (primero) primero.focus();
                    form.classList.add('is-revisado');
                    return;
                }

                if (entrar.disabled) {
                    evento.preventDefault();
                    return;
                }

                entrar.disabled = true;
                entrar.textContent = 'Entrando…';
            });

            // Al volver con "Atrás" el botón no debe quedar bloqueado
            window.addEventListener('pageshow', function () {
                entrar.disabled = false;
                entrar.textContent = 'Entrar';
            });
        })();
    </script>
</body>

</html>
