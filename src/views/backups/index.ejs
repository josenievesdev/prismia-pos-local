<section class="module-page backups-page">
    <div class="module-header module-header-actions">
        <div>
            <p class="eyebrow">Seguridad de datos</p>
            <h2>Protección de respaldos</h2>
            <p>
                Prismia crea respaldos automáticos para proteger la información del negocio.
            </p>
        </div>
    </div>

    <% if (exito) { %>
        <div class="alert alert-success">
            <%= exito %>
        </div>
        <% } %>

            <% if (alerta) { %>
                <div class="alert alert-warning">
                    <%= alerta %>
                </div>
                <% } %>

                    <% if (error) { %>
                        <div class="alert alert-danger">
                            <%= error %>
                        </div>
                        <% } %>

                            <% const backupsLista=Array.isArray(backups) ? backups : []; const
                                totalAutomaticos=backupsLista.filter(function (backup) { return
                                backup.tipo==='Automático' ; }).length; const
                                totalEmergencias=backupsLista.filter(function (backup) { return
                                backup.tipo==='Emergencia' ; }).length; const totalManuales=backupsLista.filter(function
                                (backup) { return backup.tipo==='Manual' ; }).length; %>

                                <section class="backups-grid">
                                    <article class="module-card backups-card backups-card-primary">
                                        <div class="backups-card-head">
                                            <div>
                                                <span class="eyebrow">Estado</span>
                                                <h3>Información protegida</h3>
                                                <p>
                                                    Los respaldos se generan automáticamente al cerrar caja y antes de
                                                    restaurar datos.
                                                </p>
                                            </div>
                                        </div>

                                        <div class="backups-protection-state">
                                            <span class="backups-protection-icon">✓</span>
                                            <div>
                                                <strong>
                                                    <%= ultimoBackup ? 'Backups activos' : 'Sin backups registrados' %>
                                                </strong>
                                                <small>
                                                    <%= ultimoBackup ? `Último respaldo: ${ultimoBackup.fecha_legible}`
                                                        : 'Aún no se ha generado un respaldo.' %>
                                                </small>
                                            </div>
                                        </div>

                                        <div class="backups-note">
                                            Por seguridad, las copias completas, restauraciones y traslados de
                                            información
                                            son gestionados por soporte técnico autorizado.
                                        </div>
                                    </article>

                                    <article class="module-card backups-card">
                                        <div class="backups-card-head">
                                            <div>
                                                <span class="eyebrow">Resumen</span>
                                                <h3>Respaldos locales</h3>
                                                <p>Vista general del estado de protección.</p>
                                            </div>
                                        </div>

                                        <div class="backups-status-list">
                                            <div>
                                                <span>Total respaldos</span>
                                                <strong>
                                                    <%= totalBackups %>
                                                </strong>
                                            </div>

                                            <div>
                                                <span>Automáticos</span>
                                                <strong>
                                                    <%= totalAutomaticos %>
                                                </strong>
                                            </div>

                                            <div>
                                                <span>Emergencia</span>
                                                <strong>
                                                    <%= totalEmergencias %>
                                                </strong>
                                            </div>

                                            <div>
                                                <span>Manuales soporte</span>
                                                <strong>
                                                    <%= totalManuales %>
                                                </strong>
                                            </div>

                                            <div>
                                                <span>Copia externa</span>
                                                <% if (rutasBackups.externa_activa) { %>
                                                    <strong>Configurada</strong>
                                                    <% } else { %>
                                                        <strong class="backups-muted">No configurada</strong>
                                                        <% } %>
                                            </div>
                                        </div>
                                    </article>
                                </section>

                                <article class="module-card backups-card backups-support-card">
                                    <span class="eyebrow">Soporte autorizado</span>
                                    <h3>¿Necesitas una copia completa, restaurar datos o trasladar Prismia?</h3>
                                    <p>
                                        Para proteger la información del negocio y evitar manipulaciones incorrectas,
                                        estas acciones se realizan mediante soporte técnico autorizado.
                                    </p>

                                    <div class="backups-contact-box">
                                        <div>
                                            <span>Soporte</span>
                                            <strong>
                                                <%= contactoSoporte.nombre %>
                                            </strong>
                                        </div>

                                        <div>
                                            <span>Correo</span>
                                            <strong>
                                                <%= contactoSoporte.correo %>
                                            </strong>
                                        </div>

                                        <% if (contactoSoporte.telefono) { %>
                                            <div>
                                                <span>Teléfono</span>
                                                <strong>
                                                    <%= contactoSoporte.telefono %>
                                                </strong>
                                            </div>
                                            <% } %>
                                    </div>

                                    <p class="backups-small-note">
                                        Las funciones avanzadas de respaldo están reservadas para soporte técnico.
                                    </p>
                                </article>

                                <article class="module-card backups-card backups-warning-card">
                                    <span class="eyebrow">Importante</span>
                                    <h3>Un backup local no protege contra robo del equipo</h3>
                                    <p>
                                        Para protección completa, se recomienda configurar una ruta externa:
                                        USB, disco externo, carpeta de red, OneDrive, Google Drive o Dropbox instalado
                                        en Windows.
                                    </p>
                                </article>
</section>