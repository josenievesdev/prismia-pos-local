<%
    const listaUsuarios = Array.isArray(usuarios) ? usuarios : [];
    const tonoEstado = { activo: 'exito', inactivo: '', bloqueado: 'peligro' };
%>
<section class="ui-pagina">
    <%- include('../partials/ui/encabezado', {
        eyebrow: 'Seguridad operativa',
        titulo: 'Usuarios',
        descripcion: 'Administradores y cajeros con acceso a Prismia.',
        acciones: [{ texto: 'Nuevo usuario', href: '/usuarios/nuevo', tipo: 'primario' }],
    }) %>

    <% if (mensajeExito) { %>
        <div class="alert alert-success"><%= mensajeExito %></div>
    <% } %>

    <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
    <% } %>

    <article class="ui-tarjeta">
        <% if (!listaUsuarios.length) { %>
            <%- include('../partials/ui/vacio', { titulo: 'No hay usuarios registrados', mensaje: 'Crea el primer cajero o administrador adicional.' }) %>
        <% } else { %>
            <div class="ui-tabla-contenedor">
                <table class="ui-tabla">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th>Último acceso</th>
                            <th class="num">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% listaUsuarios.forEach(function (usuarioItem) { %>
                            <tr class="<%= usuarioItem.estado !== 'activo' ? 'ui-fila-inactiva' : '' %>">
                                <td>
                                    <strong><%= usuarioItem.nombre %></strong>
                                    <small>
                                        <%= usuarioItem.correo %><% if (usuarioItem.telefono) { %> · Tel: <%= usuarioItem.telefono %><% } %>
                                    </small>
                                </td>
                                <td>
                                    <%- include('../partials/ui/estado', { texto: usuarioItem.rol_etiqueta || 'Sin rol', tono: usuarioItem.rol_principal === 'administrador' ? 'info' : '' }) %>
                                </td>
                                <td>
                                    <%- include('../partials/ui/estado', { texto: usuarioItem.estado_etiqueta, tono: tonoEstado[usuarioItem.estado] || '', punto: true }) %>
                                </td>
                                <td><%= usuarioItem.ultimo_acceso_en ? fechaLocal(usuarioItem.ultimo_acceso_en) : 'Sin acceso' %></td>
                                <td>
                                    <div class="ui-acciones-fila">
                                        <a href="/usuarios/<%= usuarioItem.id_usuario %>/editar" class="btn-secondary">Editar</a>

                                        <% if (usuarioItem.estado === 'activo') { %>
                                            <form method="POST" action="/usuarios/<%= usuarioItem.id_usuario %>/desactivar">
                                                <button type="submit" class="btn-danger-soft">Desactivar</button>
                                            </form>
                                        <% } else { %>
                                            <form method="POST" action="/usuarios/<%= usuarioItem.id_usuario %>/activar">
                                                <button type="submit" class="btn-secondary">Activar</button>
                                            </form>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </article>
</section>
