<section class="ui-pagina">
    <%- include('../partials/ui/encabezado', {
        acciones: [{ texto: 'Volver', href: '/usuarios', tipo: 'secundario' }],
    }) %>

    <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form method="POST" action="<%= action %>" class="ui-formulario">
        <section class="ui-seccion">
            <div class="ui-seccion-texto">
                <h3>Información básica</h3>
                <p class="ui-ayuda">El correo es el usuario para iniciar sesión.</p>
            </div>

            <div class="ui-campos">
                <label class="ui-campo">
                    <span>Nombre</span>
                    <input type="text" name="nombre" value="<%= usuarioFormulario.nombre || '' %>" required>
                </label>

                <label class="ui-campo">
                    <span>Correo</span>
                    <input type="email" name="correo" value="<%= usuarioFormulario.correo || '' %>" required>
                </label>

                <label class="ui-campo">
                    <span>Teléfono</span>
                    <input type="text" name="telefono" value="<%= usuarioFormulario.telefono || '' %>">
                </label>

                <label class="ui-campo">
                    <span>Estado</span>
                    <select name="estado">
                        <option value="activo" <%= usuarioFormulario.estado === 'activo' ? 'selected' : '' %>>Activo</option>
                        <option value="inactivo" <%= usuarioFormulario.estado === 'inactivo' ? 'selected' : '' %>>Inactivo</option>
                        <option value="bloqueado" <%= usuarioFormulario.estado === 'bloqueado' ? 'selected' : '' %>>Bloqueado</option>
                    </select>
                </label>
            </div>
        </section>

        <section class="ui-seccion">
            <div class="ui-seccion-texto">
                <h3>Rol operativo</h3>
            </div>

            <div class="ui-opciones">
                <% roles.forEach(function (rol) { %>
                    <label class="ui-opcion">
                        <input type="radio" name="rol" value="<%= rol.nombre %>" <%= usuarioFormulario.rol_principal === rol.nombre ? 'checked' : '' %> required>
                        <span>
                            <strong><%= rol.etiqueta %></strong>
                            <% if (rol.descripcion) { %><small><%= rol.descripcion %></small><% } %>
                        </span>
                    </label>
                <% }) %>
            </div>
        </section>

        <section class="ui-seccion">
            <div class="ui-seccion-texto">
                <h3>Contraseña</h3>
                <% if (modo === 'editar') { %>
                    <p class="ui-ayuda">Déjala vacía si no quieres cambiarla.</p>
                <% } %>
            </div>

            <div class="ui-campos">
                <label class="ui-campo">
                    <span>Contraseña</span>
                    <input type="password" name="contrasena" autocomplete="new-password" <%= modo === 'crear' ? 'required' : '' %>>
                </label>

                <label class="ui-campo">
                    <span>Repetir contraseña</span>
                    <input type="password" name="repetir_contrasena" autocomplete="new-password" <%= modo === 'crear' ? 'required' : '' %>>
                </label>
            </div>
        </section>

        <footer class="ui-formulario-acciones">
            <a href="/usuarios" class="btn-secondary">Cancelar</a>
            <button type="submit" class="btn-primary"><%= modo === 'crear' ? 'Crear usuario' : 'Guardar cambios' %></button>
        </footer>
    </form>
</section>
