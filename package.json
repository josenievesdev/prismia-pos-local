{
  "name": "prismia-pos-local",
  "version": "1.0.0",
  "description": "POS local para ventas, caja, inventario, gastos y reportes para pequeños negocios.",
  "main": "electron/main.js",
  "scripts": {
    "native:node": "npm rebuild better-sqlite3",
    "native:electron": "electron-rebuild -f -w better-sqlite3",
    "dev": "npm run native:node && nodemon src/server.js",
    "dev:https": "npm run native:node && nodemon src/server.https.js",
    "start": "npm run native:node && node src/server.js",
    "start:https": "npm run native:node && node src/server.https.js",
    "electron": "npm run native:electron && electron .",
    "electron:rebuild": "npm run native:electron",
    "pack:dir": "npm run check:pre-electron && npm run native:electron && electron-builder --dir",
    "dist:win": "npm run check:pre-electron && npm run native:electron && electron-builder --win nsis",
    "db:validate": "npm run native:node && node src/database/validate-db.js",
    "db:audit:contable": "npm run native:node && node src/database/audit-contable.js",
    "db:repair:turnos": "npm run native:node && node src/database/reparar-turnos-caja.js",
    "db:migrate:001": "node src/database/migrations/001_unidades_costos_iva.js",
    "db:migrate:002": "node src/database/migrations/002_conteos_inventario.js",
    "db:migrate:003": "node src/database/migrations/003_medios_pago_caja.js",
    "db:migrate:004": "node src/database/migrations/004_movimientos_caja_medios_pago.js",
    "db:migrate:005": "node src/database/migrations/005_pagos_venta_medios_pago.js",
    "db:migrate:006": "node src/database/migrations/006_gastos_medios_pago.js",
    "db:migrate:037": "node src/database/migrations/037_normalizar_iva_venta_porcentaje.js",
    "db:migrate:038": "node src/database/migrations/038_crear_licencia_local.js",
    "db:migrate:039": "npm run native:node && node src/database/migrations/039_ampliar_licencia_local_mensualidades.js",
    "check:pre-electron": "npm run db:validate && node scripts/verificar-pre-electron.js",
    "check:runtime": "node scripts/diagnostico-runtime.js",
    "demo:reset": "node scripts/demo/reset-demo-landing.js",
    "demo:electron": "set \"PRISMIA_DATA_DIR=%CD%\\PrismiaDemoLanding\" && set \"SUPPORT_BACKUP_KEY=PRM-SOP-DEMO-LAND-2026\" && npm run electron"
  },
  "keywords": [
    "pos",
    "ventas",
    "inventario",
    "caja"
  ],
  "author": "Nieves Systems",
  "license": "ISC",
  "dependencies": {
    "adm-zip": "^0.5.17",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^4.22.1",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.19.0",
    "helmet": "^7.2.0",
    "html5-qrcode": "^2.3.8",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "37.10.3",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.14"
  },
  "build": {
    "appId": "com.nievessystems.prismia-pos-local",
    "productName": "Prismia POS Local",
    "copyright": "Copyright © 2026 Nieves Systems",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": false,
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json",
      "!**/.env",
      "!**/.env.*",
      "!**/secretos.local.json",
      "!**/secretos.local.json.tmp",
      "!src/database/data/**",
      "!src/database/reports/**",
      "!src/restart-dev-trigger.json",
      "!storage/**",
      "!certs/**",
      "!scripts/**",
      "!dist/**",
      "!build/**",
      "!out/**",
      "!release/**",
      "!PrismiaRestoreTest/**",
      "!PrismiaSetupTest/**",
      "!PrismiaSecretsTest/**",
      "!PrismiaRuntimeTest/**",
      "!PrismiaElectronRuntimeTest/**",
      "!PrismiaElectronCleanTest/**",
      "!PrismiaElectronRestoreTest/**",
      "!**/*.sqlite",
      "!**/*.sqlite-shm",
      "!**/*.sqlite-wal",
      "!**/*.db",
      "!**/*.bak",
      "!**/*.zip.tmp"
    ],
    "icon": "build/icon.ico",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Prismia POS Local",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}